## Phaser-Specific Notes

1. Configure TypeScript properly for Phaser:
   ```json
   {
     "compilerOptions": {
       "target": "ES2020",
       "module": "ESNext",
       "strict": true,
       "esModuleInterop": true,
       "forceConsistentCasingInFileNames": true,
       "noImplicitAny": true,
       "strictNullChecks": true,
       "noImplicitThis": true,
       "noUnusedLocals": true,
       "noUnusedParameters": true,
       "sourceMap": true
     },
     "include": ["src/**/*"]
   }
   ```

2. Use Phaser's type definitions effectively:
   ```typescript
   // Use appropriate Phaser interfaces
   interface EnemyConfig {
     scene: Phaser.Scene;
     x: number;
     y: number;
     texture: string;
     frame?: string | number;
     health: number;
     speed: number;
   }
   
   class Enemy extends Phaser.Physics.Arcade.Sprite {
     private health: number;
     private enemySpeed: number;
     
     constructor(config: EnemyConfig) {
       super(config.scene, config.x, config.y, config.texture, config.frame);
       this.health = config.health;
       this.enemySpeed = config.speed;
       this.scene.add.existing(this);
       this.scene.physics.world.enable(this);
     }
   }
   ```

3. Create type guards for Phaser objects:
   ```typescript
   // Type guard for Phaser sprite
   function isSprite(obj: Phaser.GameObjects.GameObject): obj is Phaser.GameObjects.Sprite {
     return obj instanceof Phaser.GameObjects.Sprite;
   }
   
   // Usage
   this.physics.add.collider(this.player, this.enemies, (player, enemy) => {
     if (isSprite(player) && isSprite(enemy)) {
       // Now TypeScript knows these are sprites
       player.setTint(0xff0000);
       enemy.destroy();
     }
   });
   ```

4. Handle Phaser-specific error conditions:
   ```typescript
   // Handle texture loading errors
   this.load.on('loaderror', (fileObj: Phaser.Loader.File) => {
     console.error(`Failed to load: ${fileObj.key}`);
     // Fall back to default texture
