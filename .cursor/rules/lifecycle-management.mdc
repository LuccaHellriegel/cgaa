## Component Lifecycle Patterns

1. **Reusable Game Component Base Class**:
   ```typescript
   /**
    * Base class for game components with lifecycle management
    */
   abstract class GameComponent {
     protected scene: Phaser.Scene;
     protected eventListeners: Array<{
       target: Phaser.Events.EventEmitter;
       event: string;
       callback: Function;
     }> = [];
     protected timers: Phaser.Time.TimerEvent[] = [];
     protected tweens: Phaser.Tweens.Tween[] = [];
     protected isDestroyed: boolean = false;
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       
       // Listen for scene shutdown to auto-cleanup
       this.addEventListenerInternal(
         this.scene.events,
         'shutdown',
         this.onSceneShutdown,
         this
       );
     }
     
     /**
      * Initialize the component
      * Override in subclasses
      */
     public init(): void {}
     
     /**
      * Update component state
      * Override in subclasses
      */
     public update(time: number, delta: number): void {}
     
     /**
      * Add an event listener with automatic cleanup tracking
      */
     protected addEventListener(
       target: Phaser.Events.EventEmitter,
       event: string,
       callback: Function
     ): void {
       this.addEventListenerInternal(target, event, callback, this);
     }
     
     /**
      * Internal method to add event listener with specified context
      */
     private addEventListenerInternal(
       target: Phaser.Events.EventEmitter,
       event: string,
       callback: Function,
       context: any
     ): void {
       target.on(event, callback, context);
       this.eventListeners.push({ target, event, callback });
     }
     
     /**
      * Create a timer with automatic cleanup tracking
      */
     protected createTimer(config: Phaser.Types.Time.TimerEventConfig): Phaser.Time.TimerEvent {
       const timer = this.scene.time.addEvent(config);
       this.timers.push(timer);
       return timer;
     }
     
     /**
      * Create a tween with automatic cleanup tracking
      */
     protected createTween(config: Phaser.Types.Tweens.TweenBuilderConfig): Phaser.Tweens.Tween {
       const tween = this.scene.tweens.add(config);
       this.tweens.push(tween);
       return tween;
     }
     
     /**
      * Called when the component is about to be destroyed
      * Override in subclasses to add custom cleanup
      */
     protected onDestroy(): void {}
     
     /**
      * Called when the scene is shutting down
      */
     private onSceneShutdown(): void {
       this.destroy();
     }
     
     /**
      * Clean up all resources
      */
     public destroy(): void {
       if (this.isDestroyed) return;
       
       // Call subclass cleanup first
       this.onDestroy();
       
       // Clean up event listeners
       this.eventListeners.forEach(({ target, event, callback }) => {
         target.off(event, callback, this);
       });
       this.eventListeners = [];
       
       // Clean up timers
       this.timers.forEach(timer => timer.destroy());
       this.timers = [];
       
       // Clean up tweens
       this.tweens.forEach(tween => tween.stop());
       this.tweens = [];
       
       // Mark as destroyed
       this.isDestroyed = true;
     }
   }
   ```

2. **Scene Manager with State Preservation**:
   ```typescript
   /**
    * Scene manager with state preservation between scene transitions
    */
   class GameSceneManager {
     private game: Phaser.Game;
     private persistentData: Map<string, any> = new Map();
     private activeScenes: Set<string> = new Set();
     private sceneTransitionInProgress: boolean = false;
     
     constructor(game: Phaser.Game) {
       this.game = game;
       
       // Listen for scene events
       this.game.events.on('prestep', this.update, this);
     }
     
     /**
      * Start a scene and optionally stop other scenes
      * @param key Scene key to start
      * @param data Data to pass to the scene
      * @param stopOthers Whether to stop other active scenes
      */
     startScene(key: string, data: any = {}, stopOthers: boolean = false): void {
       if (this.sceneTransitionInProgress) {
         console.warn('Scene transition already in progress, ignoring request');
         return;
       }
       
       this.sceneTransitionInProgress = true;
       
       // Merge persistent data with scene-specific data
       const mergedData = { ...data };
       this.persistentData.forEach((value, key) => {
         if (!(key in mergedData)) {
           mergedData[key] = value;
         }
       });
       
       // Start the new scene
       if (stopOthers) {
         // Stop all current scenes and start the new one
         const activeSceneKeys = Array.from(this.activeScenes);
         
         // Create a counter to track when all scenes have shut down
         let scenesToStop = activeSceneKeys.length;
         
         if (scenesToStop > 0) {
           // Set up one-time listener for each scene's shutdown event
           activeSceneKeys.forEach(sceneKey => {
             const scene = this.game.scene.getScene(sceneKey);
             
             // Listen for shutdown completion
             scene.events.once('shutdown', () => {
               scenesToStop--;
               
               // When all scenes are stopped, start the new scene
               if (scenesToStop === 0) {
                 this.game.scene.start(key, mergedData);
                 this.activeScenes.clear();
                 this.activeScenes.add(key);
                 this.sceneTransitionInProgress = false;
               }
             });
             
             // Stop the scene
             this.game.scene.stop(sceneKey);
           });
         } else {
           // No scenes to stop, just start the new one
           this.game.scene.start(key, mergedData);
           this.activeScenes.add(key);
           this.sceneTransitionInProgress = false;
         }
       } else {
         // Start the new scene without stopping others
         this.game.scene.start(key, mergedData);
         this.activeScenes.add(key);
         this.sceneTransitionInProgress = false;
       }
     }
     
     /**
      * Store data that persists between scene transitions
      * @param key Data identifier
      * @param value Data value
      */
     setPersistentData(key: string, value: any): void {
       this.persistentData.set(key, value);
     }
     
     /**
      * Get persistent data
      * @param key Data identifier
      * @param defaultValue Default value if key doesn't exist
      */
     getPersistentData<T>(key: string, defaultValue?: T): T {
       return this.persistentData.has(key)
         ? this.persistentData.get(key)
         : defaultValue;
     }
     
     /**
      * Clear all persistent data
      */
     clearPersistentData(): void {
       this.persistentData.clear();
     }
     
     /**
      * Check if a scene is currently active
      * @param key Scene key
      */
     isSceneActive(key: string): boolean {
       return this.activeScenes.has(key);
     }
     
     /**
      * Update method called each frame
      */
     private update(): void {
       // Update active scenes tracking
       const activeScenes = new Set<string>();
       
       this.game.scene.scenes.forEach(scene => {
         if (scene.scene.isActive()) {
           activeScenes.add(scene.scene.key);
         }
       });
       
       this.activeScenes = activeScenes;
     }
     
     /**
      * Clean up resources
      */
     destroy(): void {
       this.game.events.off('prestep', this.update, this);
       this.persistentData.clear();
       this.activeScenes.clear();
     }
   }
   ```

