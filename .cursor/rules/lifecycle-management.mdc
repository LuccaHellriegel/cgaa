# Lifecycle Management

## Context
- When implementing scene transitions in Phaser games
- When creating reusable game components with their own lifecycles
- When managing complex game states with multiple dependencies
- When implementing pause/resume functionality
- When handling game object creation and destruction

## Requirements
- Implement proper initialization and cleanup in scene lifecycle methods
- Create component classes with clear lifecycle hooks
- Handle scene transitions with appropriate state preservation
- Implement proper shutdown and destroy methods
- Ensure all resources are released when no longer needed
- Maintain separation of concerns in lifecycle methods

## Examples

<example>
```typescript
/**
 * Scene with proper lifecycle management
 */
class GameScene extends Phaser.Scene {
  private player: Player;
  private enemies: Enemy[] = [];
  private ui: UIManager;
  private levelData: LevelData;
  private isPaused: boolean = false;
  
  constructor() {
    super({ key: 'GameScene' });
  }
  
  /**
   * Initialize scene with data
   */
  init(data: { level: number }): void {
    console.log(`Initializing level ${data.level}`);
    
    // Reset state for scene reuse
    this.enemies = [];
    this.isPaused = false;
  }
  
  /**
   * Preload assets needed for this scene
   */
  preload(): void {
    // Load level-specific assets
    this.load.json('level-data', `assets/levels/level${this.registry.get('currentLevel')}.json`);
  }
  
  /**
   * Create game objects and set up the scene
   */
  create(): void {
    // Load level data
    this.levelData = this.cache.json.get('level-data');
    
    // Create player
    this.player = new Player(this, 100, 100);
    
    // Create enemies from level data
    this.levelData.enemies.forEach(enemyData => {
      const enemy = new Enemy(this, enemyData.x, enemyData.y, enemyData.type);
      this.enemies.push(enemy);
    });
    
    // Create UI
    this.ui = new UIManager(this);
    
    // Set up input handlers
    this.input.keyboard.on('keydown-P', this.togglePause, this);
    this.input.keyboard.on('keydown-ESC', this.exitToMenu, this);
    
    // Listen for game events
    this.events.on('player-died', this.handlePlayerDeath, this);
    this.events.on('level-complete', this.handleLevelComplete, this);
    
    // Set up collision detection
    this.physics.add.collider(this.player, this.enemies, this.handlePlayerEnemyCollision, null, this);
    
    // Start background music
    this.sound.play('level-music', { loop: true });
    
    // Emit scene ready event
    this.events.emit('scene-ready');
  }
  
  /**
   * Update game state
   */
  update(time: number, delta: number): void {
    if (this.isPaused) return;
    
    // Update player
    this.player.update(time, delta);
    
    // Update enemies
    this.enemies.forEach(enemy => enemy.update(time, delta));
    
    // Update UI
    this.ui.update(time, delta);
  }
  
  /**
   * Toggle pause state
   */
  private togglePause(): void {
    this.isPaused = !this.isPaused;
    
    if (this.isPaused) {
      // Pause physics, animations, and timers
      this.physics.pause();
      this.anims.pauseAll();
      this.time.paused = true;
      
      // Show pause menu
      this.ui.showPauseMenu();
      
      // Emit pause event
      this.events.emit('scene-paused');
    } else {
      // Resume physics, animations, and timers
      this.physics.resume();
      this.anims.resumeAll();
      this.time.paused = false;
      
      // Hide pause menu
      this.ui.hidePauseMenu();
      
      // Emit resume event
      this.events.emit('scene-resumed');
    }
  }
  
  /**
   * Exit to main menu
   */
  private exitToMenu(): void {
    // Stop music
    this.sound.stopAll();
    
    // Transition to menu scene
    this.scene.start('MenuScene');
  }
  
  /**
   * Handle player death
   */
  private handlePlayerDeath(): void {
    // Show game over UI
    this.ui.showGameOver();
    
    // Stop gameplay
    this.physics.pause();
    this.time.paused = true;
    
    // Restart after delay
    this.time.delayedCall(3000, () => {
      this.scene.restart();
    });
  }
  
  /**
   * Handle level completion
   */
  private handleLevelComplete(): void {
    // Show level complete UI
    this.ui.showLevelComplete();
    
    // Increment level in registry
    const currentLevel = this.registry.get('currentLevel');
    this.registry.set('currentLevel', currentLevel + 1);
    
    // Transition to next level after delay
    this.time.delayedCall(2000, () => {
      this.scene.restart();
    });
  }
  
  /**
   * Handle collision between player and enemy
   */
  private handlePlayerEnemyCollision(player: Player, enemy: Enemy): void {
    player.takeDamage(enemy.getDamage());
  }
  
  /**
   * Called when scene is put to sleep
   */
  sleep(): void {
    // Pause gameplay but keep scene alive
    this.isPaused = true;
    this.physics.pause();
    this.anims.pauseAll();
    this.time.paused = true;
    
    // Emit sleep event
    this.events.emit('scene-sleep');
  }
  
  /**
   * Called when scene is woken up
   */
  wake(): void {
    // Resume gameplay
    this.isPaused = false;
    this.physics.resume();
    this.anims.resumeAll();
    this.time.paused = false;
    
    // Emit wake event
    this.events.emit('scene-wake');
  }
  
  /**
   * Called when scene is shut down (but not destroyed)
   */
  shutdown(): void {
    // Clean up input handlers
    this.input.keyboard.off('keydown-P', this.togglePause, this);
    this.input.keyboard.off('keydown-ESC', this.exitToMenu, this);
    
    // Clean up event listeners
    this.events.off('player-died', this.handlePlayerDeath, this);
    this.events.off('level-complete', this.handleLevelComplete, this);
    
    // Stop all sounds
    this.sound.stopAll();
    
    // Clean up UI
    this.ui.destroy();
    
    // Clean up enemies
    this.enemies.forEach(enemy => enemy.destroy());
    this.enemies = [];
    
    // Clean up player
    this.player.destroy();
    
    // Emit shutdown event
    this.events.emit('scene-shutdown');
  }
}
```
</example>

