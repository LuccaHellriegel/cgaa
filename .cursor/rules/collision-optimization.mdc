// Optimized Phaser 3.70+ collision management
export class PhaserCollisionManager {
  private scene: Phaser.Scene;
  private player: Phaser.Physics.Arcade.Sprite;
  private enemies: Phaser.Physics.Arcade.Group;
  private projectiles: Phaser.Physics.Arcade.Group;
  private obstacles: Phaser.Physics.Arcade.StaticGroup;
  
  // Collision groups for Phaser 3.70+
  private readonly COLLISION_GROUPS = {
    PLAYER: 1,
    ENEMY: 2,
    PROJECTILE: 3,
    OBSTACLE: 4,
    POWERUP: 5
  };
  
  constructor(scene: Phaser.Scene, player: Phaser.Physics.Arcade.Sprite) {
    this.scene = scene;
    this.player = player;
    
    // Configure player physics for optimal performance
    const playerBody = this.player.body as Phaser.Physics.Arcade.Body;
    
    // Use Phaser 3.70+ direct control for improved performance
    playerBody.setDirectControl(true);
    
    // Set player collision group
    playerBody.setCollisionGroup(this.COLLISION_GROUPS.PLAYER);
    
    // Set what the player can collide with
    playerBody.setCollidesWith([
      this.COLLISION_GROUPS.ENEMY, 
      this.COLLISION_GROUPS.OBSTACLE
    ]);
    
    // Create optimized physics groups
    this.createPhysicsGroups();
    
    // Setup collision handlers
    this.setupCollisions();
    
    // Enable debug visuals during development
    if (process.env.NODE_ENV !== 'production') {
      this.enableDebugVisuals();
    }
  }
  
  private createPhysicsGroups(): void {
    // Create enemy group with shared physics properties
    this.enemies = this.scene.physics.add.group({
      collideWorldBounds: true,
      bounceX: 0.5,
      bounceY: 0.5,
      dragX: 50,
      createCallback: (gameObject) => {
        // Configure physics properties for each created enemy
        const body = gameObject.body as Phaser.Physics.Arcade.Body;
        body.setCollisionGroup(this.COLLISION_GROUPS.ENEMY);
        body.setCollidesWith([
          this.COLLISION_GROUPS.PLAYER, 
          this.COLLISION_GROUPS.OBSTACLE,
          this.COLLISION_GROUPS.PROJECTILE
        ]);
      }
    });
    
    // Create projectile group optimized for fast movement
    this.projectiles = this.scene.physics.add.group({
      allowGravity: false,
      createCallback: (gameObject) => {
        const body = gameObject.body as Phaser.Physics.Arcade.Body;
        
        // Optimize for efficient collision checking
        body.setDirectControl(true);
        body.setCollisionGroup(this.COLLISION_GROUPS.PROJECTILE);
        body.setCollidesWith([this.COLLISION_GROUPS.ENEMY]);
        
        // Set smaller hitbox for better precision
        body.setSize(gameObject.width * 0.7, gameObject.height * 0.7, true);
      }
    });
    
    // Static bodies for immovable objects - much better performance
    this.obstacles = this.scene.physics.add.staticGroup({
      createCallback: (gameObject) => {
        const body = gameObject.body as Phaser.Physics.Arcade.StaticBody;
        body.setCollisionGroup(this.COLLISION_GROUPS.OBSTACLE);
        
        // Static bodies typically collide with everything except projectiles
        body.setCollidesWith([
          this.COLLISION_GROUPS.PLAYER, 
          this.COLLISION_GROUPS.ENEMY
        ]);
      }
    });
  }
  
  private setupCollisions(): void {
    // Configure Phaser's world collision detection
    const world = this.scene.physics.world;
    
    // Optimize world bounds
    world.setBounds(0, 0, this.scene.scale.width, this.scene.scale.height);
    world.setBoundsCollision(true, true, true, true);
    
    // Use Phaser's built-in collision system with optimized callbacks
    this.scene.physics.add.collider(
      this.player, 
      this.obstacles,
      undefined, // No callback needed for simple solid collisions
      undefined,
      this
    );
    
    // Enemies collide with obstacles using a processing function for optimization
    this.scene.physics.add.collider(
      this.enemies, 
      this.obstacles,
      undefined,
      this.processEnemyObstacleCollision,
      this
    );
    
    // Projectiles overlap with enemies instead of collision (one-way effect)
    this.scene.physics.add.overlap(
      this.projectiles, 
      this.enemies, 
      this.handleProjectileEnemyCollision,
      this.processProjectileCollision, // Filtering function for early exit
      this
    );
    
    // Player and enemy collision with custom handling
    this.scene.physics.add.overlap(
      this.player,
      this.enemies,
      this.handlePlayerEnemyCollision,
      this.processPlayerEnemyCollision,
      this
    );
  }
  
  // Processing function for more efficient collision detection
  private processEnemyObstacleCollision(enemy: Phaser.GameObjects.GameObject, obstacle: Phaser.GameObjects.GameObject): boolean {
    // Skip inactive objects
    if (!enemy.active) return false;
    
    // Skip objects that are too far apart (broad phase check)
    const enemyBody = enemy.body as Phaser.Physics.Arcade.Body;
    const obstacleBody = obstacle.body as Phaser.Physics.Arcade.StaticBody;
    
    // Get distance between the objects (using squared distance to avoid sqrt)
    const dx = enemyBody.center.x - obstacleBody.center.x;
    const dy = enemyBody.center.y - obstacleBody.center.y;
    const distSquared = dx * dx + dy * dy;
    
    // Only process collision if objects are close enough
    // This combines width and height for a rough approximation
    const combinedWidth = enemyBody.width + obstacleBody.width;
    const combinedHeight = enemyBody.height + obstacleBody.height;
    const minDistSquared = (combinedWidth * combinedWidth + combinedHeight * combinedHeight) / 4;
    
    return distSquared <= minDistSquared;
  }
  
  // More efficient processing function for projectile collision
  private processProjectileCollision(projectile: Phaser.GameObjects.GameObject, enemy: Phaser.GameObjects.GameObject): boolean {
    // Skip collision processing if either object is inactive
    if (!projectile.active || !enemy.active) return false;
    
    // Get physics bodies
    const projectileBody = projectile.body as Phaser.Physics.Arcade.Body;
    const enemyBody = enemy.body as Phaser.Physics.Arcade.Body;
    
    // Perform quick AABB intersection check without full physics calculation
    return Phaser.Geom.Intersects.RectangleToRectangle(
      projectileBody.boundingBox,
      enemyBody.boundingBox
    );
  }
  
  // Process function with distance check for player-enemy collision
  private processPlayerEnemyCollision(player: Phaser.GameObjects.GameObject, enemy: Phaser.GameObjects.GameObject): boolean {
    // Skip inactive enemies
    if (!enemy.active) return false;
    
    // Get the enemy's body
    const enemyBody = enemy.body as Phaser.Physics.Arcade.Body;
    const playerBody = player.body as Phaser.Physics.Arcade.Body;
    
    // Skip enemies in "stunned" or other non-colliding states
    if (enemyBody.checkCollision.none) return false;
    
    // If we're using visibility culling, only process collisions for visible enemies
    return enemy.visible && Phaser.Geom.Intersects.RectangleToRectangle(
      playerBody.boundingBox,
      enemyBody.boundingBox
    );
  }
  
  // Collision handler for projectile and enemy
  private handleProjectileEnemyCollision(projectile: Phaser.GameObjects.GameObject, enemy: Phaser.GameObjects.GameObject): void {
    // Handle collision effects here
    // Typically deactivates projectile and damages enemy
  }
  
  // Collision handler for player and enemy
  private handlePlayerEnemyCollision(player: Phaser.GameObjects.GameObject, enemy: Phaser.GameObjects.GameObject): void {
    // Handle player-enemy collision effects
  }
  
  // Enable physics debugging
  private enableDebugVisuals(): void {
    // Display physics bodies and velocities
    this.scene.physics.world.createDebugGraphic();
    
    // Advanced debugging - draw collision groups with different colors
    const graphics = this.scene.add.graphics({
      lineStyle: { width: 2, color: 0x00ff00 },
      fillStyle: { color: 0xff0000, alpha: 0.3 }
    });
    graphics.setDepth(9999);
    
    // Update the debug display in the scene update loop
    this.scene.events.on('update', () => {
      graphics.clear();
      this.drawDebugCollisionGroups(graphics);
    });
  }
  
  // Helper method for drawing debug information
  private drawDebugCollisionGroups(graphics: Phaser.GameObjects.Graphics): void {
    // Draw different collision groups with different colors
    const drawBody = (body: Phaser.Physics.Arcade.Body, color: number) => {
      graphics.lineStyle(1, color, 1);
      graphics.strokeRect(body.x, body.y, body.width, body.height);
      
      // Show collision group as text
      const text = this.scene.add.text(body.x, body.y - 15, 
        `Group: ${body.collisionGroup}`, 
        { fontSize: '10px', backgroundColor: '#000' }
      );
      text.setDepth(10000);
      this.scene.time.delayedCall(16, () => text.destroy());
    };
    
    // Draw player body
    const playerBody = this.player.body as Phaser.Physics.Arcade.Body;
    drawBody(playerBody, 0x00ff00);
    
    // Draw enemy bodies
    this.enemies.getChildren().forEach(enemy => {
      const body = enemy.body as Phaser.Physics.Arcade.Body;
      if (body && body.enable) {
        drawBody(body, 0xff0000);
      }
    });
    
    // Draw projectile bodies
    this.projectiles.getChildren().forEach(projectile => {
      const body = projectile.body as Phaser.Physics.Arcade.Body;
      if (body && body.enable) {
        drawBody(body, 0x0000ff);
      }
    });
  }
  
  // Update method to optimize physics processing
  update(time: number, delta: number): void {
    // Optimize by disabling physics for off-screen enemies
    const camera = this.scene.cameras.main;
    const cameraBounds = new Phaser.Geom.Rectangle(
      camera.scrollX - 100,  // Add padding to prevent pop-in
      camera.scrollY - 100,
      camera.width + 200,
      camera.height + 200
    );
    
    // Use Phaser 3.70+ efficient body management
    this.enemies.getChildren().forEach((enemy: any) => {
      const body = enemy.body as Phaser.Physics.Arcade.Body;
      
      // Skip if already processed
      if (!body) return;
      
      // Get enemy bounds
      const enemyBounds = body.getBounds();
      
      // Check if enemy is on screen with padding
      const isVisible = Phaser.Geom.Rectangle.Overlaps(cameraBounds, enemyBounds);
      
      // Enable/disable physics based on visibility
      if (!isVisible && body.enable) {
        // Disable physics for off-screen enemies
        body.enable = false;
        enemy.visible = false;
      } else if (isVisible && !body.enable) {
        // Re-enable physics for on-screen enemies
        body.enable = true;
        enemy.visible = true;
      }
    });
    
    // Similar optimization for projectiles
    this.projectiles.getChildren().forEach((projectile: any) => {
      const body = projectile.body as Phaser.Physics.Arcade.Body;
      
      // Disable physics for projectiles that have traveled too far
      if (body && body.enable) {
        const distanceSquared = 
          body.position.distanceSq(this.player.body.position);
        
        // If projectile is too far from player, disable it
        if (distanceSquared > 250000) { // 500 pixels squared
          body.enable = false;
          projectile.active = false;
          projectile.visible = false;
        }
      }
    });
  }
}
