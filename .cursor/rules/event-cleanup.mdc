# Event Listener Cleanup

## Context
- When working with DOM events, game events, or custom event emitters
- When implementing components that listen to events during their lifecycle
- When developing scenes with multiple event subscriptions
- When using third-party libraries that emit events

## Requirements
- Remove all event listeners when they are no longer needed
- Track event listeners to ensure complete cleanup
- Implement proper cleanup in component destruction/scene transitions
- Use appropriate event listener options (like `{once: true}` when applicable)
- Ensure event handlers have proper garbage collection references

## Examples

<example>
```typescript
/**
 * Component with proper event listener management
 */
class EventAwareComponent {
  private scene: Phaser.Scene;
  private eventHandlers: Map<string, Function> = new Map();
  private domEventHandlers: Array<{
    element: HTMLElement;
    event: string;
    handler: EventListener;
  }> = [];
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    
    // Initialize events with tracking for later cleanup
    this.setupEvents();
  }
  
  /**
   * Set up event listeners with tracking
   */
  private setupEvents(): void {
    // Register a game event with tracking
    const onSceneEvent = (data: any) => {
      console.log('Scene event received:', data);
    };
    
    // Store reference to handler for later removal
    this.eventHandlers.set('sceneEvent', onSceneEvent);
    this.scene.events.on('custom-event', onSceneEvent);
    
    // Register DOM event with tracking
    const onWindowResize = () => {
      this.handleResize();
    };
    
    window.addEventListener('resize', onWindowResize);
    this.domEventHandlers.push({
      element: window as unknown as HTMLElement,
      event: 'resize',
      handler: onWindowResize
    });
    
    // Use Phaser's time events with automatic cleanup
    this.scene.time.addEvent({
      delay: 1000,
      callback: this.onTimerTick,
      callbackScope: this,
      loop: true
    });
    
    // Use once option for one-time events that clean up automatically
    this.scene.events.once('scene-complete', this.onSceneComplete, this);
  }
  
  /**
   * Handle window resize event
   */
  private handleResize(): void {
    // Resize logic...
  }
  
  /**
   * Handle timer tick
   */
  private onTimerTick(): void {
    // Timer logic...
  }
  
  /**
   * Handle scene completion
   */
  private onSceneComplete(): void {
    // Scene complete logic...
  }
  
  /**
   * Clean up all registered event listeners
   */
  destroy(): void {
    // Clean up Phaser event listeners
    this.eventHandlers.forEach((handler, event) => {
      this.scene.events.off(event, handler);
    });
    this.eventHandlers.clear();
    
    // Clean up DOM event listeners
    this.domEventHandlers.forEach(({element, event, handler}) => {
      element.removeEventListener(event, handler);
    });
    this.domEventHandlers = [];
    
    // Clean up any remaining references
    this.scene = null;
  }
}
```
</example>

