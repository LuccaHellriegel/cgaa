# Render Culling Optimization

## Context
- When working with large game worlds with many objects
- When experiencing performance drops due to rendering too many objects
- When only a small portion of the game world is visible at once
- When targeting mobile or low-powered devices

## Requirements
- Implement camera culling to avoid rendering off-screen objects
- Set up visibility checks for game objects
- Organize objects into render layers with appropriate culling
- Implement distance-based culling for far-away objects
- Ensure culled objects don't consume CPU time for updates

## Examples

<example>
```typescript
// GOOD: Camera culling implementation
export class CullingManager {
  private scene: Phaser.Scene;
  private camera: Phaser.Cameras.Scene2D.Camera;
  private cullPadding: number;
  private cullableObjects: Phaser.GameObjects.GameObject[];
  
  constructor(scene: Phaser.Scene, cullPadding: number = 100) {
    this.scene = scene;
    this.camera = scene.cameras.main;
    this.cullPadding = cullPadding;
    this.cullableObjects = [];
    
    // Set up event for camera movement
    this.camera.on('camerafadeincomplete', () => this.updateCulling());
    
    // Update culling on scene update
    this.scene.events.on('update', () => this.updateCulling());
  }
  
  registerForCulling(gameObject: Phaser.GameObjects.GameObject): void {
    this.cullableObjects.push(gameObject);
  }
  
  unregisterFromCulling(gameObject: Phaser.GameObjects.GameObject): void {
    const index = this.cullableObjects.indexOf(gameObject);
    if (index !== -1) {
      this.cullableObjects.splice(index, 1);
    }
  }
  
  updateCulling(): void {
    // Get camera view rectangle (with padding)
    const cameraView = new Phaser.Geom.Rectangle(
      this.camera.worldView.x - this.cullPadding,
      this.camera.worldView.y - this.cullPadding,
      this.camera.worldView.width + (this.cullPadding * 2),
      this.camera.worldView.height + (this.cullPadding * 2)
    );
    
    // Check each object against camera view
    this.cullableObjects.forEach(obj => {
      // Skip if object has no getBounds method
      if (!obj.getBounds) return;
      
      const bounds = obj.getBounds();
      
      // Check if object bounds intersect with camera view
      const isVisible = Phaser.Geom.Rectangle.Overlaps(cameraView, bounds);
      
      // Only update visibility if it's changing
      if (obj.visible !== isVisible) {
        obj.visible = isVisible;
        
        // If the object has a setActive method (e.g., physics objects), also use it
        if (obj.setActive) {
          obj.setActive(isVisible);
        }
      }
    });
  }
  
  destroy(): void {
    this.camera.off('camerafadeincomplete');
    this.scene.events.off('update', this.updateCulling);
    this.cullableObjects = [];
  }
}

// Usage
const cullingManager = new CullingManager(this);

// Register objects for culling
cullingManager.registerForCulling(enemy);
cullingManager.registerForCulling(building);

// Unregister when objects are destroyed
enemy.on('destroy', () => {
  cullingManager.unregisterFromCulling(enemy);
});
```
</example>

