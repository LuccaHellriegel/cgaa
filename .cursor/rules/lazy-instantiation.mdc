## Lazy Instantiation Patterns

1. **Proxy-Based Lazy Loading**:
   ```typescript
   /**
    * Proxy-based lazy loading for expensive game resources
    */
   class LazyLoadProxy<T> {
     private factory: () => T;
     private instance: T = null;
     
     constructor(factory: () => T) {
       this.factory = factory;
     }
     
     /**
      * Get the resource, creating it if needed
      */
     get(): T {
       if (this.instance === null) {
         this.instance = this.factory();
       }
       return this.instance;
     }
     
     /**
      * Check if the resource has been instantiated
      */
     isInstantiated(): boolean {
       return this.instance !== null;
     }
     
     /**
      * Release the resource
      */
     release(): void {
       if (this.instance !== null) {
         // Call destroy if available
         if (typeof (this.instance as any).destroy === 'function') {
           (this.instance as any).destroy();
         }
         this.instance = null;
       }
     }
   }
   
   // Usage example
   class GameScene extends Phaser.Scene {
     private bossEnemy: LazyLoadProxy<BossEnemy>;
     private specialEffects: LazyLoadProxy<SpecialEffects>;
     
     constructor() {
       super({ key: 'GameScene' });
       
       // Create proxies but not the actual resources
       this.bossEnemy = new LazyLoadProxy(() => 
         new BossEnemy(this, this.cameras.main.width / 2, 100)
       );
       
       this.specialEffects = new LazyLoadProxy(() => 
         new SpecialEffects(this)
       );
     }
     
     create() {
       // Game setup without loading boss or effects yet
       
       // Only when player reaches boss area
       this.input.keyboard.on('keydown-B', () => {
         // Boss is created only when needed
         const boss = this.bossEnemy.get();
         boss.activate();
       });
       
       // Only when special effects are needed
       this.input.keyboard.on('keydown-E', () => {
         // Effects are created only when needed
         const effects = this.specialEffects.get();
         effects.playExplosion(400, 300);
       });
     }
   }
   ```

2. **Progressive Level Loading**:
   ```typescript
   /**
    * Progressive level loader that loads sections as needed
    */
   class ProgressiveLevelLoader {
     private scene: Phaser.Scene;
     private levelData: any;
     private loadedSections: Set<string> = new Set();
     private activeSections: Set<string> = new Set();
     private sectionFactories: Map<string, () => LevelSection> = new Map();
     private sectionInstances: Map<string, LevelSection> = new Map();
     private playerPosition: Phaser.Math.Vector2;
     private sectionSize: number = 1000; // Size of each section in pixels
     
     constructor(scene: Phaser.Scene, levelData: any) {
       this.scene = scene;
       this.levelData = levelData;
       this.playerPosition = new Phaser.Math.Vector2(0, 0);
       
       // Register section factories
       this.registerSectionFactories();
       
       // Update active sections when player moves
       this.scene.events.on('update', this.updateActiveSections, this);
     }
     
     /**
      * Register factories for each level section
      */
     private registerSectionFactories(): void {
       // Process level data to create section factories
       for (const section of this.levelData.sections) {
         this.sectionFactories.set(section.id, () => {
           return new LevelSection(
             this.scene,
             section.id,
             section.x,
             section.y,
             section.data
           );
         });
       }
     }
     
     /**
      * Update player position
      */
     updatePlayerPosition(x: number, y: number): void {
       this.playerPosition.set(x, y);
     }
     
     /**
      * Update which sections should be active based on player position
      */
     private updateActiveSections(): void {
       // Calculate which sections should be active based on player position
       const activeSectionIds = this.getSectionsInRange(
         this.playerPosition.x,
         this.playerPosition.y,
         2 // Load sections within 2 section distances
       );
       
       // Load new sections that should be active
       for (const sectionId of activeSectionIds) {
         if (!this.activeSections.has(sectionId)) {
           this.loadSection(sectionId);
           this.activeSections.add(sectionId);
         }
       }
       
       // Unload sections that should no longer be active
       for (const sectionId of this.activeSections) {
         if (!activeSectionIds.includes(sectionId)) {
           this.unloadSection(sectionId);
           this.activeSections.delete(sectionId);
         }
       }
     }
     
     /**
      * Get section IDs within range of a position
      */
     private getSectionsInRange(x: number, y: number, range: number): string[] {
       const result: string[] = [];
       
       // Calculate section coordinates from position
       const centerSectionX = Math.floor(x / this.sectionSize);
       const centerSectionY = Math.floor(y / this.sectionSize);
       
       // Get sections in range
       for (let dx = -range; dx <= range; dx++) {
         for (let dy = -range; dy <= range; dy++) {
           const sectionX = centerSectionX + dx;
           const sectionY = centerSectionY + dy;
           const sectionId = `section_${sectionX}_${sectionY}`;
           
           // Only include sections that exist in level data
           if (this.sectionFactories.has(sectionId)) {
             result.push(sectionId);
           }
         }
       }
       
       return result;
     }
     
     /**
      * Load a specific section
      */
     private loadSection(sectionId: string): void {
       if (this.sectionInstances.has(sectionId)) {
         // Section already loaded, just activate it
         const section = this.sectionInstances.get(sectionId);
         section.activate();
       } else if (this.sectionFactories.has(sectionId)) {
         // Create new section
         console.log(`Loading section: ${sectionId}`);
         const factory = this.sectionFactories.get(sectionId);
         const section = factory();
         
         // Store and activate
         this.sectionInstances.set(sectionId, section);
         section.activate();
         
         // Track as loaded
         this.loadedSections.add(sectionId);
       }
     }
     
     /**
      * Unload a specific section
      */
     private unloadSection(sectionId: string): void {
       if (this.sectionInstances.has(sectionId)) {
         console.log(`Unloading section: ${sectionId}`);
         const section = this.sectionInstances.get(sectionId);
         
         // Deactivate but keep instance for quick reloading
         section.deactivate();
       }
     }
     
     /**
      * Completely remove a section from memory
      */
     private destroySection(sectionId: string): void {
       if (this.sectionInstances.has(sectionId)) {
         const section = this.sectionInstances.get(sectionId);
         section.destroy();
         this.sectionInstances.delete(sectionId);
         this.loadedSections.delete(sectionId);
       }
     }
     
     /**
      * Clean up resources
      */
     destroy(): void {
       this.scene.events.off('update', this.updateActiveSections, this);
       
       // Destroy all sections
       for (const section of this.sectionInstances.values()) {
         section.destroy();
       }
       
       this.sectionInstances.clear();
       this.loadedSections.clear();
       this.activeSections.clear();
     }
   }
   
   /**
    * Represents a section of the game level
    */
   class LevelSection {
     private scene: Phaser.Scene;
     private id: string;
     private x: number;
     private y: number;
     private data: any;
     private gameObjects: Phaser.GameObjects.GameObject[] = [];
     private isActive: boolean = false;
     
     constructor(scene: Phaser.Scene, id: string, x: number, y: number, data: any) {
       this.scene = scene;
       this.id = id;
       this.x = x;
       this.y = y;
       this.data = data;
     }
     
     /**
      * Activate this section
      */
     activate(): void {
       if (this.isActive) return;
       
       // Create game objects from section data
       this.createGameObjects();
       this.isActive = true;
     }
     
     /**
      * Deactivate this section
      */
     deactivate(): void {
       if (!this.isActive) return;
       
       // Hide or disable game objects but don't destroy
       this.gameObjects.forEach(obj => {
         obj.setActive(false);
         obj.setVisible(false);
       });
       
       this.isActive = false;
     }
     
     /**
      * Create game objects for this section
      */
     private createGameObjects(): void {
       // Process section data to create game objects
       // This would be implemented based on your game's specific needs
       
       // Example: Create platforms
       if (this.data.platforms) {
         for (const platform of this.data.platforms) {
           const obj = this.scene.add.rectangle(
             this.x + platform.x,
             this.y + platform.y,
             platform.width,
             platform.height,
             0x00ff00
           );
           this.scene.physics.add.existing(obj, true);
           this.gameObjects.push(obj);
         }
       }
       
       // Example: Create collectibles
       if (this.data.collectibles) {
         for (const collectible of this.data.collectibles) {
           const obj = this.scene.add.sprite(
             this.x + collectible.x,
             this.y + collectible.y,
             'collectible'
           );
           this.scene.physics.add.existing(obj);
           this.gameObjects.push(obj);
         }
       }
     }
     
     /**
      * Destroy all resources
      */
     destroy(): void {
       this.gameObjects.forEach(obj => obj.destroy());
       this.gameObjects = [];
       this.isActive = false;
     }
   }
