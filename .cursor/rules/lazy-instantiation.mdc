# Lazy Instantiation

## Context
- When working with memory-intensive game objects or resources
- When optimizing initial loading times and memory usage
- When implementing complex game scenes with many potential objects
- When targeting memory-constrained platforms
- When building games with dynamic content loading

## Requirements
- Create objects only when they are actually needed
- Implement factories or builders for deferred object creation
- Use proxies or placeholders for expensive resources
- Apply just-in-time initialization for game elements
- Implement progressive loading for large game worlds
- Balance memory usage with CPU cost of instantiation

## Examples

<example>
```typescript
/**
 * Lazy loading manager for game resources
 */
class LazyResourceManager {
  private scene: Phaser.Scene;
  private factories: Map<string, () => any> = new Map();
  private instances: Map<string, any> = new Map();
  private loadingPromises: Map<string, Promise<any>> = new Map();
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  /**
   * Register a factory function for a resource
   * @param key Unique identifier for the resource
   * @param factory Function that creates the resource
   */
  register<T>(key: string, factory: () => T): void {
    this.factories.set(key, factory);
  }
  
  /**
   * Get a resource, creating it if it doesn't exist
   * @param key The resource identifier
   * @returns The requested resource
   */
  get<T>(key: string): T {
    // Return existing instance if available
    if (this.instances.has(key)) {
      return this.instances.get(key) as T;
    }
    
    // Check if we have a factory for this resource
    if (!this.factories.has(key)) {
      throw new Error(`No factory registered for resource: ${key}`);
    }
    
    // Create the resource
    const factory = this.factories.get(key);
    const instance = factory();
    
    // Store for future use
    this.instances.set(key, instance);
    
    return instance as T;
  }
  
  /**
   * Asynchronously get a resource, with loading indicator
   * @param key The resource identifier
   * @returns Promise that resolves to the requested resource
   */
  async getAsync<T>(key: string): Promise<T> {
    // Return existing instance if available
    if (this.instances.has(key)) {
      return Promise.resolve(this.instances.get(key) as T);
    }
    
    // Return existing promise if already loading
    if (this.loadingPromises.has(key)) {
      return this.loadingPromises.get(key) as Promise<T>;
    }
    
    // Check if we have a factory for this resource
    if (!this.factories.has(key)) {
      throw new Error(`No factory registered for resource: ${key}`);
    }
    
    // Create loading promise
    const loadPromise = new Promise<T>((resolve, reject) => {
      try {
        // Show loading indicator
        const loadingText = this.scene.add.text(
          this.scene.cameras.main.centerX,
          this.scene.cameras.main.centerY,
          `Loading ${key}...`,
          { fontSize: '24px', color: '#ffffff' }
        ).setOrigin(0.5);
        
        // Create the resource (possibly async)
        const factory = this.factories.get(key);
        const instance = factory();
        
        // Store for future use
        this.instances.set(key, instance);
        
        // Remove loading indicator and resolve
        loadingText.destroy();
        resolve(instance as T);
      } catch (error) {
        reject(error);
      }
    });
    
    // Store promise and clean up when done
    this.loadingPromises.set(key, loadPromise);
    loadPromise.finally(() => {
      this.loadingPromises.delete(key);
    });
    
    return loadPromise;
  }
  
  /**
   * Check if a resource is already instantiated
   * @param key The resource identifier
   * @returns True if the resource exists
   */
  has(key: string): boolean {
    return this.instances.has(key);
  }
  
  /**
   * Release a resource to free memory
   * @param key The resource identifier
   */
  release(key: string): void {
    if (this.instances.has(key)) {
      const instance = this.instances.get(key);
      
      // Call destroy method if available
      if (instance && typeof instance.destroy === 'function') {
        instance.destroy();
      }
      
      this.instances.delete(key);
    }
  }
  
  /**
   * Release all resources
   */
  releaseAll(): void {
    for (const key of this.instances.keys()) {
      this.release(key);
    }
  }
}
```
