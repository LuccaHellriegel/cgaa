## Diagnostic Overlay Patterns

1. **Frame Rate Analysis Chart**:
   ```typescript
   /**
    * Visual performance analysis chart
    */
   class PerformanceChart {
     private scene: Phaser.Scene;
     private graphics: Phaser.GameObjects.Graphics;
     private fpsData: number[] = [];
     private frameTimeData: number[] = [];
     private gcTimings: number[] = [];
     private maxSamples: number = 100;
     private visible: boolean = false;
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       this.graphics = scene.add.graphics();
       this.graphics.setScrollFactor(0).setDepth(10000).setVisible(false);
       
       // Background panel
       const width = 300;
       const height = 150;
       const x = scene.cameras.main.width - width - 10;
       const y = 10;
       
       const background = scene.add.rectangle(
         x + width/2, 
         y + height/2, 
         width, 
         height, 
         0x000000, 
         0.7
       );
       background.setScrollFactor(0).setDepth(9999).setVisible(false);
       
       // Monitor for GC events using frame time spikes
       let lastFrameTime = 0;
       scene.events.on('update', (time, delta) => {
         // Record FPS and frame time
         if (this.visible) {
           this.fpsData.push(1000 / delta);
           this.frameTimeData.push(delta);
           
           // Limit data points
           if (this.fpsData.length > this.maxSamples) {
             this.fpsData.shift();
             this.frameTimeData.shift();
           }
           
           // Check for potential GC pauses
           if (delta > 50 && lastFrameTime < 20) {
             this.gcTimings.push(time);
           }
           
           lastFrameTime = delta;
           this.drawChart();
         }
       });
       
       // Toggle visibility with key
       scene.input.keyboard.on('keydown-P', () => {
         this.visible = !this.visible;
         this.graphics.setVisible(this.visible);
         background.setVisible(this.visible);
       });
     }
     
     /**
      * Draw the performance chart
      */
     private drawChart(): void {
       this.graphics.clear();
       
       const width = 280;
       const height = 120;
       const x = this.scene.cameras.main.width - width - 20;
       const y = 20;
       
       // Draw axes
       this.graphics.lineStyle(1, 0xffffff, 0.5);
       this.graphics.beginPath();
       this.graphics.moveTo(x, y);
       this.graphics.lineTo(x, y + height);
       this.graphics.lineTo(x + width, y + height);
       this.graphics.strokePath();
       
       // Draw FPS target line (60fps)
       this.graphics.lineStyle(1, 0x00ff00, 0.3);
       this.graphics.beginPath();
       this.graphics.moveTo(x, y + height - (height * 60 / 70));
       this.graphics.lineTo(x + width, y + height - (height * 60 / 70));
       this.graphics.strokePath();
       
       // Draw FPS data
       if (this.fpsData.length > 1) {
         const fpsMax = 70; // Max value
         this.graphics.lineStyle(1, 0x00ff00, 0.8);
         this.graphics.beginPath();
         
         // Draw each data point connected by lines
         this.fpsData.forEach((fps, index) => {
           const pointX = x + (index / this.maxSamples) * width;
           const pointY = y + height - (Math.min(fps, fpsMax) / fpsMax) * height;
           
           if (index === 0) {
             this.graphics.moveTo(pointX, pointY);
           } else {
             this.graphics.lineTo(pointX, pointY);
           }
         });
         this.graphics.strokePath();
         
         // Draw significant frame time spikes
         this.graphics.lineStyle(2, 0xff0000, 0.8);
         this.frameTimeData.forEach((time, index) => {
           if (time > 30) { // Over 30ms (under 33fps)
             const pointX = x + (index / this.maxSamples) * width;
             this.graphics.beginPath();
             this.graphics.moveTo(pointX, y + height);
             this.graphics.lineTo(pointX, y);
             this.graphics.strokePath();
           }
         });
         
         // Add text for latest values
         const currentFps = this.fpsData[this.fpsData.length - 1];
         const currentFrameTime = this.frameTimeData[this.frameTimeData.length - 1];
         
         const statsText = this.scene.add.text(
           x, 
           y - 15, 
           `FPS: ${Math.round(currentFps)} - Frame Time: ${currentFrameTime.toFixed(1)}ms`, 
           { fontSize: '12px', color: '#ffffff' }
         );
         statsText.setScrollFactor(0).setDepth(10000);
         
         // Remove after a brief delay
         this.scene.time.delayedCall(1000, () => {
           statsText.destroy();
         });
       }
     }
     
     /**
      * Clean up resources
      */
     destroy(): void {
       this.scene.events.off('update');
       this.scene.input.keyboard.off('keydown-P');
       this.graphics.destroy();
     }
   }
   ```

2. **Entity Inspector**:
   ```typescript
   /**
    * Interactive inspector for game objects
    */
   class EntityInspector {
     private scene: Phaser.Scene;
     private inspectableEntities: Map<string, Phaser.GameObjects.GameObject> = new Map();
     private graphics: Phaser.GameObjects.Graphics;
     private infoPanel: Phaser.GameObjects.Container;
     private selectedEntity: string = null;
     private isActive: boolean = false;
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       this.graphics = scene.add.graphics();
       this.graphics.setDepth(9000);
       
       // Create info panel container
       this.infoPanel = scene.add.container(10, 10);
       this.infoPanel.setDepth(9001);
       this.infoPanel.setScrollFactor(0);
       this.infoPanel.setVisible(false);
       
       // Toggle inspector with I key
       scene.input.keyboard.on('keydown-I', this.toggleInspector, this);
       
       // Click handler for selecting entities
       scene.input.on('pointerdown', this.handleClick, this);
       
       // Update each frame
       scene.events.on('update', this.update, this);
     }
     
     /**
      * Add an entity that can be inspected
      */
     registerEntity(id: string, entity: Phaser.GameObjects.GameObject): void {
       this.inspectableEntities.set(id, entity);
     }
     
     /**
      * Toggle inspector visibility
      */
     toggleInspector(): void {
       this.isActive = !this.isActive;
       this.graphics.setVisible(this.isActive);
       
       if (!this.isActive) {
         this.selectedEntity = null;
         this.infoPanel.setVisible(false);
       }
     }
     
     /**
      * Handle mouse clicks to select entities
      */
     private handleClick(pointer: Phaser.Input.Pointer): void {
       if (!this.isActive) return;
       
       // Check if click hits any registered entity
       let clickedEntity: string = null;
       
       this.inspectableEntities.forEach((entity, id) => {
         if (entity instanceof Phaser.GameObjects.Sprite) {
           if (Phaser.Geom.Rectangle.Contains(
             entity.getBounds(), 
             pointer.worldX, 
             pointer.worldY
           )) {
             clickedEntity = id;
           }
         }
       });
       
       if (clickedEntity) {
         this.selectedEntity = clickedEntity;
         this.updateInfoPanel();
       } else {
         this.selectedEntity = null;
         this.infoPanel.setVisible(false);
       }
     }
     
     /**
      * Update highlighting and info every frame
      */
     private update(): void {
       if (!this.isActive) return;
       
       this.graphics.clear();
       
       // Highlight all inspectable entities
       this.inspectableEntities.forEach((entity, id) => {
         if (entity instanceof Phaser.GameObjects.Sprite) {
           const bounds = entity.getBounds();
           
           // Highlight selected entity with a different color
           const color = (id === this.selectedEntity) ? 0xffff00 : 0x00ffff;
           const lineWidth = (id === this.selectedEntity) ? 2 : 1;
           
           this.graphics.lineStyle(lineWidth, color, 0.8);
           this.graphics.strokeRect(
             bounds.x, 
             bounds.y, 
             bounds.width, 
             bounds.height
           );
           
           // Draw entity name above
           if (id === this.selectedEntity) {
             const namePos = {
               x: bounds.centerX,
               y: bounds.y - 15
             };
             
             // Add a small indicator line
             this.graphics.lineBetween(
               bounds.centerX,
               bounds.y,
               namePos.x,
               namePos.y
             );
           }
         }
       });
       
       // Update info panel if entity is selected
       if (this.selectedEntity && this.infoPanel.visible) {
         this.updateInfoPanel();
       }
     }
     
     /**
      * Update the information panel for selected entity
      */
     private updateInfoPanel(): void {
       // Clear previous contents
       this.infoPanel.removeAll(true);
       
       const entity = this.inspectableEntities.get(this.selectedEntity);
       if (!entity) return;
       
       // Create background
       const background = this.scene.add.rectangle(0, 0, 300, 200, 0x000000, 0.8);
       background.setOrigin(0, 0);
       this.infoPanel.add(background);
       
       // Title
       const title = this.scene.add.text(10, 10, this.selectedEntity, { 
         fontSize: '18px', 
         color: '#ffffff',
         fontStyle: 'bold'
       });
       this.infoPanel.add(title);
       
       // Entity properties
       let yPos = 40;
       const properties: string[] = [];
       
       // Position
       properties.push(`Position: x=${Math.round(entity.x)}, y=${Math.round(entity.y)}`);
       
       // Type-specific properties
       if (entity instanceof Phaser.GameObjects.Sprite) {
         properties.push(`Size: ${entity.width}x${entity.height}`);
         properties.push(`Visible: ${entity.visible}`);
         properties.push(`Alpha: ${entity.alpha.toFixed(2)}`);
         properties.push(`Angle: ${Math.round(entity.angle)}°`);
         properties.push(`Origin: ${entity.originX.toFixed(2)}, ${entity.originY.toFixed(2)}`);
         
         // Physics properties if available
         const body = (entity.body as Phaser.Physics.Arcade.Body);
         if (body) {
           properties.push('--- Physics ---');
           properties.push(`Velocity: x=${Math.round(body.velocity.x)}, y=${Math.round(body.velocity.y)}`);
           properties.push(`Speed: ${Math.round(body.speed)}`);
           properties.push(`Immovable: ${body.immovable}`);
           properties.push(`Collides: ${!body.checkCollision.none}`);
         }
       }
       
       // Add property texts
       properties.forEach(prop => {
         const text = this.scene.add.text(15, yPos, prop, {
           fontSize: '14px', 
           color: '#cccccc'
         });
         this.infoPanel.add(text);
         yPos += 20;
       });
       
       // Resize background to fit content
       background.height = yPos + 10;
       
       // Show the panel
       this.infoPanel.setVisible(true);
     }
     
     /**
      * Clean up resources
      */
     destroy(): void {
       this.scene.input.keyboard.off('keydown-I', this.toggleInspector, this);
       this.scene.input.off('pointerdown', this.handleClick, this);
       this.scene.events.off('update', this.update, this);
       
       this.graphics.destroy();
       this.infoPanel.destroy();
       
       this.inspectableEntities.clear();
     }
   }
