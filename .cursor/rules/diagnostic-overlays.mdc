<example>
```typescript
/**
 * Visual debugging system for Phaser games
 */
class VisualDebugger {
  private scene: Phaser.Scene;
  private isEnabled: boolean = false;
  private debugGraphics: Phaser.GameObjects.Graphics;
  private debugTexts: Map<string, Phaser.GameObjects.Text> = new Map();
  private fpsDisplay: Phaser.GameObjects.Text;
  private memoryDisplay: Phaser.GameObjects.Text;
  private perfMetrics: {
    fps: number[];
    frameTime: number[];
    maxSamples: number;
  };
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    this.debugGraphics = scene.add.graphics();
    this.debugGraphics.setDepth(9999); // Ensure it's on top
    
    // Initialize performance metrics storage
    this.perfMetrics = {
      fps: [],
      frameTime: [],
      maxSamples: 60 // Store 1 second at 60fps
    };
    
    // Create FPS counter
    this.fpsDisplay = this.scene.add.text(10, 10, 'FPS: 0', {
      fontSize: '16px',
      color: '#00ff00',
      backgroundColor: '#00000080'
    });
    this.fpsDisplay.setScrollFactor(0).setDepth(10000).setVisible(false);
    
    // Create memory usage display
    this.memoryDisplay = this.scene.add.text(10, 30, 'Memory: 0 MB', {
      fontSize: '16px',
      color: '#00ff00',
      backgroundColor: '#00000080'
    });
    this.memoryDisplay.setScrollFactor(0).setDepth(10000).setVisible(false);
    
    // Setup toggle key
    this.scene.input.keyboard.on('keydown-BACKTICK', this.toggleDebug, this);
    
    // Subscribe to scene update
    this.scene.events.on('update', this.update, this);
  }
  
  /**
   * Toggle debug overlay visibility
   */
  toggleDebug(): void {
    this.isEnabled = !this.isEnabled;
    
    // Toggle visibility of all debug elements
    this.debugGraphics.setVisible(this.isEnabled);
    this.fpsDisplay.setVisible(this.isEnabled);
    this.memoryDisplay.setVisible(this.isEnabled);
    
    this.debugTexts.forEach(text => {
      text.setVisible(this.isEnabled);
    });
    
    // Clear graphics when enabling to start fresh
    if (this.isEnabled) {
      this.debugGraphics.clear();
    }
  }
  
  /**
   * Update the debug overlay each frame
   */
  update(time: number, delta: number): void {
    if (!this.isEnabled) return;
    
    // Clear previous frame graphics
    this.debugGraphics.clear();
    
    // Update FPS counter
    const fps = Math.round(1000 / delta);
    this.perfMetrics.fps.push(fps);
    if (this.perfMetrics.fps.length > this.perfMetrics.maxSamples) {
      this.perfMetrics.fps.shift();
    }
    
    const avgFps = this.perfMetrics.fps.reduce((sum, value) => sum + value, 0) / 
                   this.perfMetrics.fps.length;
    
    this.fpsDisplay.setText(`FPS: ${Math.round(avgFps)} (${fps})`);
    this.fpsDisplay.setColor(fps < 30 ? '#ff0000' : fps < 50 ? '#ffff00' : '#00ff00');
    
    // Update memory usage if supported
    if (window.performance && window.performance.memory) {
      const memory = Math.round(window.performance.memory.usedJSHeapSize / (1024 * 1024));
      this.memoryDisplay.setText(`Memory: ${memory} MB`);
      this.memoryDisplay.setColor(memory > 100 ? '#ff0000' : '#00ff00');
    }
    
    // Draw any registered debug visualizations
    this.drawColliders();
    this.drawPaths();
  }
  
  /**
   * Draw physics colliders and bounds
   */
  private drawColliders(): void {
    const bodies = this.scene.physics.world.bodies.getArray();
    
    bodies.forEach(body => {
      // Different colors based on body properties
      const isStatic = body.immovable;
      const isAwake = body.sleeping;
      
      let color = 0x00ff00; // Green for normal bodies
      if (isStatic) color = 0x0000ff; // Blue for static bodies
      if (!isAwake) color = 0x999999; // Gray for sleeping bodies
      
      this.debugGraphics.lineStyle(1, color, 0.8);
      
      // Draw the body bounds
      this.debugGraphics.strokeRect(
        body.x - body.halfWidth, 
        body.y - body.halfHeight,
        body.width,
        body.height
      );
      
      // Draw velocity vector
      if (body.velocity.length() > 0) {
        const velScale = 0.1; // Scale velocity for visualization
        this.debugGraphics.lineStyle(2, 0xff0000, 0.8);
        this.debugGraphics.beginPath();
        this.debugGraphics.moveTo(body.x, body.y);
        this.debugGraphics.lineTo(
          body.x + body.velocity.x * velScale,
          body.y + body.velocity.y * velScale
        );
        this.debugGraphics.closePath();
        this.debugGraphics.strokePath();
      }
    });
  }
  
  /**
   * Draw AI paths and waypoints
   */
  private drawPaths(): void {
    // Draw any registered AI paths or waypoints
    // Would be implemented in a game-specific way
  }
  
  /**
   * Add a value to be monitored in the debug display
   * @param key Unique identifier for this value
   * @param getValue Function that returns the current value
   * @param position Screen position {x, y} for the text
   * @param options Text formatting options
   */
  addMonitoredValue(
    key: string,
    getValue: () => any,
    position: { x: number, y: number },
    options: { fontSize?: string, color?: string } = {}
  ): void {
    const text = this.scene.add.text(
      position.x,
      position.y,
      `${key}: ${getValue()}`,
      {
        fontSize: options.fontSize || '16px',
        color: options.color || '#ffffff',
        backgroundColor: '#00000080'
      }
    );
    
    text.setScrollFactor(0).setDepth(10000).setVisible(this.isEnabled);
    this.debugTexts.set(key, text);
    
    // Update this value each frame
    this.scene.events.on('update', () => {
      if (!this.isEnabled) return;
      text.setText(`${key}: ${getValue()}`);
    });
  }
  
  /**
   * Clean up resources when scene is destroyed
   */
  destroy(): void {
    this.scene.events.off('update', this.update, this);
    this.scene.input.keyboard.off('keydown-BACKTICK', this.toggleDebug, this);
    
    this.debugGraphics.destroy();
    this.fpsDisplay.destroy();
    this.memoryDisplay.destroy();
    
    this.debugTexts.forEach(text => text.destroy());
    this.debugTexts.clear();
    
    this.scene = null;
    this.debugGraphics = null;
  }
}
