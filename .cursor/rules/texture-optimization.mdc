# Texture Optimization

## Context
- When loading and managing game textures and sprites
- When experiencing performance issues related to texture handling
- When targeting memory-constrained devices
- When working with games that have many visual assets

## Requirements
- Use texture atlases and sprite sheets instead of individual images
- Implement proper texture memory management
- Optimize texture dimensions for GPU compatibility
- Reuse textures across multiple game objects
- Generate and cache procedural textures efficiently

## Examples

<example>
```typescript
// GOOD: Using texture atlases for efficient rendering
export class TextureManager {
  constructor(private scene: Phaser.Scene) {}

  preloadAssets(): void {
    // Load a texture atlas instead of individual sprites
    this.scene.load.atlas(
      'gameSprites',
      'assets/spritesheet.png',
      'assets/spritesheet.json'
    );
    
    // Set up animations from atlas
    this.scene.load.once('complete', () => {
      this.setupAnimations();
    });
  }
  
  private setupAnimations(): void {
    // Create animations using the atlas frames
    this.scene.anims.create({
      key: 'player_walk',
      frames: this.scene.anims.generateFrameNames('gameSprites', {
        prefix: 'player/walk_',
        start: 0,
        end: 7,
        zeroPad: 2
      }),
      frameRate: 10,
      repeat: -1
    });
    
    // More animations...
  }

  // Create a reusable texture from shapes once and reuse many times
  createShapeTexture(key: string, drawFunction: (graphics: Phaser.GameObjects.Graphics) => void): string {
    // Check if texture already exists
    if (this.scene.textures.exists(key)) {
      return key;
    }
    
    // Create a reusable texture from shapes
    const graphics = this.scene.make.graphics({});
    drawFunction(graphics);
    
    // Generate a texture that can be reused with sprites
    graphics.generateTexture(key, graphics.width, graphics.height);
    graphics.destroy();
    
    return key;
  }
  
  createCircleTexture(key: string, radius: number, fillColor: number): string {
    return this.createShapeTexture(key, (graphics) => {
      graphics.fillStyle(fillColor);
      graphics.fillCircle(radius, radius, radius);
      graphics.lineStyle(2, 0x000000);
      graphics.strokeCircle(radius, radius, radius);
    });
  }
}

// Usage
const manager = new TextureManager(scene);
manager.preloadAssets();

// Create sprite using atlas
const playerSprite = scene.add.sprite(100, 100, 'gameSprites', 'player/idle');
playerSprite.play('player_walk');

// Reuse generated texture for multiple objects
const textureKey = manager.createCircleTexture('redBall', 10, 0xff0000);
for (let i = 0; i < 100; i++) {
  scene.add.image(Math.random() * 800, Math.random() * 600, textureKey);
}
```
</example>

