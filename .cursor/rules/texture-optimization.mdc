// BAD: Loading many individual images instead of atlases
export class IneffientTextureLoader {
  constructor(private scene: Phaser.Scene) {}
  
  loadAssets(): void {
    // Loading many individual images separately
    this.scene.load.image('player_idle', 'assets/player_idle.png');
    this.scene.load.image('player_walk_1', 'assets/player_walk_1.png');
    this.scene.load.image('player_walk_2', 'assets/player_walk_2.png');
    this.scene.load.image('player_walk_3', 'assets/player_walk_3.png');
    this.scene.load.image('player_walk_4', 'assets/player_walk_4.png');
    this.scene.load.image('player_walk_5', 'assets/player_walk_5.png');
    this.scene.load.image('player_walk_6', 'assets/player_walk_6.png');
    this.scene.load.image('player_walk_7', 'assets/player_walk_7.png');
    this.scene.load.image('player_walk_8', 'assets/player_walk_8.png');
    // Dozens more individual images...
  }
  
  // BAD: Creating new Graphics object for EVERY entity
  createEnemy(x: number, y: number): Phaser.GameObjects.Sprite {
    // Create a new Graphics object for EVERY enemy
    const graphics = this.scene.add.graphics();
    graphics.fillStyle(0xff0000);
    graphics.fillCircle(0, 0, 20);
    
    // Each enemy gets unique texture - terrible for performance
    const uniqueKey = 'enemy_' + Date.now() + '_' + Math.random();
    graphics.generateTexture(uniqueKey, 40, 40);
    graphics.destroy();
    
    // Create sprite with the just-generated unique texture
    return this.scene.add.sprite(x, y, uniqueKey);
  }
}
```
This approach creates performance issues by loading many individual textures and generating new textures for each entity, leading to excessive memory use and draw calls.
</example>

## Best Practices

1. **Texture Atlases**:
   ```typescript
   // In your preloader scene
   this.load.atlas('spritesheet', 'assets/spritesheet.png', 'assets/spritesheet.json');
   
   // Create sprites from atlas later
   const sprite = this.add.sprite(x, y, 'spritesheet', 'player_idle');
   ```

2. **Power-of-Two Textures**:
   - Use texture dimensions that are powers of two (256, 512, 1024, etc.)
   - This optimizes GPU memory usage and compatibility
   - Example: Resize source art to 512×512 instead of 500×500

3. **Trim Sprite Sheets**:
   - Remove transparent borders around sprites in your atlas
   - Most atlas packers offer trimming options
   - Maintain original size/positioning with frame data

4. **Generate Procedural Textures Once**:
   ```typescript
   // Generate texture once at startup
   function createParticleTextures() {
     const colors = [0xff0000, 0x00ff00, 0x0000ff];
     
     colors.forEach(color => {
       const key = `particle_${color.toString(16)}`;
       const graphics = this.make.graphics();
       graphics.fillStyle(color, 1);
       graphics.fillCircle(8, 8, 8);
       graphics.generateTexture(key, 16, 16);
       graphics.destroy();
     });
   }
   ```

5. **Texture Management**:
   ```typescript
   // Remove textures when no longer needed
   this.textures.remove('unusedTexture');
   ```

