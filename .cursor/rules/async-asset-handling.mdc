# Asynchronous Asset Handling

## Context
- When loading assets such as images, audio, or data files
- When transitioning between game scenes that require different assets
- When developing games with large asset requirements
- When targeting web platforms with varying bandwidth considerations

## Requirements
- Implement loading screens to display progress while assets load
- Preload assets before they are needed to prevent stuttering
- Use asynchronous loading patterns to prevent UI blocking
- Implement dynamic asset loading for large games
- Unload unused assets to free memory when they're no longer needed
- Handle loading errors gracefully with fallbacks

## Examples

<example>
```typescript
/**
 * Asset manager for handling asynchronous loading and unloading
 */
class AssetManager {
  private scene: Phaser.Scene;
  private loadedAssets: Set<string> = new Set();
  private loadingPromises: Map<string, Promise<void>> = new Map();
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  /**
   * Preload a set of assets asynchronously with progress tracking
   * @param assets Array of asset descriptors to load
   * @returns Promise that resolves when all assets are loaded
   */
  async preloadAssets(
    assets: Array<{
      key: string;
      type: 'image' | 'spritesheet' | 'audio' | 'json';
      url: string;
      config?: any;
    }>,
    onProgress?: (progress: number) => void
  ): Promise<void> {
    // Skip if no assets to load
    if (assets.length === 0) {
      return Promise.resolve();
    }
    
    // Create a loader plugin if not already in a loading scene
    const loader = this.scene.load;
    
    // Track loaded and total files
    let loaded = 0;
    const total = assets.length;
    
    // Set up progress callback
    if (onProgress) {
      loader.on('progress', (value: number) => {
        onProgress(value);
      });
    }
    
    // Create a promise that resolves when loading completes
    return new Promise<void>((resolve, reject) => {
      // Set up completion handlers
      loader.once('complete', () => {
        // Add all keys to our loaded assets set
        assets.forEach(asset => this.loadedAssets.add(asset.key));
        resolve();
      });
      
      loader.once('loaderror', (file: Phaser.Loader.File) => {
        console.error(`Error loading asset: ${file.key}`);
        reject(new Error(`Failed to load asset: ${file.key}`));
      });
      
      // Add all assets to the loader queue
      assets.forEach(asset => {
        switch (asset.type) {
          case 'image':
            loader.image(asset.key, asset.url);
            break;
          case 'spritesheet':
            loader.spritesheet(asset.key, asset.url, asset.config);
            break;
          case 'audio':
            loader.audio(asset.key, asset.url);
            break;
          case 'json':
            loader.json(asset.key, asset.url);
            break;
        }
      });
      
      // Start loading
      loader.start();
    });
  }
  
  /**
   * Check if a specific asset is loaded
   * @param key The asset key to check
   */
  isLoaded(key: string): boolean {
    return this.loadedAssets.has(key);
  }
  
  /**
   * Load a specific asset if not already loaded
   * @param asset The asset to load
   * @returns Promise that resolves when the asset is loaded
   */
  async loadAsset(
    asset: {
      key: string;
      type: 'image' | 'spritesheet' | 'audio' | 'json';
      url: string;
      config?: any;
    }
  ): Promise<void> {
    // Return immediately if already loaded
    if (this.isLoaded(asset.key)) {
      return Promise.resolve();
    }
    
    // Return existing promise if already loading
    if (this.loadingPromises.has(asset.key)) {
      return this.loadingPromises.get(asset.key);
    }
    
    // Create new loading promise
    const loadPromise = this.preloadAssets([asset]);
    this.loadingPromises.set(asset.key, loadPromise);
    
    // Clean up promise map after loading
    loadPromise.finally(() => {
      this.loadingPromises.delete(asset.key);
    });
    
    return loadPromise;
  }
  
  /**
   * Unload specific assets to free memory
   * @param keys Array of asset keys to unload
   */
  unloadAssets(keys: string[]): void {
    keys.forEach(key => {
      if (this.loadedAssets.has(key)) {
        // Remove from texture cache if it's a texture
        if (this.scene.textures.exists(key)) {
          this.scene.textures.remove(key);
        }
        
        // Remove from cache based on type
        if (this.scene.cache.json.exists(key)) {
          this.scene.cache.json.remove(key);
        }
        
        if (this.scene.cache.audio.exists(key)) {
          this.scene.sound.remove(key);
        }
        
        // Remove from loaded assets tracking
        this.loadedAssets.delete(key);
      }
    });
  }
  
  /**
   * Create a loading scene that preloads assets before transitioning
   * @param targetScene The scene to transition to after loading
   * @param assets Assets to preload before starting the target scene
   */
  static createLoadingScene(
    targetScene: string,
    assets: Array<{
      key: string;
      type: 'image' | 'spritesheet' | 'audio' | 'json';
      url: string;
      config?: any;
    }>
  ): typeof Phaser.Scene {
    return class LoadingScene extends Phaser.Scene {
      constructor() {
        super({ key: 'LoadingScene' });
      }
      
      preload(): void {
        // Create loading UI
        const width = this.cameras.main.width;
        const height = this.cameras.main.height;
        
        // Add loading text
        const loadingText = this.add.text(
          width / 2,
          height / 2 - 50,
          'Loading...',
          {
            fontSize: '32px',
            color: '#FFFFFF'
          }
        ).setOrigin(0.5);
        
        // Create progress bar background
        const progressBarBg = this.add.rectangle(
          width / 2, 
          height / 2,
          400,
          30,
          0x222222
        ).setOrigin(0.5);
        
        // Create progress bar fill
        const progressBar = this.add.rectangle(
          width / 2 - 195,
          height / 2,
          5,
          20,
          0x00FF00
        ).setOrigin(0, 0.5);
        
        // Update progress bar as loading progresses
        this.load.on('progress', (value: number) => {
          progressBar.width = 390 * value;
        });
        
        // Add all assets to the loader
        assets.forEach(asset => {
          switch (asset.type) {
            case 'image':
              this.load.image(asset.key, asset.url);
              break;
            case 'spritesheet':
              this.load.spritesheet(asset.key, asset.url, asset.config);
              break;
            case 'audio':
              this.load.audio(asset.key, asset.url);
              break;
            case 'json':
              this.load.json(asset.key, asset.url);
              break;
          }
        });
      }
      
      create(): void {
        // Transition to target scene when loading is complete
        this.scene.start(targetScene);
      }
    };
  }
}
