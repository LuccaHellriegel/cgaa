   class LoadingScene extends Phaser.Scene {
     private progressBar: Phaser.GameObjects.Rectangle;
     private progressText: Phaser.GameObjects.Text;
     private errorText: Phaser.GameObjects.Text;
     
     constructor() {
       super({ key: 'LoadingScene' });
     }
     
     create(): void {
       const width = this.cameras.main.width;
       const height = this.cameras.main.height;
       
       // Add loading text
       this.progressText = this.add.text(
         width / 2,
         height / 2 - 50,
         'Loading...',
         {
           fontSize: '32px',
           color: '#FFFFFF'
         }
       ).setOrigin(0.5);
       
       // Create progress bar background
       const progressBarBg = this.add.rectangle(
         width / 2, 
         height / 2,
         400,
         30,
         0x222222
       ).setOrigin(0.5);
       
       // Create progress bar fill
       this.progressBar = this.add.rectangle(
         width / 2 - 195,
         height / 2,
         5,
         20,
         0x00FF00
       ).setOrigin(0, 0.5);
       
       // Add error text (initially hidden)
       this.errorText = this.add.text(
         width / 2,
         height / 2 + 50,
         '',
         {
           fontSize: '16px',
           color: '#FF0000'
         }
       ).setOrigin(0.5).setVisible(false);
       
       // Listen for progress updates
       this.events.on('loadProgress', (value: number) => {
         this.progressBar.width = 390 * value;
         this.progressText.setText(`Loading... ${Math.floor(value * 100)}%`);
       });
       
       // Listen for error events
       this.events.on('loadError', (error: Error) => {
         this.errorText.setText(`Error: ${error.message}\nTap to retry`);
         this.errorText.setVisible(true);
         this.progressText.setText('Loading Failed');
         this.progressBar.fillColor = 0xFF0000;
         
         // Add retry functionality
         this.input.once('pointerdown', () => {
           this.scene.start('MainMenu');
         });
       });
     }
   }
