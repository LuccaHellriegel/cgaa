      // Will cause game to freeze when pressed
      this.load.image('huge_background', 'assets/huge_background.png');
      this.load.start();
      this.add.image(0, 0, 'huge_background');
    });
  }
  
  // No dedicated loading screen
  // No progress indication
  // No error handling
  // No asset organization
