  // Apply multiple post-processing effects, each with separate pipeline and state changes
  applyEffects(): void {
    // Each effect changes shader, sets uniforms, and processes individually
    this.effects.forEach(effect => {
      // Get effect configuration
      const config = (effect as any).config;
      
      // For each effect, change the active pipeline
      this.scene.cameras.main.setRenderToTexture(config.pipelineName);
      
      // Set new uniforms for each effect, causing many state changes
      const pipeline = this.scene.cameras.main.pipeline;
      Object.keys(config.uniforms).forEach(key => {
        pipeline.setUniform(key, config.uniforms[key]);
      });
      
      // Bind new textures for each effect
      if (config.textures) {
        config.textures.forEach((texture, i) => {
          pipeline.setTexture(i, texture);
        });
      }
      
      // Process and render each effect separately
      pipeline.render();
      
      // Reset pipeline state after each effect
      pipeline.flush();
    });
  }
  
  // Apply a new filter on top of existing ones
  addFilter(filterType: string): void {
    const effect = this.scene.add.shader(filterType);
    
    // No batching or state optimization
    this.effects.push(effect);
    
    // Recreate pipeline with new effect
    this.applyEffects();
  }
