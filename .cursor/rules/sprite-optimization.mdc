## Sprite Optimization Techniques

1. **Sprite Sheet Generation**:
   ```typescript
   // Using TexturePacker or similar tools, create sprite sheets with JSON atlas
   preload() {
     this.load.atlas(
       'game-sprites',
       'assets/sprites/game-sprites.png',
       'assets/sprites/game-sprites.json'
     );
     
     // Load multiple sprite sheets for different categories to keep sizes manageable
     this.load.atlas(
       'enemies',
       'assets/sprites/enemies.png',
       'assets/sprites/enemies.json'
     );
     
     this.load.atlas(
       'environment',
       'assets/sprites/environment.png',
       'assets/sprites/environment.json'
     );
   }
   
   create() {
     // Create sprite from atlas
     const player = this.add.sprite(400, 300, 'game-sprites', 'player/idle/0001');
     
     // Create animation using frames from the atlas
     this.anims.create({
       key: 'player-run',
       frames: this.anims.generateFrameNames('game-sprites', {
         prefix: 'player/run/',
         start: 1,
         end: 8,
         zeroPad: 4
       }),
       frameRate: 12,
       repeat: -1
     });
     
     player.play('player-run');
   }
   ```

2. **Dynamic Sprite Culling**:
   ```typescript
   class CullingManager {
     private sprites: Phaser.GameObjects.Sprite[] = [];
     private scene: Phaser.Scene;
     private camera: Phaser.Cameras.Scene2D.Camera;
     private cullPadding = 100; // Pixels of padding around camera
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       this.camera = scene.cameras.main;
     }
     
     /**
      * Add a sprite to be managed for culling
      */
     add(sprite: Phaser.GameObjects.Sprite): void {
       this.sprites.push(sprite);
     }
     
     /**
      * Update visibility of all sprites
      */
     update(): void {
       // Create camera bounds with padding
       const bounds = new Phaser.Geom.Rectangle(
         this.camera.scrollX - this.cullPadding,
         this.camera.scrollY - this.cullPadding,
         this.camera.width + (this.cullPadding * 2),
         this.camera.height + (this.cullPadding * 2)
       );
       
       // Update visibility of each sprite based on camera bounds
       for (const sprite of this.sprites) {
         const spriteVisible = Phaser.Geom.Rectangle.Overlaps(
           bounds,
           new Phaser.Geom.Rectangle(
             sprite.x - (sprite.width / 2),
             sprite.y - (sprite.height / 2),
             sprite.width,
             sprite.height
           )
         );
         
         // Only update visibility if it's changing
         if (sprite.visible !== spriteVisible) {
           sprite.setVisible(spriteVisible);
         }
       }
     }
   }
   ```

3. **Sprite Depth Management**:
   ```typescript
   /**
    * Utility for managing sprite depths to minimize overdraw
    */
   class DepthManager {
     // Depth constants
     static readonly BACKGROUND = 0;
     static readonly TERRAIN = 10;
     static readonly ITEMS = 20;
     static readonly ENEMIES = 30;
     static readonly PLAYER = 40;
     static readonly EFFECTS = 50;
     static readonly UI = 100;
     
     /**
      * Set depth by category with sub-index for sorting
      * @param sprite Sprite to set depth for
      * @param category Base depth category
      * @param index Sub-index within category (0-999)
      */
     static setDepth(sprite: Phaser.GameObjects.Sprite, category: number, index = 0): void {
       // Ensure index is within range
       index = Math.min(Math.max(index, 0), 999);
       
       // Calculate final depth (category.index)
       const depth = category + (index / 1000);
       sprite.setDepth(depth);
     }
     
     /**
      * Set y-sorting within a category
      * @param sprite Sprite to set depth for
      * @param category Base depth category
      */
     static setYSorted(sprite: Phaser.GameObjects.Sprite, category: number): void {
       // Update depth on each frame based on y position
       sprite.scene.events.on('postupdate', () => {
         // Map y position to a 0-999 range based on scene height
         const height = sprite.scene.cameras.main.height;
         const normalizedY = Math.min(Math.max(sprite.y / height * 999, 0), 999);
         DepthManager.setDepth(sprite, category, normalizedY);
       });
     }
   }
