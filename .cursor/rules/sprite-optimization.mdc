/**
 * Optimized sprite factory with pooling for commonly used sprites
 */
class OptimizedSpriteFactory {
  private spritePool: Map<string, Phaser.GameObjects.Sprite[]> = new Map();
  private scene: Phaser.Scene;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  /**
   * Preload a texture atlas for sprites
   * @param key Atlas key
   * @param textureURL Path to the texture
   * @param atlasURL Path to the atlas JSON
   */
  preloadAtlas(key: string, textureURL: string, atlasURL: string): void {
    this.scene.load.atlas(key, textureURL, atlasURL);
  }
  
  /**
   * Create or reuse a sprite from the pool
   * @param x X position
   * @param y Y position
   * @param texture Texture key
   * @param frame Frame name
   * @returns The created or reused sprite
   */
  getSprite(x: number, y: number, texture: string, frame?: string): Phaser.GameObjects.Sprite {
    const key = `${texture}${frame ? ':' + frame : ''}`;
    let sprites = this.spritePool.get(key);
    
    // Create the pool if it doesn't exist
    if (!sprites) {
      sprites = [];
      this.spritePool.set(key, sprites);
    }
    
    // Get a sprite from the pool or create a new one
    let sprite: Phaser.GameObjects.Sprite;
    if (sprites.length > 0) {
      sprite = sprites.pop()!;
      sprite.setActive(true);
      sprite.setVisible(true);
      sprite.setPosition(x, y);
    } else {
      sprite = this.scene.add.sprite(x, y, texture, frame);
      
      // Set up culling bounds for automatic off-screen optimization
      sprite.setScrollFactor(1);
      this.setupAutoCulling(sprite);
    }
    
    return sprite;
  }
  
  /**
   * Return a sprite to the pool
   * @param sprite The sprite to release
   */
  releaseSprite(sprite: Phaser.GameObjects.Sprite): void {
    const key = `${sprite.texture.key}${sprite.frame.name ? ':' + sprite.frame.name : ''}`;
    let sprites = this.spritePool.get(key);
    
    if (!sprites) {
      sprites = [];
      this.spritePool.set(key, sprites);
    }
    
    // Reset and hide the sprite
    sprite.setActive(false);
    sprite.setVisible(false);
    
    // Add to pool
    sprites.push(sprite);
  }
  
  /**
   * Setup automatic culling for sprites outside the camera view
   * @param sprite The sprite to setup culling for
   */
  private setupAutoCulling(sprite: Phaser.GameObjects.Sprite): void {
    // Add 20% padding to the culling area to prevent pop-in
    const padding = 0.2;
    
    sprite.setCullCallback(() => {
      const camera = this.scene.cameras.main;
      const bounds = sprite.getBounds();
      
      // Calculate expanded camera bounds with padding
      const cameraWidth = camera.width * (1 + padding);
      const cameraHeight = camera.height * (1 + padding);
      const cameraBounds = new Phaser.Geom.Rectangle(
        camera.scrollX - (camera.width * padding / 2),
        camera.scrollY - (camera.height * padding / 2),
        cameraWidth,
        cameraHeight
      );
      
      // Only render if within the expanded camera bounds
      return Phaser.Geom.Rectangle.Overlaps(cameraBounds, bounds);
    });
  }
  
  /**
   * Clear all pooled sprites
   */
  clearPools(): void {
    this.spritePool.forEach(sprites => {
      sprites.forEach(sprite => sprite.destroy());
      sprites.length = 0;
    });
    this.spritePool.clear();
  }
}

/**
 * Optimized sprite animation manager
 */
class SpriteAnimationManager {
  private scene: Phaser.Scene;
  private animationData: Record<string, AnimationConfig> = {};
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  /**
   * Load animation data from a JSON file
   * @param key Key for the JSON file
   */
  preloadAnimations(key: string): void {
    this.scene.load.json(key, `assets/animations/${key}.json`);
  }
  
  /**
   * Create animations from loaded data
   * @param key Key of the loaded JSON file
   */
  createAnimations(key: string): void {
    const data = this.scene.cache.json.get(key);
    
    if (!data || !data.animations) {
      console.error(`Animation data for ${key} not found or invalid`);
      return;
    }
    
    // Store for later reference
    this.animationData = { ...this.animationData, ...data.animations };
    
    // Create each animation
    Object.entries(data.animations).forEach(([animKey, config]: [string, any]) => {
      // Skip if already exists
      if (this.scene.anims.exists(animKey)) {
        return;
      }
      
      this.scene.anims.create({
        key: animKey,
        frames: this.scene.anims.generateFrameNames(config.spritesheet, {
          prefix: config.prefix || '',
          start: config.startFrame,
          end: config.endFrame,
          zeroPad: config.zeroPad || 0,
          suffix: config.suffix || ''
        }),
        frameRate: config.frameRate || 24,
        repeat: config.repeat || 0
      });
    });
  }
  
  /**
   * Play an animation on a sprite with optimized settings
   * @param sprite The sprite to animate
   * @param key Animation key
   * @param ignoreIfPlaying Don't restart if already playing
   */
  playOptimized(sprite: Phaser.GameObjects.Sprite, key: string, ignoreIfPlaying = false): void {
    // Don't animate if off-screen
    const camera = this.scene.cameras.main;
    if (!this.isInCameraView(sprite, camera)) {
      // Just set to the first frame if off-screen
      const config = this.animationData[key];
      if (config) {
        sprite.setTexture(
          config.spritesheet, 
          `${config.prefix || ''}${config.startFrame}${config.suffix || ''}`
        );
      }
      return;
    }
    
    // Play the animation normally if on-screen
    sprite.play(key, ignoreIfPlaying);
  }
  
  /**
   * Check if a sprite is in the camera view
   * @param sprite The sprite to check
   * @param camera The camera to check against
   * @returns True if the sprite is in view
   */
  private isInCameraView(sprite: Phaser.GameObjects.Sprite, camera: Phaser.Cameras.Scene2D.Camera): boolean {
    const bounds = sprite.getBounds();
    const cameraBounds = new Phaser.Geom.Rectangle(
      camera.scrollX,
      camera.scrollY,
      camera.width,
      camera.height
    );
    
    return Phaser.Geom.Rectangle.Overlaps(cameraBounds, bounds);
  }
}
