## Phaser-Specific Notes

1. Set up unit tests for game logic:
   ```typescript
   // Using Jest for testing game logic
   describe('Player movement system', () => {
     let playerSystem: PlayerMovementSystem;
     let mockScene: Phaser.Scene;
     
     beforeEach(() => {
       // Mock Phaser.Scene
       mockScene = {
         physics: {
           add: {
             sprite: jest.fn().mockReturnValue({
               setVelocity: jest.fn(),
               setPosition: jest.fn()
             })
           }
         },
         input: {
           keyboard: {
             createCursorKeys: jest.fn().mockReturnValue({
               left: { isDown: false },
               right: { isDown: false },
               up: { isDown: false },
               down: { isDown: false }
             })
           }
         }
       } as unknown as Phaser.Scene;
       
       playerSystem = new PlayerMovementSystem(mockScene);
     });
     
     test('player moves left when left key is pressed', () => {
       // Arrange
       const mockPlayer = { setVelocityX: jest.fn() };
       const mockCursors = { left: { isDown: true }, right: { isDown: false } };
       
       // Act
       playerSystem.update(mockPlayer as any, mockCursors as any, 16);
       
       // Assert
       expect(mockPlayer.setVelocityX).toHaveBeenCalledWith(-200);
     });
   });
   ```

2. Create a debug mode toggle:
   ```typescript
   // In your main game file
   const config = {
     // ...other config
     physics: {
       default: 'arcade',
       arcade: {
         debug: process.env.NODE_ENV === 'development'
       }
     },
     // ...more config
   };
   
   // In any scene, add debug controls
   create() {
     if (process.env.NODE_ENV === 'development') {
       this.debugKey = this.input.keyboard.addKey('D');
       this.debugKey.on('down', () => {
         // Toggle debug mode
         this.physics.world.drawDebug = !this.physics.world.drawDebug;
         this.physics.world.debugGraphic.clear();
       });
     }
   }
   ```

