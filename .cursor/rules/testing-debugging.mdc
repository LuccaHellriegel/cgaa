// Implementing testable game components with debugging tools

// Core game module designed for testability
export class PhysicsSystem {
  private world: Phaser.Physics.Arcade.World;
  private debugMode: boolean = false;
  private debugGraphics: Phaser.GameObjects.Graphics | null = null;
  private perfMonitor: PerformanceMonitor;
  
  constructor(world: Phaser.Physics.Arcade.World, scene: Phaser.Scene) {
    this.world = world;
    this.perfMonitor = new PerformanceMonitor(scene);
  }
  
  update(time: number, delta: number): void {
    // Start performance measurement
    this.perfMonitor.start('physics-update');
    
    // Core physics update logic here
    
    // End performance measurement
    this.perfMonitor.end('physics-update');
    
    // Draw debug visuals if enabled
    if (this.debugMode && this.debugGraphics) {
      this.drawDebugVisuals();
    }
  }
  
  addCollision(
    object1: Phaser.GameObjects.GameObject | Phaser.GameObjects.GameObject[], 
    object2: Phaser.GameObjects.GameObject | Phaser.GameObjects.GameObject[],
    collideCallback?: Phaser.Types.Physics.Arcade.ArcadePhysicsCallback,
    processCallback?: Phaser.Types.Physics.Arcade.ArcadePhysicsCallback,
    callbackContext?: any
  ): Phaser.Physics.Arcade.Collider {
    // Log collision setup for debugging
    Logger.debug('Physics', `Setting up collision between ${this.getObjectInfo(object1)} and ${this.getObjectInfo(object2)}`);
    
    return this.world.collider(object1, object2, collideCallback, processCallback, callbackContext);
  }
  
  setDebugMode(enabled: boolean, graphics?: Phaser.GameObjects.Graphics): void {
    this.debugMode = enabled;
    this.debugGraphics = graphics || null;
    
    // Toggle Phaser's built-in debug rendering
    this.world.drawDebug = enabled;
    
    Logger.info('Physics', `Debug mode ${enabled ? 'enabled' : 'disabled'}`);
  }
  
  private drawDebugVisuals(): void {
    if (!this.debugGraphics) return;
    
    this.debugGraphics.clear();
    
    // Draw bounding boxes for all active physics bodies
    const bodies = this.world.bodies.getArray();
    
    bodies.forEach(body => {
      if (!body.gameObject || !body.gameObject.active) return;
      
      // Draw different colors based on body type
      if (body.immovable) {
        this.debugGraphics!.lineStyle(1, 0xffff00);
      } else if (body.velocity.length() > 0) {
        this.debugGraphics!.lineStyle(1, 0x00ff00);
      } else {
        this.debugGraphics!.lineStyle(1, 0x0000ff);
      }
      
      // Draw body outline
      this.debugGraphics!.strokeRect(
        body.x, body.y, body.width, body.height
      );
      
      // Draw velocity vector
      if (body.velocity.length() > 0) {
        this.debugGraphics!.lineStyle(1, 0xff0000);
        this.debugGraphics!.lineBetween(
          body.center.x,
          body.center.y,
          body.center.x + body.velocity.x / 10,
          body.center.y + body.velocity.y / 10
        );
      }
    });
  }
  
  private getObjectInfo(obj: any): string {
    if (Array.isArray(obj)) {
      return `Group(${obj.length})`;
    } else if (obj.type) {
      return obj.type;
    } else {
      return 'Unknown';
    }
  }
}

// Performance monitoring utility
class PerformanceMonitor {
  private scene: Phaser.Scene;
  private metrics: Map<string, PerformanceMetric> = new Map();
  private displayText: Phaser.GameObjects.Text | null = null;
  private enabled: boolean = false;
  private displayUpdateTimer: Phaser.Time.TimerEvent | null = null;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  enable(showDisplay: boolean = true): void {
    this.enabled = true;
    
    if (showDisplay) {
      this.displayText = this.scene.add.text(10, 10, '', {
        fontSize: '12px',
        color: '#ffff00',
        backgroundColor: '#000000'
      });
      this.displayText.setDepth(1000);
      this.displayText.setScrollFactor(0);
      
      // Update display every 500ms to avoid text updates every frame
      this.displayUpdateTimer = this.scene.time.addEvent({
        delay: 500,
        callback: this.updateDisplay,
        callbackScope: this,
        loop: true
      });
    }
  }
  
  disable(): void {
    this.enabled = false;
    
    if (this.displayText) {
      this.displayText.destroy();
      this.displayText = null;
    }
    
    if (this.displayUpdateTimer) {
      this.displayUpdateTimer.remove();
      this.displayUpdateTimer = null;
    }
    
    this.metrics.clear();
  }
  
  start(name: string): void {
    if (!this.enabled) return;
    
    if (!this.metrics.has(name)) {
      this.metrics.set(name, {
        current: 0,
        min: Infinity,
        max: 0,
        avg: 0,
        samples: 0,
        total: 0,
        startTime: 0
      });
    }
    
    const metric = this.metrics.get(name)!;
    metric.startTime = performance.now();
  }
  
  end(name: string): void {
    if (!this.enabled) return;
    
    const metric = this.metrics.get(name);
    if (!metric) return;
    
    const duration = performance.now() - metric.startTime;
    metric.current = duration;
    metric.min = Math.min(metric.min, duration);
    metric.max = Math.max(metric.max, duration);
    metric.total += duration;
    metric.samples++;
    metric.avg = metric.total / metric.samples;
  }
  
  private updateDisplay(): void {
    if (!this.displayText) return;
    
    let text = 'PERFORMANCE METRICS:\n';
    
    this.metrics.forEach((metric, name) => {
      text += `${name}: ${metric.current.toFixed(2)}ms (avg: ${metric.avg.toFixed(2)}ms, min: ${metric.min.toFixed(2)}ms, max: ${metric.max.toFixed(2)}ms)\n`;
    });
    
    this.displayText.setText(text);
  }
  
  getMetrics(): Map<string, PerformanceMetric> {
    return new Map(this.metrics);
  }
}

// Performance metric structure
interface PerformanceMetric {
  current: number;
  min: number;
  max: number;
  avg: number;
  samples: number;
  total: number;
  startTime: number;
}

// Logging system with levels and categories
class Logger {
  private static logLevel: LogLevel = LogLevel.INFO;
  private static logHistory: LogEntry[] = [];
  private static maxHistory: number = 1000;
  
  static setLevel(level: LogLevel): void {
    this.logLevel = level;
  }
  
  static debug(category: string, message: string, data?: any): void {
    this.log(LogLevel.DEBUG, category, message, data);
  }
  
  static info(category: string, message: string, data?: any): void {
    this.log(LogLevel.INFO, category, message, data);
  }
  
  static warning(category: string, message: string, data?: any): void {
    this.log(LogLevel.WARNING, category, message, data);
  }
  
  static error(category: string, message: string, data?: any): void {
    this.log(LogLevel.ERROR, category, message, data);
  }
  
  private static log(level: LogLevel, category: string, message: string, data?: any): void {
    if (level < this.logLevel) return;
    
    const timestamp = new Date().toISOString();
    const entry: LogEntry = {
      timestamp,
      level,
      category,
      message,
      data
    };
    
    // Add to history
    this.logHistory.push(entry);
    if (this.logHistory.length > this.maxHistory) {
      this.logHistory.shift();
    }
    
    // Format console output
    const levelString = LogLevel[level].padEnd(7);
    const logMessage = `[${timestamp}] [${levelString}] [${category}] ${message}`;
    
    // Output to console with appropriate level
    switch (level) {
      case LogLevel.DEBUG:
        console.debug(logMessage, data || '');
        break;
      case LogLevel.INFO:
        console.info(logMessage, data || '');
        break;
      case LogLevel.WARNING:
        console.warn(logMessage, data || '');
        break;
      case LogLevel.ERROR:
        console.error(logMessage, data || '');
        break;
    }
  }
  
  static getHistory(level?: LogLevel, category?: string): LogEntry[] {
    return this.logHistory.filter(entry => {
      if (level !== undefined && entry.level !== level) return false;
      if (category !== undefined && entry.category !== category) return false;
      return true;
    });
  }
  
  static clear(): void {
    this.logHistory = [];
  }
}

// Log entry and level enums
interface LogEntry {
  timestamp: string;
  level: LogLevel;
  category: string;
  message: string;
  data?: any;
}

enum LogLevel {
  DEBUG = 0,
  INFO = 1,
  WARNING = 2,
  ERROR = 3
}

// Game scene with integrated debugging tools
export class DebuggableGameScene extends Phaser.Scene {
  private physics: PhysicsSystem;
  private debugOverlay: DebugOverlay;
  private player: Phaser.Physics.Arcade.Sprite;
  
  constructor() {
    super({ key: 'GameScene' });
  }
  
  create(): void {
    // Initialize systems with dependency injection for testing
    this.physics = new PhysicsSystem(this.physics.world, this);
    this.debugOverlay = new DebugOverlay(this);
    
    // Create player and other game objects
    this.player = this.physics.add.sprite(100, 100, 'player');
    
    // Create debug controls
    this.createDebugControls();
    
    // Set up basic debug info
    Logger.info('Scene', 'Game scene created');
  }
  
  update(time: number, delta: number): void {
    // Update physics with performance monitoring
    this.physics.update(time, delta);
    
    // Update debug overlay
    this.debugOverlay.update();
  }
  
  private createDebugControls(): void {
    // Only create in development mode
    if (process.env.NODE_ENV !== 'development') return;
    
    const togglePhysicsDebug = this.add.text(10, 30, 'Toggle Physics Debug', { 
      backgroundColor: '#333',
      color: '#fff',
      padding: { x: 5, y: 5 }
    }).setInteractive();
    
    togglePhysicsDebug.on('pointerdown', () => {
      const graphics = this.add.graphics();
      this.physics.setDebugMode(!this.physics.debugMode, graphics);
    });
    
    const togglePerformance = this.add.text(10, 60, 'Toggle Performance', { 
      backgroundColor: '#333',
      color: '#fff',
      padding: { x: 5, y: 5 }
    }).setInteractive();
    
    togglePerformance.on('pointerdown', () => {
      if (this.perfMonitor.enabled) {
        this.perfMonitor.disable();
      } else {
        this.perfMonitor.enable(true);
      }
    });
  }
}

// Debug overlay for real-time game state inspection
class DebugOverlay {
  private scene: Phaser.Scene;
  private panel: Phaser.GameObjects.Container;
  private isVisible: boolean = false;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    this.panel = this.scene.add.container(0, 0);
    this.panel.setVisible(false);
    
    // Add toggle key
    this.scene.input.keyboard.on('keydown-BACKTICK', this.toggle, this);
  }
  
  toggle(): void {
    this.isVisible = !this.isVisible;
    this.panel.setVisible(this.isVisible);
    
    if (this.isVisible) {
      this.rebuildPanel();
    }
  }
  
  update(): void {
    if (this.isVisible) {
      this.rebuildPanel();
    }
  }
  
  private rebuildPanel(): void {
    // Clear existing content
    this.panel.removeAll(true);
    
    // Get current game state
    const gameState = {
      fps: this.scene.game.loop.actualFps.toFixed(1),
      objectCount: this.scene.children.length,
      memoryUsage: window.performance && window.performance.memory ? 
        (window.performance.memory.usedJSHeapSize / 1048576).toFixed(2) + ' MB' : 'N/A',
      physicsBodyCount: this.scene.physics.world.bodies.size
    };
    
    // Build panel with current state
    const bg = this.scene.add.rectangle(
      this.scene.cameras.main.width - 160,
      10,
      300,
      200,
      0x000000,
      0.7
    );
    bg.setOrigin(0, 0);
    this.panel.add(bg);
    
    let y = 20;
    Object.entries(gameState).forEach(([key, value]) => {
      const text = this.scene.add.text(
        this.scene.cameras.main.width - 150,
        y,
        `${key}: ${value}`,
        { color: '#ffffff', fontSize: '14px' }
      );
      text.setOrigin(0, 0);
      this.panel.add(text);
      y += 20;
    });
    
    // Add log panel
    const logTitle = this.scene.add.text(
      this.scene.cameras.main.width - 150,
      y + 10,
      'RECENT LOGS:',
      { color: '#ffff00', fontSize: '14px' }
    );
    logTitle.setOrigin(0, 0);
    this.panel.add(logTitle);
    
    y += 30;
    
    // Show recent logs
    const logs = Logger.getHistory(undefined, undefined).slice(-5);
    logs.forEach(log => {
      const color = log.level === LogLevel.ERROR ? '#ff0000' : 
                    log.level === LogLevel.WARNING ? '#ffaa00' : '#ffffff';
      
      const text = this.scene.add.text(
        this.scene.cameras.main.width - 150,
        y,
        `[${LogLevel[log.level]}] ${log.message}`,
        { color, fontSize: '12px', wordWrap: { width: 280 } }
      );
      text.setOrigin(0, 0);
      this.panel.add(text);
      y += text.height + 5;
    });
  }
}

