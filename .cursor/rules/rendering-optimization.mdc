# Phaser Rendering Optimization Techniques

## Context
- When working with numerous game objects on screen simultaneously
- When experiencing frame rate drops related to rendering
- When generating graphics programmatically
- When implementing particle effects or animations
- When targeting devices with limited GPU capabilities

## Requirements
- Use Phaser's WebGL rendering pipeline for maximum performance
- Batch similar rendering operations to reduce draw calls
- Implement camera culling to avoid rendering off-screen objects
- Use texture atlases and sprite sheets for efficient memory usage
- Apply appropriate alpha settings and blend modes
- Optimize or cache procedurally generated graphics
- Leverage Phaser 3.70+ rendering optimizations where available

## Examples

<example>
```typescript
// Comprehensive Phaser rendering optimization manager
export class PhaserOptimizedRenderer {
  private scene: Phaser.Scene;
  private camera: Phaser.Cameras.Scene2D.Camera;
  private renderTextures: Map<string, Phaser.GameObjects.RenderTexture> = new Map();
  private layers: Map<string, Phaser.GameObjects.Container> = new Map();
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    this.camera = scene.cameras.main;
    
    // Configure camera for culling
    this.setupCamera();
    
    // Create rendering layers with proper depth sorting
    this.setupLayers();
    
    // Configure WebGL pipeline settings if available
    this.optimizeWebGLSettings();
  }
  
  private setupCamera(): void {
    // Set reasonable cull padding to prevent pop-in
    this.camera.cullPadding = 100;
    
    // Disable camera rendering of objects outside bounds
    this.camera.disableCull = false;
    
    // Optimize camera follow for smoother scrolling
    this.camera.roundPixels = true; // Prevent pixel bleeding
  }
  
  private setupLayers(): void {
    // Create optimized render layers with appropriate depths
    this.createLayer('background', 0);
    this.createLayer('terrain', 10);
    this.createLayer('enemies', 20);
    this.createLayer('player', 30);
    this.createLayer('projectiles', 40);
    this.createLayer('ui', 100, true); // UI layer fixed to camera
  }
  
  private createLayer(name: string, depth: number, fixedToCamera: boolean = false): void {
    const container = this.scene.add.container(0, 0);
    container.setDepth(depth);
    
    if (fixedToCamera) {
      // UI elements should be fixed to camera (not affected by camera movement)
      container.setScrollFactor(0);
    }
    
    this.layers.set(name, container);
  }
  
  private optimizeWebGLSettings(): void {
    // Only apply if WebGL is available
    if (this.scene.game.renderer.type === Phaser.WEBGL) {
      // Access WebGL renderer
      const renderer = this.scene.game.renderer as Phaser.Renderer.WebGL.WebGLRenderer;
      
      // Batch sprites to minimize draw calls
      renderer.setMaxTextures(Math.min(32, renderer.getMaxTextures()));
      
      // Set texture filtering for pixel art games if needed
      renderer.pipelines.forEach((pipeline) => {
        if (pipeline.hasOwnProperty('defaultPhysicallyCorrectLights')) {
          pipeline.defaultPhysicallyCorrectLights = false; // Turn off expensive lighting
        }
      });
      
      // Get default pipeline
      const mainPipeline = renderer.pipelines.get('MultiPipeline') as Phaser.Renderer.WebGL.Pipelines.MultiPipeline;
      if (mainPipeline) {
        // Optional: Set filtering mode for pixel art
        // mainPipeline.setTextureFilteringNearestMag();
        // mainPipeline.setTextureFilteringNearestMin();
      }
    }
  }
  
  loadTextureAtlas(): void {
    // Load a texture atlas instead of individual sprites
    this.scene.load.atlas(
      'gameSprites',
      'assets/spritesheet.png',
      'assets/spritesheet.json'
    );
    
    // Set up animations from atlas when loading completes
    this.scene.load.once('complete', () => {
      this.setupAnimations();
    });
  }
  
  private setupAnimations(): void {
    // Create optimized animations using atlas frames
    this.scene.anims.create({
      key: 'player_walk',
      frames: this.scene.anims.generateFrameNames('gameSprites', {
        prefix: 'player/walk_',
        start: 0,
        end: 7,
        zeroPad: 2
      }),
      // Don't set frameRate too high for performance
      frameRate: 10,
      repeat: -1
    });
    
    // More animations...
  }
  
  addToLayer(name: string, gameObject: Phaser.GameObjects.GameObject): void {
    const layer = this.layers.get(name);
    if (layer) {
      layer.add(gameObject);
      
      // Set skipCull false to ensure proper culling
      if ('skipCull' in gameObject) {
        (gameObject as any).skipCull = false;
      }
      
      // Set appropriate alpha for layer (UI elements fully opaque)
      if (name !== 'ui' && 'alpha' in gameObject) {
        // Avoid alpha values that force Phaser to do special blending
        // Alpha of exactly 1.0 is fastest
        (gameObject as any).alpha = 1.0;
      }
    } else {
      console.warn(`Layer "${name}" does not exist`);
      this.scene.add.existing(gameObject as any);
    }
  }
  
  optimizeStaticObjects(layerName: string): void {
    // Convert static elements to a render texture for massive performance boost
    const layer = this.layers.get(layerName);
    if (layer && layer.list.length > 0) {
      // Create render texture the size of the camera
      const renderTexture = this.scene.add.renderTexture(
        0, 0, 
        this.scene.scale.width, 
        this.scene.scale.height
      );
      
      // Draw all objects in the layer to the single texture
      renderTexture.draw(layer);
      
      // Store for later reference
      this.renderTextures.set(layerName, renderTexture);
      
      // Clear the original container and add the texture
      layer.removeAll(true);
      layer.add(renderTexture);
      
      // For large worlds, consider using multiple render textures in a grid
    }
  }
  
  createAndCacheShape(key: string, drawFunction: (graphics: Phaser.GameObjects.Graphics) => void, width: number, height: number): string {
    // Don't recreate if already cached
    if (this.scene.textures.exists(key)) {
      return key;
    }
    
    // Create a reusable texture from shapes - MUCH more efficient
    const graphics = this.scene.make.graphics({});
    drawFunction(graphics);
    
    // Generate a texture that can be reused with sprites
    graphics.generateTexture(key, width, height);
    graphics.destroy();
    
    return key;
  }
  
  createCircleTexture(key: string, radius: number, fillColor: number, strokeColor?: number, strokeWidth?: number): string {
    return this.createAndCacheShape(
      key, 
      (graphics) => {
        // Fill circle
        graphics.fillStyle(fillColor);
        graphics.fillCircle(radius, radius, radius);
        
        // Optional stroke
        if (strokeColor !== undefined && strokeWidth !== undefined) {
          graphics.lineStyle(strokeWidth, strokeColor);
          graphics.strokeCircle(radius, radius, radius);
        }
      }, 
      radius * 2, 
      radius * 2
    );
  }
  
  setupCullingForGroup(group: Phaser.GameObjects.Group): void {
    // Enable automatic culling for group members
    group.getChildren().forEach((child: any) => {
      if ('skipCull' in child) {
        child.skipCull = false;
      }
    });
    
    // Add to camera culling list
    const cullList = this.camera.cullCallback ? 
      [this.camera.cullCallback] : [];
    
    // Add culling callback
    this.camera.cullCallback = (camera: Phaser.Cameras.Scene2D.Camera) => {
      // Run any existing cull callbacks
      cullList.forEach(callback => callback(camera));
      
      // Get updated group children and cull them
      const children = group.getChildren();
      for (let i = 0; i < children.length; i++) {
        const child = children[i] as any;
        if (!child.skipCull) {
          child.cull(camera);
        }
      }
    };
  }
  
  optimizeParticles(emitterConfig: Phaser.Types.GameObjects.Particles.ParticleEmitterConfig): Phaser.GameObjects.Particles.ParticleEmitter {
    // Create optimized particle system
    const particles = this.scene.add.particles('gameSprites');
    
    // Set optimized defaults to prevent performance issues
    const optimizedConfig: Phaser.Types.GameObjects.Particles.ParticleEmitterConfig = {
      ...emitterConfig,
      // Limit max particles
      maxParticles: Math.min(emitterConfig.maxParticles || 20, 50),
      // Use efficient blend mode - ADD is often much faster than SCREEN
      blendMode: emitterConfig.blendMode || Phaser.BlendModes.ADD,
      // Ensure particles have a limited lifespan
      lifespan: Math.min(emitterConfig.lifespan || 1000, 2000),
      // Set reasonable emission rate
      frequency: Math.max(emitterConfig.frequency || 100, 50),
      // Ensure alpha is 1 for best performance
      alpha: { start: 1, end: 0 },
      // Prefer single frame particles when possible
      frame: emitterConfig.frame || 'effects/particle'
    };
    
    // Create and return the emitter
    const emitter = particles.createEmitter(optimizedConfig);
    this.addToLayer('effects', particles);
    
    return emitter;
  }
  
  setBatchingForSprites(textureName: string, enabled: boolean = true): void {
    // Configure texture batching based on WebGL capabilities
    if (this.scene.game.renderer.type === Phaser.WEBGL) {
      const texture = this.scene.textures.get(textureName);
      if (texture) {
        // Enable or disable batching for this texture
        // When enabled, sprites using this texture will batch together
        texture.source.forEach(source => {
          source.glTexture.setFilter(enabled ? 0 : 1);
        });
      }
    }
  }
  
  createTilemapLayer(tilemap: Phaser.Tilemaps.Tilemap, layerIndex: number, tileset: string): Phaser.Tilemaps.TilemapLayer {
    // Create optimized tilemap layer
    const layer = tilemap.createLayer(layerIndex, tilemap.getTileset(tileset));
    
    if (layer) {
      // Set culling properties for best performance
      layer.setSkipCull(false);
      layer.setCullPadding(1, 1);
      
      // Optimize for static layers
      if (this.scene.game.renderer.type === Phaser.WEBGL) {
        // Use WebGL-specific optimizations when available
        layer.setRenderOrder(1); // Pipeline optimization
      }
    }
    
    return layer;
  }
  
  updateDynamicTextures(): void {
    // Only update dynamic textures when needed
    this.renderTextures.forEach((texture, key) => {
      if (key.startsWith('dynamic_')) {
        const sourceLayer = this.layers.get(key.replace('dynamic_', ''));
        if (sourceLayer && sourceLayer.list.length > 0) {
          texture.clear();
          texture.draw(sourceLayer);
        }
      }
    });
  }
  
  destroy(): void {
    // Clean up all created resources
    this.renderTextures.forEach(texture => texture.destroy());
    this.renderTextures.clear();
    
    // Clear camera cullbacks
    this.camera.cullCallback = null;
  }
}
```
This example demonstrates comprehensive Phaser rendering optimizations including WebGL pipeline configuration, proper texture batching, intelligent use of render textures, optimized camera settings, and efficient particle emission. The approach strategically batches similar objects, culls off-screen content, and minimizes expensive draw operations.
