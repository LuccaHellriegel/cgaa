// Inefficient Phaser rendering practices
export class UnoptimizedPhaserRenderer {
  private scene: Phaser.Scene;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    
    // Disable culling - causes everything to render
    scene.cameras.main.disableCull = true;
    
    // Create excessive depth layers
    for (let i = 0; i < 100; i++) {
      scene.add.container(0, 0).setDepth(i);
    }
  }
  
  loadAssets(): void {
    // Load many individual images instead of texture atlas
    this.scene.load.image('player', 'assets/player.png');
    this.scene.load.image('enemy1', 'assets/enemy1.png');
    this.scene.load.image('enemy2', 'assets/enemy2.png');
    this.scene.load.image('projectile', 'assets/projectile.png');
    this.scene.load.image('terrain1', 'assets/terrain1.png');
    this.scene.load.image('terrain2', 'assets/terrain2.png');
    // Dozens more individual images...
  }
  
  createEnemy(x: number, y: number): Phaser.GameObjects.Sprite {
    // Generate a new texture for every enemy - extreme performance hit
    const graphics = this.scene.add.graphics();
    graphics.fillStyle(0xff0000);
    graphics.fillCircle(0, 0, 20);
    
    // Using timestamps as texture keys - creates hundreds of unique textures
    const uniqueKey = 'enemy_' + Date.now() + '_' + Math.random();
    graphics.generateTexture(uniqueKey, 40, 40);
    graphics.destroy();
    
    // Create sprite with unique non-batchable texture
    const sprite = this.scene.add.sprite(x, y, uniqueKey);
    
    // Setting alpha to non-1.0 value forces special blending
    sprite.setAlpha(0.99);
    
    return sprite;
  }
  
  createParticles(): void {
    // Create many separate particle emitters with excessive particles
    for (let i = 0; i < 10; i++) {
      const particles = this.scene.add.particles('projectile');
      particles.createEmitter({
        x: 100 + i * 50,
        y: 100 + i * 30,
        speed: 200,
        maxParticles: 500, // Excessive particles
        scale: { start: 1, end: 0 },
        blendMode: Phaser.BlendModes.SCREEN, // Expensive blend mode
        lifespan: 8000, // Long-lived particles
        frequency: 5, // Very frequent emission
        alpha: { start: 0.8, end: 0.2 } // Non-optimal alpha values
      });
    }
  }
  
  createTilemap(): void {
    // Create inefficient tilemap
    const map = this.scene.make.tilemap({ key: 'level' });
    
    // Use multiple tilesets instead of one
    const tileset1 = map.addTilesetImage('ground', 'terrain1');
    const tileset2 = map.addTilesetImage('objects', 'terrain2');
    
    // Create layers with mixed tilesets
    const groundLayer = map.createLayer(0, tileset1);
    const objectLayer = map.createLayer(1, tileset2);
    
    // Disable culling on the layers
    groundLayer.skipCull = true;
    objectLayer.skipCull = true;
  }
  
  // Create new graphics objects every frame
  update(time: number, delta: number): void {
    // Create transient graphics objects - extreme performance hit
    for (let i = 0; i < 20; i++) {
      const graphics = this.scene.add.graphics();
      graphics.fillStyle(0xffffff * Math.random());
      graphics.fillRect(
        Math.random() * this.scene.scale.width, 
        Math.random() * this.scene.scale.height, 
        20, 
        20
      );
      
      // Destroy later - causes constant garbage collection
      this.scene.time.delayedCall(100, () => {
        graphics.destroy();
      });
    }
    
    // Inefficient visibility checks
    this.scene.children.each((gameObject: any) => {
      if (gameObject instanceof Phaser.GameObjects.Sprite) {
        // Manual visibility computation instead of using Phaser's culling
        const bounds = gameObject.getBounds();
        const camera = this.scene.cameras.main;
        gameObject.visible = (
          bounds.right >= camera.scrollX &&
          bounds.left <= camera.scrollX + camera.width &&
          bounds.bottom >= camera.scrollY &&
          bounds.top <= camera.scrollY + camera.height
        );
        
        // Apply tint every frame - causes rebatching
        gameObject.setTint(0xffffff);
      }
      return true;
    });
  }
}
```
This example demonstrates serious Phaser rendering anti-patterns: creating unique textures during gameplay, disabling culling, using excessive particle counts with expensive blend modes, setting non-optimal alpha values, creating and destroying graphics objects every frame, and performing manual visibility checks instead of using Phaser's built-in culling.
