# Optimize Rendering for Performance

## Context
- When working with numerous game objects on screen simultaneously
- When experiencing frame rate drops related to rendering
- When generating graphics programmatically
- When implementing particle effects or animations
- When targeting devices with limited GPU capabilities

## Requirements
- Use Phaser's built-in rendering optimization techniques
- Batch similar rendering operations to reduce draw calls
- Implement culling to avoid rendering off-screen objects
- Properly manage textures and sprite sheets
- Use appropriate rendering techniques for the visual style
- Optimize programmatically generated graphics

## Examples

<example>
```typescript
// Optimized rendering manager utilizing Phaser's techniques
export class OptimizedRenderer {
  private scene: Phaser.Scene;
  private camera: Phaser.Cameras.Scene2D.Camera;
  private entities: Phaser.GameObjects.Group;
  private layers: Map<string, Phaser.GameObjects.Container> = new Map();
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    this.camera = scene.cameras.main;
    
    // Group for entities with automatic culling
    this.entities = scene.add.group();
    
    // Create rendering layers
    this.setupLayers();
  }
  
  private setupLayers(): void {
    // Create layers with appropriate depths
    this.createLayer('background', 0);
    this.createLayer('terrain', 10);
    this.createLayer('enemies', 20);
    this.createLayer('player', 30);
    this.createLayer('projectiles', 40);
    this.createLayer('ui', 100);
  }
  
  private createLayer(name: string, depth: number): void {
    const container = this.scene.add.container(0, 0);
    container.setDepth(depth);
    this.layers.set(name, container);
  }
  
  loadTextureAtlas(): void {
    // Load a texture atlas instead of individual sprites
    this.scene.load.atlas(
      'gameSprites',
      'assets/spritesheet.png',
      'assets/spritesheet.json'
    );
    
    // Set up animations from atlas
    this.scene.load.once('complete', () => {
      this.setupAnimations();
    });
  }
  
  private setupAnimations(): void {
    // Create animations using the atlas frames
    this.scene.anims.create({
      key: 'player_walk',
      frames: this.scene.anims.generateFrameNames('gameSprites', {
        prefix: 'player/walk_',
        start: 0,
        end: 7,
        zeroPad: 2
      }),
      frameRate: 10,
      repeat: -1
    });
    
    // More animations...
  }
  
  addToLayer(name: string, gameObject: Phaser.GameObjects.GameObject): void {
    const layer = this.layers.get(name);
    if (layer) {
      layer.add(gameObject);
    } else {
      console.warn(`Layer "${name}" does not exist`);
      this.scene.add.existing(gameObject as any);
    }
  }
  
  optimizeStaticObjects(): void {
    // Convert static elements to static compound body
    const terrain = this.layers.get('terrain');
    if (terrain) {
      // Convert to a static texture for better performance
      const renderTexture = this.scene.add.renderTexture(0, 0, this.scene.scale.width, this.scene.scale.height);
      renderTexture.draw(terrain);
      
      // Clear the container and add the texture
      terrain.removeAll(true);
      terrain.add(renderTexture);
    }
  }
  
  createShapeTexture(key: string, drawFunction: (graphics: Phaser.GameObjects.Graphics) => void): string {
    // Create a reusable texture from shapes
    const graphics = this.scene.make.graphics({});
    drawFunction(graphics);
    
    // Generate a texture that can be reused with sprites
    graphics.generateTexture(key, graphics.width, graphics.height);
    graphics.destroy();
    
    return key;
  }
  
  createCircleTexture(key: string, radius: number, fillColor: number): string {
    return this.createShapeTexture(key, (graphics) => {
      graphics.fillStyle(fillColor);
      graphics.fillCircle(radius, radius, radius);
      graphics.lineStyle(2, 0x000000);
      graphics.strokeCircle(radius, radius, radius);
    });
  }
  
  setupCulling(): void {
    // Set up automatic culling for entities
    this.scene.cameras.main.culledObjects = this.entities.getChildren();
    
    // Enable cull padding to prevent pop-in
    this.scene.cameras.main.cullPadding = 100;
  }
  
  optimizeParticles(emitterConfig: Phaser.Types.GameObjects.Particles.ParticleEmitterConfig): Phaser.GameObjects.Particles.ParticleEmitter {
    // Create optimized particle system
    const particles = this.scene.add.particles('gameSprites', 'effects/particle');
    
    // Set optimized defaults
    const optimizedConfig: Phaser.Types.GameObjects.Particles.ParticleEmitterConfig = {
      ...emitterConfig,
      // Limit max particles
      maxParticles: emitterConfig.maxParticles || 20,
      // Use efficient blend mode
      blendMode: emitterConfig.blendMode || Phaser.BlendModes.ADD,
      // Ensure particles have a limited lifespan
      lifespan: emitterConfig.lifespan || 1000
    };
    
    // Create and return the emitter
    const emitter = particles.createEmitter(optimizedConfig);
    this.addToLayer('effects', particles);
    
    return emitter;
  }
}
```
This example implements several Phaser-specific rendering optimizations: texture atlases for batch rendering, layers with appropriate depths, static texture conversion for unchanging elements, cached shape textures, and optimized particle systems with reasonable defaults.
</example>

<example type="invalid">
```typescript
// Inefficient rendering practices
export class UnoptimizedRenderer {
  private scene: Phaser.Scene;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  loadAssets(): void {
    // Load many individual images instead of texture atlas
    this.scene.load.image('player', 'assets/player.png');
    this.scene.load.image('enemy1', 'assets/enemy1.png');
    this.scene.load.image('enemy2', 'assets/enemy2.png');
    this.scene.load.image('projectile', 'assets/projectile.png');
    this.scene.load.image('terrain1', 'assets/terrain1.png');
    this.scene.load.image('terrain2', 'assets/terrain2.png');
    // Dozens more individual images...
  }
  
  createEnemy(x: number, y: number): Phaser.GameObjects.Sprite {
    // Create a new Graphics object for EVERY enemy
    const graphics = this.scene.add.graphics();
    graphics.fillStyle(0xff0000);
    graphics.fillCircle(0, 0, 20);
    graphics.generateTexture('enemy_runtime_' + Date.now(), 40, 40); // Unique key per enemy
    graphics.destroy();
    
    // Create sprite with the just-generated unique texture
    return this.scene.add.sprite(x, y, 'enemy_runtime_' + Date.now());
  }
  
  createParticles(): void {
    // Create separate particle emitters with excessive particles
    for (let i = 0; i < 10; i++) {
      const particles = this.scene.add.particles('projectile');
      particles.createEmitter({
        x: 100 + i * 50,
        y: 100 + i * 30,
        speed: 200,
        maxParticles: 300, // Excessive particles
        scale: { start: 1, end: 0 },
        blendMode: Phaser.BlendModes.SCREEN, // Expensive blend mode
        lifespan: 5000, // Long-lived particles
        frequency: 10 // Frequent emission
      });
    }
  }
  
  update(): void {
    // Inefficient update with no culling
    const allObjects = this.scene.children.list;
    
    allObjects.forEach(object => {
      // Update all objects regardless of visibility
      if (object instanceof Phaser.GameObjects.Sprite) {
        object.rotation += 0.01;
        
        // Manual visibility check without using Phaser's culling
        const bounds = object.getBounds();
        const camera = this.scene.cameras.main;
        object.visible = (
          bounds.right >= camera.scrollX &&
          bounds.left <= camera.scrollX + camera.width &&
          bounds.bottom >= camera.scrollY &&
          bounds.top <= camera.scrollY + camera.height
        );
      }
    });
  }
}
```
This approach creates performance issues through multiple inefficient practices: loading many individual textures instead of atlases, generating new textures during gameplay, excessive particle counts with expensive blend modes, and inefficient object updates without proper culling.
</example>

## Phaser-Specific Notes

1. Use Phaser's texture atlases and sprite sheets:
   ```typescript
   // In your preloader scene
   this.load.atlas('spritesheet', 'assets/spritesheet.png', 'assets/spritesheet.json');
   
   // Create sprites from atlas
   const sprite = this.add.sprite(x, y, 'spritesheet', 'player_idle');
   
   // Create animations
   this.anims.create({
     key: 'walk',
     frames: this.anims.generateFrameNames('spritesheet', {
       prefix: 'player_walk_',
       start: 1,
       end: 8
     }),
     frameRate: 10,
     repeat: -1
   });
   ```

2. For programmatic graphics, generate textures once and reuse:
   ```typescript
   // Generate textures at startup
   createTextures() {
     const shapes = ['circle', 'square', 'triangle'];
     const colors = [0xff0000, 0x00ff00, 0x0000ff];
     
     // Generate all combinations
     shapes.forEach(shape => {
       colors.forEach(color => {
         const key = `${shape}_${color.toString(16)}`;
         this.createShapeTexture(key, shape, color);
       });
     });
   }
   ```

3. Optimize render depth management with Phaser:
   ```typescript
   // Use setDepth for simple depth management
   background.setDepth(0);
   terrain.setDepth(10);
   enemies.setDepth(20);
   player.setDepth(30);
   
   // For more complex scenes, use layer containers
   const uiLayer = this.add.container(0, 0).setDepth(100);
   uiLayer.add([healthBar, scoreText, menuButton]);
   ```

4. Use Phaser's built-in camera culling:
   ```typescript
   // Enable culling (on by default in Phaser 3)
   this.cameras.main.useCulling = true;
   
   // Set cull padding to prevent pop-in
   this.cameras.main.cullPadding = 100;
   ```

5. Use Phaser's built-in pooling for visual effects:
   ```typescript
   // Create a particle manager once
   const particles = this.add.particles('flare');
   
   // Create emitter configurations
   const explosionEmitter = particles.createEmitter({
     frame: 'red',
     speed: { min: 100, max: 200 },
     angle: { min: 0, max: 360 },
     scale: { start: 0.5, end: 0 },
     blendMode: 'ADD',
     lifespan: 800,
     gravityY: 0,
     active: false, // Start inactive
     maxParticles: 20
   });
   
   // Activate emitter at specific positions when needed
   function createExplosion(x, y) {
     explosionEmitter.setPosition(x, y);
     explosionEmitter.explode(20); // Emit 20 particles
   }
   