// BAD: Creating and destroying objects continuously
class BulletManager {
  private scene: Phaser.Scene;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  // Creates a new bullet every time
  fireBullet(x: number, y: number, velocity: Phaser.Math.Vector2): void {
    // Creating new objects for each bullet instead of reusing
    const bullet = this.scene.add.sprite(x, y, 'bullet');
    
    // Adding physics to each bullet
    this.scene.physics.add.existing(bullet);
    const body = bullet.body as Phaser.Physics.Arcade.Body;
    
    // Setting velocity
    body.setVelocity(velocity.x, velocity.y);
    
    // Destroy after 2 seconds or on leaving screen
    this.scene.time.delayedCall(2000, () => {
      bullet.destroy();
    });
  }
  
  // Creates many bullets at once, causing GC spikes
  fireSpread(x: number, y: number, count: number): void {
    for (let i = 0; i < count; i++) {
      const angle = (i / count) * Math.PI * 2;
      const vx = Math.cos(angle) * 200;
      const vy = Math.sin(angle) * 200;
      
      this.fireBullet(x, y, new Phaser.Math.Vector2(vx, vy));
    }
  }
}
