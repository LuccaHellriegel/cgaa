## Object Pooling Implementations

1. **Sprite Pooling**:
   ```typescript
   /**
    * Pool for reusing Phaser sprites
    */
   class SpritePool {
     private scene: Phaser.Scene;
     private pools: Map<string, Phaser.GameObjects.Sprite[]> = new Map();
     private activeSprites: Set<Phaser.GameObjects.Sprite> = new Set();
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
     }
     
     /**
      * Get a sprite from the pool or create a new one
      */
     get(texture: string, frame?: string): Phaser.GameObjects.Sprite {
       const key = `${texture}:${frame || ''}`;
       
       if (!this.pools.has(key)) {
         this.pools.set(key, []);
       }
       
       const pool = this.pools.get(key);
       let sprite: Phaser.GameObjects.Sprite;
       
       if (pool.length > 0) {
         sprite = pool.pop();
         sprite.setActive(true);
         sprite.setVisible(true);
       } else {
         sprite = this.scene.add.sprite(0, 0, texture, frame);
       }
       
       this.activeSprites.add(sprite);
       return sprite;
     }
     
     /**
      * Release a sprite back to the pool
      */
     release(sprite: Phaser.GameObjects.Sprite): void {
       if (this.activeSprites.has(sprite)) {
         this.activeSprites.delete(sprite);
         
         // Reset sprite properties
         sprite.setActive(false);
         sprite.setVisible(false);
         sprite.setPosition(0, 0);
         sprite.setRotation(0);
         sprite.setScale(1, 1);
         sprite.setAlpha(1);
         sprite.setTint(0xffffff);
         
         // Add to pool
         const key = `${sprite.texture.key}:${sprite.frame.name || ''}`;
         if (!this.pools.has(key)) {
           this.pools.set(key, []);
         }
         this.pools.get(key).push(sprite);
       }
     }
     
     /**
      * Clear all pools and destroy sprites
      */
     clear(): void {
       // Destroy all active sprites
       this.activeSprites.forEach(sprite => {
         sprite.destroy();
       });
       this.activeSprites.clear();
       
       // Destroy all pooled sprites
       this.pools.forEach(pool => {
         pool.forEach(sprite => {
           sprite.destroy();
         });
         pool.length = 0;
       });
       
       this.pools.clear();
     }
   }
   ```

2. **Particle Pooling**:
   ```typescript
   /**
    * Particle manager with object pooling
    */
   class ParticleManager {
     private scene: Phaser.Scene;
     private particlePool: ObjectPool<Phaser.GameObjects.Sprite>;
     private activeParticles: Phaser.GameObjects.Sprite[] = [];
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       
       // Create pool with factory, reset and dispose functions
       this.particlePool = new ObjectPool<Phaser.GameObjects.Sprite>(
         // Factory function to create new particles
         () => {
           const particle = scene.add.sprite(0, 0, 'particle');
           particle.setActive(false);
           particle.setVisible(false);
           return particle;
         },
         // Reset function to prepare particle for reuse
         (particle) => {
           particle.setActive(false);
           particle.setVisible(false);
           particle.setPosition(0, 0);
           particle.setScale(1, 1);
           particle.setAlpha(1);
           particle.setAngle(0);
           particle.setTint(0xffffff);
         },
         // Dispose function for when particles are removed from pool
         (particle) => {
           particle.destroy();
         },
         // Pre-allocate 100 particles
         100,
         // Maximum pool size of 500
         500
       );
       
       // Update active particles each frame
       scene.events.on('update', this.updateParticles, this);
     }
     
     /**
      * Create a particle effect
      */
     createEffect(
       x: number, 
       y: number, 
       count: number,
       config: {
         speed?: number,
         scale?: number,
         alpha?: number,
         lifespan?: number,
         tint?: number
       } = {}
     ): void {
       const speed = config.speed || 100;
       const scale = config.scale || 1;
       const alpha = config.alpha || 1;
       const lifespan = config.lifespan || 1000;
       const tint = config.tint || 0xffffff;
       
       for (let i = 0; i < count; i++) {
         // Get particle from pool
         const particle = this.particlePool.get();
         
         // Configure particle
         particle.setPosition(x, y);
         particle.setActive(true);
         particle.setVisible(true);
         particle.setScale(scale);
         particle.setAlpha(alpha);
         particle.setTint(tint);
         
         // Set random velocity
         const angle = Math.random() * Math.PI * 2;
         const velocity = {
           x: Math.cos(angle) * speed * (0.5 + Math.random()),
           y: Math.sin(angle) * speed * (0.5 + Math.random())
         };
         
         // Store velocity and lifespan on particle
         (particle as any).velocity = velocity;
         (particle as any).remainingLife = lifespan;
         
         // Add to active list
         this.activeParticles.push(particle);
       }
     }
     
     /**
      * Update all active particles
      */
     private updateParticles(time: number, delta: number): void {
       for (let i = this.activeParticles.length - 1; i >= 0; i--) {
         const particle = this.activeParticles[i];
         
         // Update position based on velocity
         particle.x += (particle as any).velocity.x * (delta / 1000);
         particle.y += (particle as any).velocity.y * (delta / 1000);
         
         // Update lifespan
         (particle as any).remainingLife -= delta;
         
         // Fade out near end of life
         const lifeRatio = Math.max(0, (particle as any).remainingLife / 1000);
         if (lifeRatio < 0.3) {
           particle.setAlpha(lifeRatio / 0.3);
         }
         
         // Check if particle should be retired
         if ((particle as any).remainingLife <= 0) {
           // Return to pool
           this.particlePool.release(particle);
           
           // Remove from active list
           this.activeParticles.splice(i, 1);
         }
       }
     }
     
     /**
      * Clean up resources
      */
     destroy(): void {
       // Release all active particles
       this.activeParticles.forEach(particle => {
         this.particlePool.release(particle);
       });
       this.activeParticles = [];
       
       // Clear the pool
       this.particlePool.clear();
       
       // Remove update listener
       this.scene.events.off('update', this.updateParticles, this);
     }
   }
