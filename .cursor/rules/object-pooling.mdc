# Object Pooling

## Context
- When developing games with frequently created and destroyed objects
- When targeting mobile or memory-constrained platforms
- When experiencing performance spikes due to garbage collection
- When working with particle systems, projectiles, or other short-lived objects

## Requirements
- Create reusable pools for frequently instantiated game objects
- Implement proper object reset and reuse mechanisms
- Apply pool growth and shrinking strategies based on demand
- Track object usage to optimize pool size
- Dispose of pooled objects when no longer needed

## Examples

<example>
```typescript
/**
 * Generic object pool for reusing game objects
 * @template T The type of object to pool
 */
class ObjectPool<T> {
  private available: T[] = [];
  private inUse: Set<T> = new Set();
  private factory: () => T;
  private reset: (obj: T) => void;
  private dispose: (obj: T) => void;
  private maxSize: number;
  
  /**
   * Create a new object pool
   * @param factory Function to create new objects
   * @param reset Function to reset objects before reuse
   * @param dispose Function to dispose objects when pool is destroyed
   * @param initialSize Number of objects to pre-allocate
   * @param maxSize Maximum pool size (0 for unlimited)
   */
  constructor(
    factory: () => T,
    reset: (obj: T) => void,
    dispose: (obj: T) => void,
    initialSize = 0,
    maxSize = 0
  ) {
    this.factory = factory;
    this.reset = reset;
    this.dispose = dispose;
    this.maxSize = maxSize;
    
    // Pre-allocate initial objects
    this.preAllocate(initialSize);
  }
  
  /**
   * Pre-allocate objects to the pool
   * @param count Number of objects to allocate
   */
  preAllocate(count: number): void {
    for (let i = 0; i < count; i++) {
      this.available.push(this.factory());
    }
  }
  
  /**
   * Get an object from the pool
   * @returns A pooled object
   */
  get(): T {
    let obj: T;
    
    if (this.available.length > 0) {
      obj = this.available.pop();
    } else {
      obj = this.factory();
    }
    
    this.inUse.add(obj);
    return obj;
  }
  
  /**
   * Return an object to the pool
   * @param obj The object to return
   */
  release(obj: T): void {
    if (this.inUse.has(obj)) {
      this.inUse.delete(obj);
      
      // Reset object state
      this.reset(obj);
      
      // Add to available pool if under size limit
      if (this.maxSize === 0 || this.available.length < this.maxSize) {
        this.available.push(obj);
      } else {
        // Dispose if over size limit
        this.dispose(obj);
      }
    }
  }
  
  /**
   * Release all objects currently in use
   */
  releaseAll(): void {
    this.inUse.forEach(obj => this.release(obj));
  }
  
  /**
   * Get count of available objects
   */
  get availableCount(): number {
    return this.available.length;
  }
  
  /**
   * Get count of in-use objects
   */
  get inUseCount(): number {
    return this.inUse.size;
  }
  
  /**
   * Clear the pool and dispose all objects
   */
  clear(): void {
    // Dispose all objects
    this.available.forEach(obj => this.dispose(obj));
    this.inUse.forEach(obj => this.dispose(obj));
    
    // Clear collections
    this.available = [];
    this.inUse.clear();
  }
}
```
</example>

