# Resource Cleanup

## Context
- When scene transitions occur
- When game objects are destroyed
- When releasing event listeners or callbacks
- When managing WebGL resources
- When implementing component lifecycle methods

## Requirements
- Implement proper destroy methods that release all resources
- Remove event listeners when components are destroyed
- Clear cached data when no longer needed
- Cancel scheduled tasks and timers on cleanup
- Release WebGL resources (textures, shaders, buffers)

## Examples

<example>
```typescript
/**
 * Scene with proper resource cleanup
 */
class GameScene extends Phaser.Scene {
  private enemies: Enemy[] = [];
  private particles: Phaser.GameObjects.Particles.ParticleEmitterManager;
  private worldMap: WorldMap;
  private uiLayer: UILayer;
  private musicTrack: Phaser.Sound.BaseSound;
  private globalListeners: { event: string, callback: Function }[] = [];
  
  create() {
    // Create game resources
    this.particles = this.add.particles('particle-texture');
    this.worldMap = new WorldMap(this);
    this.uiLayer = new UILayer(this);
    this.musicTrack = this.sound.add('background-music');
    this.musicTrack.play({ loop: true });
    
    // Add global event listeners with tracking
    const resizeHandler = () => this.handleResize();
    window.addEventListener('resize', resizeHandler);
    this.globalListeners.push({
      event: 'resize',
      callback: resizeHandler
    });
    
    // Set up scene events
    this.events.on('pause', this.handlePause, this);
    this.events.once('shutdown', this.cleanupResources, this);
  }
  
  /**
   * Create an enemy with proper cleanup tracking
   */
  spawnEnemy(x: number, y: number): Enemy {
    const enemy = new Enemy(this, x, y);
    this.enemies.push(enemy);
    return enemy;
  }
  
  /**
   * Remove enemy and its resources
   */
  removeEnemy(enemy: Enemy): void {
    const index = this.enemies.indexOf(enemy);
    if (index >= 0) {
      // Call destroy to release the enemy's resources
      enemy.destroy();
      this.enemies.splice(index, 1);
    }
  }
  
  /**
   * Comprehensive resource cleanup
   */
  cleanupResources(): void {
    console.log('Cleaning up scene resources');
    
    // Clean up enemies
    this.enemies.forEach(enemy => enemy.destroy());
    this.enemies = [];
    
    // Clean up particles
    if (this.particles) {
      this.particles.destroy();
      this.particles = null;
    }
    
    // Clean up map
    if (this.worldMap) {
      this.worldMap.destroy();
      this.worldMap = null;
    }
    
    // Clean up UI
    if (this.uiLayer) {
      this.uiLayer.destroy();
      this.uiLayer = null;
    }
    
    // Stop and release audio
    if (this.musicTrack) {
      this.musicTrack.stop();
      this.musicTrack = null;
    }
    
    // Remove global event listeners
    this.globalListeners.forEach(({ event, callback }) => {
      window.removeEventListener(event, callback as EventListener);
    });
    this.globalListeners = [];
    
    // Clean up scene events
    this.events.off('pause', this.handlePause, this);
    
    // Clear any timers
    this.time.removeAllEvents();
    
    // Clear tweens
    this.tweens.killAll();
    
    console.log('Scene cleanup complete');
  }
  
  /**
   * Automatically called by Phaser on scene shutdown
   */
  shutdown() {
    // Already handled by cleanupResources event
    // but can be used as a fallback
    if (this.enemies && this.enemies.length > 0) {
      console.warn('Resources were not properly cleaned up before shutdown');
      this.cleanupResources();
    }
  }
}

/**
 * Game entity with proper resource management
 */
class Enemy extends Phaser.GameObjects.Container {
  private healthBar: Phaser.GameObjects.Graphics;
  private sprite: Phaser.GameObjects.Sprite;
  private emitter: Phaser.GameObjects.Particles.ParticleEmitter;
  private updateListener: Function;
  private timers: Phaser.Time.TimerEvent[] = [];
  
  constructor(scene: Phaser.Scene, x: number, y: number) {
    super(scene, x, y);
    scene.add.existing(this);
    
    // Create components
    this.sprite = scene.add.sprite(0, 0, 'enemy');
    this.add(this.sprite);
    
    this.healthBar = scene.add.graphics();
    this.drawHealthBar(100);
    this.add(this.healthBar);
    
    // Create particle effect
    const particles = scene.add.particles('particle');
    this.emitter = particles.createEmitter({
      speed: 20,
      scale: { start: 1, end: 0 },
      blendMode: 'ADD'
    });
    this.emitter.startFollow(this);
    
    // Add update listener
    this.updateListener = () => this.update();
    scene.events.on('update', this.updateListener);
    
    // Create periodic effect with timer
    this.timers.push(
      scene.time.addEvent({
        delay: 2000,
        callback: this.playEffect,
        callbackScope: this,
        loop: true
      })
    );
  }
  
  /**
   * Draw the health bar
   */
  private drawHealthBar(health: number): void {
    this.healthBar.clear();
    this.healthBar.fillStyle(0x00ff00, 1);
    this.healthBar.fillRect(-30, -40, health / 100 * 60, 8);
    this.healthBar.lineStyle(2, 0xffffff, 1);
    this.healthBar.strokeRect(-30, -40, 60, 8);
  }
  
  /**
   * Play a special effect
   */
  private playEffect(): void {
    if (!this.active) return;
    
    // Create temporary effect
    const effect = this.scene.add.sprite(this.x, this.y, 'effect');
    effect.play('effect-animation');
    effect.once('animationcomplete', () => {
      effect.destroy();
    });
  }
  
  /**
   * Update logic
   */
  update(): void {
    // Do something every frame
    if (!this.active) return;
    
    // Animation logic here
  }
  
  /**
   * Comprehensive resource cleanup
   */
  destroy(): void {
    if (!this.scene) return; // Already destroyed
    
    // Stop timers
    this.timers.forEach(timer => timer.destroy());
    this.timers = [];
    
    // Remove update listener
    this.scene.events.off('update', this.updateListener);
    
    // Stop particle emitter
    if (this.emitter) {
      this.emitter.stop();
      this.emitter.manager.destroy();
    }
    
    // Call super.destroy() to remove from scene
    super.destroy();
  }
}
