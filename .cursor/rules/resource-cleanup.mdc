## Cleanup Patterns

1. **Lifecycle Hooks Pattern**:
   ```typescript
   /**
    * Base class with lifecycle hooks for proper cleanup
    */
   abstract class GameComponent {
     protected scene: Phaser.Scene;
     protected eventListeners: { target: any, event: string, callback: Function }[] = [];
     protected timers: Phaser.Time.TimerEvent[] = [];
     protected tweens: Phaser.Tweens.Tween[] = [];
     protected isDestroyed = false;
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       
       // Auto-register for scene shutdown
       this.scene.events.once('shutdown', this.onSceneShutdown, this);
     }
     
     /**
      * Listen to an event with automatic cleanup tracking
      */
     protected listenTo(target: any, event: string, callback: Function, context?: any): void {
       target.on(event, callback, context || this);
       this.eventListeners.push({ target, event, callback });
     }
     
     /**
      * Create a timer with automatic cleanup tracking
      */
     protected createTimer(config: Phaser.Types.Time.TimerEventConfig): Phaser.Time.TimerEvent {
       const timer = this.scene.time.addEvent(config);
       this.timers.push(timer);
       return timer;
     }
     
     /**
      * Create a tween with automatic cleanup tracking
      */
     protected createTween(config: Phaser.Types.Tweens.TweenBuilderConfig): Phaser.Tweens.Tween {
       const tween = this.scene.tweens.add(config);
       this.tweens.push(tween);
       return tween;
     }
     
     /**
      * Called when the component is about to be destroyed
      * Override in subclasses to add custom cleanup
      */
     protected onDestroy(): void {}
     
     /**
      * Called when the scene is shutting down
      */
     private onSceneShutdown(): void {
       this.destroy();
     }
     
     /**
      * Clean up all resources
      */
     public destroy(): void {
       if (this.isDestroyed) return;
       
       // Call subclass cleanup first
       this.onDestroy();
       
       // Clean up event listeners
       this.eventListeners.forEach(({ target, event, callback }) => {
         target.off(event, callback, this);
       });
       this.eventListeners = [];
       
       // Clean up timers
       this.timers.forEach(timer => timer.destroy());
       this.timers = [];
       
       // Clean up tweens
       this.tweens.forEach(tween => tween.stop());
       this.tweens = [];
       
       // Remove scene shutdown listener
       if (this.scene) {
         this.scene.events.off('shutdown', this.onSceneShutdown, this);
       }
       
       this.isDestroyed = true;
     }
   }
   ```

2. **Resource Registry Pattern**:
   ```typescript
   /**
    * Registry for tracking resources that need cleanup
    */
   class ResourceRegistry {
     private resources: Map<string, any[]> = new Map();
     private cleanupHandlers: Map<string, (resource: any) => void> = new Map();
     
     /**
      * Register a cleanup handler for a resource type
      */
     registerCleanupHandler(type: string, handler: (resource: any) => void): void {
       this.cleanupHandlers.set(type, handler);
     }
     
     /**
      * Track a resource for later cleanup
      */
     track<T>(type: string, resource: T): T {
       if (!this.resources.has(type)) {
         this.resources.set(type, []);
       }
       
       this.resources.get(type).push(resource);
       return resource;
     }
     
     /**
      * Release a specific resource
      */
     release(type: string, resource: any): boolean {
       if (!this.resources.has(type)) {
         return false;
       }
       
       const resources = this.resources.get(type);
       const index = resources.indexOf(resource);
       
       if (index === -1) {
         return false;
       }
       
       // Call cleanup handler if registered
       const handler = this.cleanupHandlers.get(type);
       if (handler) {
         handler(resource);
       }
       
       // Remove from tracked list
       resources.splice(index, 1);
       return true;
     }
     
     /**
      * Clean up all resources of a specific type
      */
     cleanupByType(type: string): void {
       if (!this.resources.has(type)) {
         return;
       }
       
       const resources = this.resources.get(type);
       const handler = this.cleanupHandlers.get(type);
       
       if (handler) {
         resources.forEach(resource => handler(resource));
       }
       
       this.resources.set(type, []);
     }
     
     /**
      * Clean up all tracked resources
      */
     cleanupAll(): void {
       for (const type of this.resources.keys()) {
         this.cleanupByType(type);
       }
     }
   }

   /**
    * Example usage in a scene
    */
   class GameScene extends Phaser.Scene {
     private registry = new ResourceRegistry();
     
     constructor() {
       super({ key: 'GameScene' });
       
       // Register cleanup handlers
       this.registry.registerCleanupHandler('sprite', sprite => sprite.destroy());
       this.registry.registerCleanupHandler('timer', timer => timer.destroy());
       this.registry.registerCleanupHandler('tween', tween => tween.stop());
       this.registry.registerCleanupHandler('sound', sound => sound.stop());
     }
     
     create() {
       // Track sprites for cleanup
       const player = this.registry.track('sprite', 
         this.add.sprite(400, 300, 'player')
       );
       
       // Track timers
       const timer = this.registry.track('timer',
         this.time.addEvent({
           delay: 1000,
           loop: true,
           callback: this.spawnEnemy,
           callbackScope: this
         })
       );
       
       // Track sounds
       const music = this.registry.track('sound',
         this.sound.add('music')
       );
       music.play();
       
       // Auto cleanup on shutdown
       this.events.once('shutdown', () => {
         this.registry.cleanupAll();
       });
     }
     
     spawnEnemy() {
       // Automatically tracked for cleanup
       const enemy = this.registry.track('sprite',
         this.add.sprite(Math.random() * 800, 0, 'enemy')
       );
       
       // Track the tween for cleanup
       this.registry.track('tween',
         this.tweens.add({
           targets: enemy,
           y: 600,
           duration: 2000
         })
       );
     }
   }
   ```

3. **Disposable Pattern**:
   ```typescript
   /**
    * Interface for resources that need cleanup
    */
   interface Disposable {
     dispose(): void;
   }

   /**
    * A class that manages disposable resources
    */
   class DisposableManager implements Disposable {
     private disposables: Disposable[] = [];
     
     /**
      * Add a disposable resource to manage
      */
     add<T extends Disposable>(disposable: T): T {
       this.disposables.push(disposable);
       return disposable;
     }
     
     /**
      * Remove a disposable from management
      */
     remove(disposable: Disposable): boolean {
       const index = this.disposables.indexOf(disposable);
       if (index !== -1) {
         this.disposables.splice(index, 1);
         return true;
       }
       return false;
     }
     
     /**
      * Dispose of all managed resources
      */
     dispose(): void {
       // Dispose in reverse order (most recently added first)
       // This helps with dependency relationships
       for (let i = this.disposables.length - 1; i >= 0; i--) {
         this.disposables[i].dispose();
       }
       this.disposables = [];
     }
   }

   /**
    * Example game component using the disposable pattern
    */
   class EnemyManager implements Disposable {
     private scene: Phaser.Scene;
     private enemies: Enemy[] = [];
     private disposables = new DisposableManager();
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       
       // Create a spawner timer that's managed
       this.disposables.add({
         dispose: () => {
           this.scene.time.removeEvent(spawnTimer);
         }
       });
       
       const spawnTimer = this.scene.time.addEvent({
         delay: 1000,
         callback: this.spawnEnemy,
         callbackScope: this,
         loop: true
       });
     }
     
     spawnEnemy(): void {
       const enemy = new Enemy(this.scene, Math.random() * 800, 0);
       this.enemies.push(enemy);
       
       // When we're disposed, dispose all enemies too
       this.disposables.add(enemy);
     }
     
     dispose(): void {
       this.disposables.dispose();
       this.enemies = [];
     }
   }

   /**
    * Enemy class that implements Disposable
    */
   class Enemy implements Disposable {
     private sprite: Phaser.GameObjects.Sprite;
     private disposables = new DisposableManager();
     
     constructor(scene: Phaser.Scene, x: number, y: number) {
       this.sprite = scene.add.sprite(x, y, 'enemy');
       
       // Track any resources that need cleanup
       const moveDownTween = scene.tweens.add({
         targets: this.sprite,
         y: 600,
         duration: 3000
       });
       
       // Add tween to disposables
       this.disposables.add({
         dispose: () => moveDownTween.stop()
       });
     }
     
     dispose(): void {
       // Cleanup all tracked resources
       this.disposables.dispose();
       
       // Destroy the sprite
       if (this.sprite) {
         this.sprite.destroy();
         this.sprite = null;
       }
     }
   }
   ```

