# Phaser Component-Based Architecture

## Context
- When creating complex Phaser game entities with multiple behaviors
- When code reuse across different entity types is important in a Phaser game
- When entity behavior needs to be modified at runtime
- When working on medium to large Phaser game projects

## Requirements
- Use Phaser.GameObjects as the foundation for component-based entity design
- Use either inheritance or composition patterns based on entity complexity
- Create modular, reusable components tied to Phaser's lifecycle methods
- Design components to leverage Phaser's event system for communication
- Ensure clean resource management and event cleanup in components

## Examples

<example>
```typescript
// Component interface compatible with Phaser's lifecycle
interface Component {
  init?(): void;
  preUpdate?(time: number, delta: number): void;
  update(time: number, delta: number): void;
  postUpdate?(time: number, delta: number): void;
  destroy(): void;
}

// Base entity class that integrates with Phaser's GameObject system
class PhaserEntity extends Phaser.GameObjects.Container {
  private components: Map<string, Component> = new Map();
  private registeredEvents: { target: Phaser.Events.EventEmitter, event: string, fn: Function, context: any }[] = [];

  constructor(scene: Phaser.Scene, x: number, y: number) {
    super(scene, x, y);
    // Add to scene and update list
    scene.add.existing(this);
    scene.sys.updateList.add(this);
  }

  // Add component and initialize it
  addComponent<T extends Component>(name: string, component: T): T {
    this.components.set(name, component);
    
    // Call initialization if it exists
    if (component.init) {
      component.init();
    }
    
    return component;
  }

  // Get component by name with proper TypeScript typing
  getComponent<T extends Component>(name: string): T | undefined {
    return this.components.get(name) as T;
  }

  // Check if component exists
  hasComponent(name: string): boolean {
    return this.components.has(name);
  }

  // Remove component and clean it up
  removeComponent(name: string): boolean {
    const component = this.components.get(name);
    if (component) {
      component.destroy();
      return this.components.delete(name);
    }
    return false;
  }

  // Register event for automatic cleanup
  addEvent(target: Phaser.Events.EventEmitter, event: string, fn: Function, context: any): void {
    target.on(event, fn, context);
    this.registeredEvents.push({ target, event, fn, context });
  }

  // Phaser lifecycle methods
  preUpdate(time: number, delta: number): void {
    // Call preUpdate on all components that implement it
    this.components.forEach(component => {
      if (component.preUpdate) {
        component.preUpdate(time, delta);
      }
    });
  }

  update(time: number, delta: number): void {
    // Update all components
    this.components.forEach(component => component.update(time, delta));
  }

  postUpdate(time: number, delta: number): void {
    // Call postUpdate on all components that implement it
    this.components.forEach(component => {
      if (component.postUpdate) {
        component.postUpdate(time, delta);
      }
    });
  }

  destroy(fromScene?: boolean): void {
    // Clean up all components
    this.components.forEach(component => component.destroy());
    this.components.clear();
    
    // Remove all registered event listeners
    this.registeredEvents.forEach(({ target, event, fn, context }) => {
      target.off(event, fn, context);
    });
    this.registeredEvents = [];
    
    // Call parent destroy method
    super.destroy(fromScene);
  }
}

// Health component that leverages Phaser's event system
class HealthComponent implements Component {
  private entity: PhaserEntity;
  private scene: Phaser.Scene;
  private currentHealth: number;
  private maxHealth: number;
  private healthBar: Phaser.GameObjects.Graphics;
  
  constructor(entity: PhaserEntity, maxHealth: number) {
    this.entity = entity;
    this.scene = entity.scene;
    this.maxHealth = maxHealth;
    this.currentHealth = maxHealth;
    
    // Create health bar as a child of the entity
    this.healthBar = this.scene.add.graphics();
    this.entity.add(this.healthBar);
    this.updateHealthBar();
  }

  takeDamage(amount: number): void {
    this.currentHealth = Math.max(0, this.currentHealth - amount);
    this.updateHealthBar();
    
    // Emit a Phaser event that can be listened to
    this.scene.events.emit('entityDamaged', this.entity, amount);
    
    // Flash effect when damaged
    this.entity.list.forEach((child) => {
      if (child instanceof Phaser.GameObjects.Sprite) {
        child.setTint(0xff0000);
        this.scene.tweens.add({
          targets: child,
          duration: 100,
          onComplete: () => {
            child.clearTint();
          }
        });
      }
    });
    
    if (this.currentHealth <= 0) {
      this.scene.events.emit('entityDied', this.entity);
    }
  }

  heal(amount: number): void {
    this.currentHealth = Math.min(this.maxHealth, this.currentHealth + amount);
    this.updateHealthBar();
    this.scene.events.emit('entityHealed', this.entity, amount);
  }

  private updateHealthBar(): void {
    // Draw health bar
    this.healthBar.clear();
    this.healthBar.fillStyle(0x000000, 0.5);
    this.healthBar.fillRect(-20, -30, 40, 5);
    
    const healthPercent = this.currentHealth / this.maxHealth;
    const color = healthPercent > 0.5 ? 0x00ff00 : healthPercent > 0.25 ? 0xffff00 : 0xff0000;
    
    this.healthBar.fillStyle(color, 1);
    this.healthBar.fillRect(-20, -30, 40 * healthPercent, 5);
  }

  update(time: number, delta: number): void {
    // Position health bar above entity
    this.healthBar.setPosition(0, 0);
  }

  destroy(): void {
    this.healthBar.destroy();
  }
}

// Physics-based movement component for Phaser
class PhysicsMovementComponent implements Component {
  private entity: PhaserEntity;
  private scene: Phaser.Scene;
  private speed: number;
  private body: Phaser.Physics.Arcade.Body;
  
  constructor(entity: PhaserEntity, speed: number) {
    this.entity = entity;
    this.scene = entity.scene;
    this.speed = speed;
    
    // Enable physics on the entity container
    this.scene.physics.world.enable(this.entity);
    this.body = this.entity.body as Phaser.Physics.Arcade.Body;
    
    // Configure physics body
    this.body.setCollideWorldBounds(true);
    this.body.setFriction(0.2, 0.2);
  }

  moveTo(x: number, y: number): void {
    const angle = Phaser.Math.Angle.Between(this.entity.x, this.entity.y, x, y);
    this.moveInDirection(angle);
    
    // Rotate sprite to face movement direction if entity has children
    this.entity.list.forEach((child) => {
      if (child instanceof Phaser.GameObjects.Sprite) {
        child.setRotation(angle + Math.PI/2);
      }
    });
  }

  moveInDirection(angle: number): void {
    this.scene.physics.velocityFromRotation(
      angle, 
      this.speed, 
      this.body.velocity
    );
  }

  stop(): void {
    this.body.setVelocity(0, 0);
  }

  update(time: number, delta: number): void {
    // Deceleration logic can go here if needed
    if (Math.abs(this.body.velocity.x) < 5 && Math.abs(this.body.velocity.y) < 5) {
      this.stop();
    }
  }

  destroy(): void {
    // Disable physics when component is destroyed
    if (this.body && this.entity.scene) {
      this.scene.physics.world.disable(this.entity);
    }
  }
}

// Animation component for Phaser sprites
class AnimationComponent implements Component {
  private entity: PhaserEntity;
  private sprite: Phaser.GameObjects.Sprite;
  private currentAnim: string | null = null;
  
  constructor(entity: PhaserEntity, sprite: Phaser.GameObjects.Sprite) {
    this.entity = entity;
    this.sprite = sprite;
  }
  
  playAnimation(key: string, ignoreIfPlaying: boolean = true): void {
    if (ignoreIfPlaying && this.currentAnim === key && this.sprite.anims.isPlaying) {
      return;
    }
    
    this.sprite.play(key);
    this.currentAnim = key;
  }
  
  update(time: number, delta: number): void {
    // Update animation based on entity state
    // This could check velocity from a physics component and play the appropriate animation
    const physicsComponent = this.entity.getComponent<PhysicsMovementComponent>('movement');
    if (physicsComponent) {
      const body = this.entity.body as Phaser.Physics.Arcade.Body;
      if (body) {
        // Check if moving
        if (body.velocity.length() > 10) {
          this.playAnimation('walk');
        } else {
          this.playAnimation('idle');
        }
      }
    }
  }
  
  destroy(): void {
    // No special cleanup needed
  }
}

// Input handling component for player control
class PlayerInputComponent implements Component {
  private entity: PhaserEntity;
  private scene: Phaser.Scene;
  private cursors: Phaser.Types.Input.Keyboard.CursorKeys;
  private movementComponent: PhysicsMovementComponent;
  
  constructor(entity: PhaserEntity, movementComponent: PhysicsMovementComponent) {
    this.entity = entity;
    this.scene = entity.scene;
    this.movementComponent = movementComponent;
    this.cursors = this.scene.input.keyboard.createCursorKeys();
    
    // Register pointer down event with automatic cleanup
    if (entity instanceof PhaserEntity) {
      entity.addEvent(
        this.scene.input,
        'pointerdown',
        this.handlePointerDown,
        this
      );
    }
  }
  
  private handlePointerDown(pointer: Phaser.Input.Pointer): void {
    // Move to pointer position
    this.movementComponent.moveTo(pointer.worldX, pointer.worldY);
  }
  
  update(time: number, delta: number): void {
    // Keyboard controls
    if (this.cursors.left.isDown) {
      this.movementComponent.moveInDirection(Math.PI);
    } else if (this.cursors.right.isDown) {
      this.movementComponent.moveInDirection(0);
    } else if (this.cursors.up.isDown) {
      this.movementComponent.moveInDirection(-Math.PI/2);
    } else if (this.cursors.down.isDown) {
      this.movementComponent.moveInDirection(Math.PI/2);
    } else if (!this.scene.input.activePointer.isDown) {
      // Only stop if not moving to pointer
      this.movementComponent.stop();
    }
  }
  
  destroy(): void {
    // Event cleanup is handled by the entity
  }
}

// Usage example: Creating a player entity
const createPlayer = (scene: Phaser.Scene, x: number, y: number): PhaserEntity => {
  // Create base entity
  const player = new PhaserEntity(scene, x, y);
  
  // Add visual representation
  const sprite = scene.add.sprite(0, 0, 'player');
  player.add(sprite);
  
  // Add and store components
  const movement = player.addComponent('movement', new PhysicsMovementComponent(player, 200));
  player.addComponent('health', new HealthComponent(player, 100));
  player.addComponent('animation', new AnimationComponent(player, sprite));
  player.addComponent('input', new PlayerInputComponent(player, movement));
  
  return player;
};
```
This example shows how to implement component-based architecture with Phaser, leveraging Phaser's event system, physics, tweens, and game object containers. The approach fully integrates with Phaser's lifecycle and provides proper cleanup for all resources.
