# Shader Optimization

## Context
- When implementing custom GLSL shader effects
- When targeting hardware with varying GPU capabilities
- When fine-tuning performance for shader-heavy visual effects
- When implementing post-processing or special effects

## Requirements
- Minimize shader arithmetic complexity and branching
- Use appropriate precision qualifiers for variables
- Implement shader techniques appropriate for target hardware
- Avoid expensive operations in fragment shaders
- Implement fallbacks for less capable hardware
- Optimize uniform updates to minimize state changes

## Examples

<example>
```typescript
/**
 * Optimized shader implementation with performance considerations
 */
class OptimizedShaderEffect {
  private scene: Phaser.Scene;
  private shader: Phaser.GameObjects.Shader;
  private uniformUpdates: Map<string, any> = new Map();
  private lastTime: number = 0;
  
  // Shader metrics for optimization
  private static readonly COSTS = {
    ARITHMETIC: 1,
    TRIG: 5,
    TEXTURE: 10,
    BRANCH: 8,
    LOOP_ITERATION: 4
  };
  
  constructor(scene: Phaser.Scene, x: number, y: number, width: number, height: number) {
    this.scene = scene;
    
    // Detect platform capabilities
    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    
    // Choose appropriate shader complexity based on platform
    const fragShader = isMobile ? this.getMobileShader() : this.getDesktopShader();
    
    // Create shader with optimized code
    this.shader = scene.add.shader(
      'optimizedEffect', 
      x, 
      y, 
      width, 
      height, 
      ['effect'], // Texture keys
      fragShader
    );
    
    // Set up optimized uniform updates
    this.scene.events.on('prerender', this.updateUniforms, this);
    
    // Clean up on destroy
    this.shader.on('destroy', () => {
      this.scene.events.off('prerender', this.updateUniforms, this);
    });
  }
  
  /**
   * Get optimized desktop shader with full features
   */
  private getDesktopShader(): string {
    return `
      precision highp float;
      uniform sampler2D effect;
      uniform float time;
      uniform vec2 resolution;
      uniform float intensity;
      
      varying vec2 fragCoord;
      
      void main() {
        vec2 uv = fragCoord / resolution.xy;
        
        // Pre-calculate values used multiple times
        float timeValue = time * 0.05;
        
        // Use texture lookup with bilinear filtering (more efficient)
        vec4 texColor = texture2D(effect, uv);
        
        // Efficient color manipulation with minimal operations
        float luminance = dot(texColor.rgb, vec3(0.299, 0.587, 0.114));
        
        // Avoid branches when possible - use mix() instead of if/else
        vec3 finalColor = mix(
          texColor.rgb,
          texColor.rgb * vec3(1.0, 0.8, 0.6),
          intensity
        );
        
        gl_FragColor = vec4(finalColor, texColor.a);
      }
    `;
  }
  
  /**
   * Get simplified mobile shader with optimized performance
   */
  private getMobileShader(): string {
    return `
      precision mediump float;
      uniform sampler2D effect;
      uniform float time;
      uniform vec2 resolution;
      uniform float intensity;
      
      varying vec2 fragCoord;
      
      void main() {
        vec2 uv = fragCoord / resolution.xy;
        
        // Simple texture lookup
        vec4 texColor = texture2D(effect, uv);
        
        // Minimal processing for mobile
        vec3 finalColor = texColor.rgb * vec3(1.0, 0.9, 0.8);
        
        gl_FragColor = vec4(finalColor, texColor.a);
      }
    `;
  }
  
  /**
   * Batch uniform updates to minimize state changes
   */
  private updateUniforms(time: number): void {
    // Skip if shader is destroyed
    if (!this.shader || !this.shader.active) return;
    
    // Update time-based uniforms only when needed
    if (time - this.lastTime > 16) {
      this.uniformUpdates.set('time', time / 1000);
      this.lastTime = time;
    }
    
    // Apply all pending uniform updates at once
    if (this.uniformUpdates.size > 0) {
      this.uniformUpdates.forEach((value, key) => {
        this.shader.setUniform(key, value);
      });
      this.uniformUpdates.clear();
    }
  }
  
  /**
   * Set effect intensity with deferred update
   */
  setIntensity(value: number): void {
    this.uniformUpdates.set('intensity', Math.max(0, Math.min(1, value)));
  }
  
  /**
   * Analyze shader complexity and suggest optimizations
   */
  static analyzeShaderComplexity(source: string): { complexity: number, warnings: string[] } {
    // Shader analysis implementation...
    return { complexity: 0, warnings: [] };
  }
}
