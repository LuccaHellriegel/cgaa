## Phaser-Specific Notes

1. Integrate logging with Phaser's scene lifecycle:
   ```typescript
   // Add logging to key Phaser lifecycle methods
   create() {
     this.logger.info(LogCategory.GENERAL, 'Scene created');
     
     // Log transitions between game states
     this.events.on('shutdown', () => {
       this.logger.info(LogCategory.GENERAL, 'Scene shutting down');
     });
   }
   ```

2. Use Phaser's debug capabilities alongside custom logging:
   ```typescript
   // Enable Phaser's built-in debug features in development
   const config = {
     physics: {
       default: 'arcade',
       arcade: {
         debug: process.env.NODE_ENV !== 'production'
       }
     }
   };
   
   // Add custom physics debug logging
   collider.setCallback(() => {
     this.logger.debug(LogCategory.PHYSICS, 'Collision occurred');
   });
   ```

3. Log performance metrics for critical game systems:
   ```typescript
   update(time: number, delta: number) {
     // Track frame time for performance monitoring
     const start = performance.now();
     
     // Game update logic
     this.updateGameLogic(delta);
     
     // Log if frame takes too long
     const frameDuration = performance.now() - start;
     if (frameDuration > 16.6) { // More than 60fps frame budget
       this.logger.warn(
         LogCategory.PERFORMANCE, 
         'Frame time exceeded budget', 
         { duration: frameDuration, delta }
       );
     }
   }
   ```

4. Create debug visualizations using Phaser's graphics:
   ```typescript
   // Debug visualization for physics or AI
   class DebugVisualizer {
     private scene: Phaser.Scene;
     private graphics: Phaser.GameObjects.Graphics;
     private enabled: boolean = false;
     
     constructor(scene: Phaser.Scene) {
       this.scene = scene;
       this.graphics = scene.add.graphics();
       
       // Toggle with key press
       scene.input.keyboard.on('keydown-V', () => {
         this.enabled = !this.enabled;
         this.graphics.clear();
       });
     }
     
     update(targets: Array<{x: number, y: number, radius: number}>) {
       if (!this.enabled) return;
       
       this.graphics.clear();
       this.graphics.lineStyle(1, 0x00ff00);
       
       targets.forEach(target => {
         this.graphics.strokeCircle(target.x, target.y, target.radius);
       });
     }
   }
   