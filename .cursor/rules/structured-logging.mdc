# Structured Logging

## Context
- When debugging complex game mechanics and interactions
- When tracking user behavior and game progression
- When troubleshooting issues across different platforms
- When collaborating in a team with varied debugging needs
- When developing systems that require detailed logging for diagnostics

## Requirements
- Create a centralized logging system with configurable verbosity levels
- Categorize logs by system component (physics, audio, UI, etc.)
- Include timestamps and contextual data in log messages
- Implement conditional logging based on build environment (dev/prod)
- Ensure logging has minimal performance impact in production
- Support remote logging/telemetry for production diagnostics
- Allow runtime adjustment of logging verbosity

## Examples

<example>
```typescript
/**
 * Structured logging system with categories and levels
 */
// Log levels in order of verbosity
enum LogLevel {
  NONE = 0,   // No logging
  ERROR = 1,  // Critical errors
  WARN = 2,   // Warnings
  INFO = 3,   // Important information
  DEBUG = 4,  // Debugging information
  TRACE = 5   // Detailed tracing
}

// Log categories for different game systems
enum LogCategory {
  GENERAL = 'GENERAL',
  PHYSICS = 'PHYSICS',
  AUDIO = 'AUDIO',
  INPUT = 'INPUT',
  RENDER = 'RENDER',
  ASSETS = 'ASSETS',
  NETWORK = 'NETWORK',
  AI = 'AI',
  PERFORMANCE = 'PERFORMANCE'
}

// Interface for log handlers
interface LogHandler {
  handle(entry: LogEntry): void;
}

// Log entry structure
interface LogEntry {
  timestamp: number;
  level: LogLevel;
  category: LogCategory;
  message: string;
  data?: any;
  timeElapsed?: number;  // Time since game start
}

/**
 * Main logger class using singleton pattern
 */
class GameLogger {
  private static instance: GameLogger;
  private currentLevel: LogLevel = LogLevel.INFO;
  private logsHistory: LogEntry[] = [];
  private maxHistory: number = 1000;
  private logHandlers: LogHandler[] = [];
  private startTime: number = Date.now();
  private categoryLevels: Map<LogCategory, LogLevel> = new Map();
  
  // Singleton pattern
  public static getInstance(): GameLogger {
    if (!GameLogger.instance) {
      GameLogger.instance = new GameLogger();
    }
    return GameLogger.instance;
  }
  
  private constructor() {
    // Add default console handler
    this.addHandler(new ConsoleLogHandler());
    
    // Set appropriate level based on environment
    if (process.env.NODE_ENV === 'production') {
      this.setLevel(LogLevel.ERROR);
    } else {
      this.setLevel(LogLevel.DEBUG);
    }
  }
  
  // Add a new log handler
  public addHandler(handler: LogHandler): void {
    this.logHandlers.push(handler);
  }
  
  // Set global log level
  public setLevel(level: LogLevel): void {
    this.currentLevel = level;
  }
  
  // Set log level for a specific category
  public setCategoryLevel(category: LogCategory, level: LogLevel): void {
    this.categoryLevels.set(category, level);
  }
  
  // Get effective log level for a category
  private getEffectiveLevel(category: LogCategory): LogLevel {
    return this.categoryLevels.get(category) || this.currentLevel;
  }
  
  // Core logging method
  private log(level: LogLevel, category: LogCategory, message: string, data?: any): void {
    // Skip if level is too verbose for current settings
    if (level > this.getEffectiveLevel(category)) {
      return;
    }
    
    const entry: LogEntry = {
      timestamp: Date.now(),
      timeElapsed: Date.now() - this.startTime,
      level,
      category,
      message,
      data
    };
    
    // Add to history (with size limit)
    this.logsHistory.push(entry);
    if (this.logsHistory.length > this.maxHistory) {
      this.logsHistory.shift();
    }
    
    // Pass to all handlers
    this.logHandlers.forEach(handler => handler.handle(entry));
  }
  
  // Convenience methods for different log levels
  public error(category: LogCategory, message: string, data?: any): void {
    this.log(LogLevel.ERROR, category, message, data);
  }
  
  public warn(category: LogCategory, message: string, data?: any): void {
    this.log(LogLevel.WARN, category, message, data);
  }
  
  public info(category: LogCategory, message: string, data?: any): void {
    this.log(LogLevel.INFO, category, message, data);
  }
  
  public debug(category: LogCategory, message: string, data?: any): void {
    this.log(LogLevel.DEBUG, category, message, data);
  }
  
  public trace(category: LogCategory, message: string, data?: any): void {
    this.log(LogLevel.TRACE, category, message, data);
  }
  
  // Get logs history
  public getHistory(): LogEntry[] {
    return [...this.logsHistory];
  }
  
  // Get logs for specific category
  public getHistoryByCategory(category: LogCategory): LogEntry[] {
    return this.logsHistory.filter(entry => entry.category === category);
  }
  
  // Clear log history
  public clearHistory(): void {
    this.logsHistory = [];
  }
}

/**
 * Default console log handler
 */
class ConsoleLogHandler implements LogHandler {
  private levelColors = {
    [LogLevel.ERROR]: 'color: red; font-weight: bold',
    [LogLevel.WARN]: 'color: orange',
    [LogLevel.INFO]: 'color: blue',
    [LogLevel.DEBUG]: 'color: green',
    [LogLevel.TRACE]: 'color: gray'
  };
  
  public handle(entry: LogEntry): void {
    const timestamp = new Date(entry.timestamp).toISOString();
    const levelName = LogLevel[entry.level];
    const color = this.levelColors[entry.level];
    const elapsed = entry.timeElapsed ? `+${Math.floor(entry.timeElapsed / 1000)}s` : '';
    
    // Format: [TIME][LEVEL][CATEGORY] Message
    const logString = `[${timestamp}][${levelName}][${entry.category}]${elapsed} ${entry.message}`;
    
    switch (entry.level) {
      case LogLevel.ERROR:
        console.error(`%c${logString}`, color, entry.data || '');
        break;
      case LogLevel.WARN:
        console.warn(`%c${logString}`, color, entry.data || '');
        break;
      case LogLevel.INFO:
        console.info(`%c${logString}`, color, entry.data || '');
        break;
      case LogLevel.DEBUG:
      case LogLevel.TRACE:
      default:
        console.log(`%c${logString}`, color, entry.data || '');
        break;
    }
  }
}
```
