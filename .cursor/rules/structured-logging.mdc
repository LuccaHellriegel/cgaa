## Logging Implementation Patterns

1. **Remote Telemetry Handler**:
   ```typescript
   /**
    * Handler that sends logs to a remote server for telemetry
    */
   class RemoteLogHandler implements LogHandler {
     private apiEndpoint: string;
     private batchSize: number = 50;
     private logQueue: LogEntry[] = [];
     private isUploading = false;
     
     constructor(apiEndpoint: string) {
       this.apiEndpoint = apiEndpoint;
       
       // Flush logs on window unload to prevent data loss
       window.addEventListener('beforeunload', () => this.flushLogs());
       
       // Set up regular flush interval
       setInterval(() => this.flushLogs(), 30000);
     }
     
     public handle(entry: LogEntry): void {
       // Only send ERROR and WARN logs to the server
       if (entry.level <= LogLevel.WARN) {
         this.logQueue.push(entry);
         
         // Flush immediately on errors, or when batch size is reached
         if (entry.level === LogLevel.ERROR || this.logQueue.length >= this.batchSize) {
           this.flushLogs();
         }
       }
     }
     
     private async flushLogs(): Promise<void> {
       if (this.isUploading || this.logQueue.length === 0) {
         return;
       }
       
       try {
         this.isUploading = true;
         const logsToSend = [...this.logQueue];
         this.logQueue = [];
         
         // Send logs to server
         await fetch(this.apiEndpoint, {
           method: 'POST',
           headers: {
             'Content-Type': 'application/json'
           },
           body: JSON.stringify({
             logs: logsToSend,
             clientInfo: {
               userAgent: navigator.userAgent,
               timestamp: Date.now()
             }
           })
         });
       } catch (error) {
         // If send fails, push back into queue for retry
         this.logQueue.unshift(...this.logQueue);
         
         // But limit size to prevent memory issues
         if (this.logQueue.length > this.batchSize * 3) {
           this.logQueue = this.logQueue.slice(0, this.batchSize * 3);
         }
       } finally {
         this.isUploading = false;
       }
     }
   }
   ```

2. **Local Storage Handler**:
   ```typescript
   /**
    * Handler that stores logs in local storage for persistence
    */
   class LocalStorageLogHandler implements LogHandler {
     private storageKey: string;
     private maxEntries: number;
     
     constructor(storageKey: string = 'game_logs', maxEntries: number = 200) {
       this.storageKey = storageKey;
       this.maxEntries = maxEntries;
     }
     
     public handle(entry: LogEntry): void {
       try {
         // Get existing logs or initialize empty array
         const existingLogsJson = localStorage.getItem(this.storageKey) || '[]';
         const existingLogs = JSON.parse(existingLogsJson) as LogEntry[];
         
         // Add new entry
         existingLogs.push(entry);
         
         // Limit size
         if (existingLogs.length > this.maxEntries) {
           existingLogs.shift();
         }
         
         // Save back to storage
         localStorage.setItem(this.storageKey, JSON.stringify(existingLogs));
       } catch (e) {
         // Fail silently - local storage might be disabled
         console.error('Failed to store log in local storage', e);
       }
     }
     
     // Get stored logs
     public getLogs(): LogEntry[] {
       try {
         const logsJson = localStorage.getItem(this.storageKey) || '[]';
         return JSON.parse(logsJson) as LogEntry[];
       } catch (e) {
         return [];
       }
     }
     
     // Clear stored logs
     public clearLogs(): void {
       localStorage.removeItem(this.storageKey);
     }
   }
   ```

