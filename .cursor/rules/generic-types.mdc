# Generic Types and Type Utilities

## Context
- When creating reusable components, containers, or utilities
- When implementing collections or data structures 
- When designing APIs with consistent interfaces
- When building systems that need to handle multiple data types

## Requirements
- Use generic type parameters to create reusable components
- Apply constraints on generic types with `extends` where appropriate
- Utilize TypeScript utility types (Partial, Record, Pick, etc.)
- Create custom mapped types for complex transformations
- Document generic type parameters with JSDoc comments

## Examples

<example>
```typescript
/**
 * Generic resource manager for game assets
 * @template T The type of resource being managed
 */
class ResourceManager<T> {
  private resources: Map<string, T> = new Map();
  
  /**
   * Add a resource to the manager
   * @param id Unique identifier for the resource
   * @param resource The resource to add
   * @returns The resource that was added
   */
  add(id: string, resource: T): T {
    this.resources.set(id, resource);
    return resource;
  }
  
  /**
   * Get a resource by id
   * @param id The resource identifier
   * @returns The resource or undefined if not found
   */
  get(id: string): T | undefined {
    return this.resources.get(id);
  }
  
  /**
   * Check if a resource exists
   * @param id The resource identifier
   */
  has(id: string): boolean {
    return this.resources.has(id);
  }
  
  /**
   * Remove a resource
   * @param id The resource identifier
   * @returns True if the resource was removed
   */
  remove(id: string): boolean {
    return this.resources.delete(id);
  }
  
  /**
   * Get all resource ids
   */
  getIds(): string[] {
    return Array.from(this.resources.keys());
  }
  
  /**
   * Execute a function for each resource
   * @param callback Function to execute for each resource
   */
  forEach(callback: (resource: T, id: string) => void): void {
    this.resources.forEach((resource, id) => {
      callback(resource, id);
    });
  }
}

/**
 * Event emitter with typed events
 * @template EventMap Map of event names to event data types
 */
class TypedEventEmitter<EventMap extends Record<string, any>> {
  private listeners: { [K in keyof EventMap]?: Array<(data: EventMap[K]) => void> } = {};
  
  /**
   * Register an event listener
   * @param event Event name
   * @param callback Callback function
   */
  on<K extends keyof EventMap>(event: K, callback: (data: EventMap[K]) => void): void {
    if (!this.listeners[event]) {
      this.listeners[event] = [];
    }
    this.listeners[event]?.push(callback);
  }
  
  /**
   * Remove an event listener
   * @param event Event name
   * @param callback Callback function to remove
   */
  off<K extends keyof EventMap>(event: K, callback: (data: EventMap[K]) => void): void {
    const eventListeners = this.listeners[event];
    if (eventListeners) {
      const index = eventListeners.indexOf(callback);
      if (index !== -1) {
        eventListeners.splice(index, 1);
      }
    }
  }
  
  /**
   * Emit an event with data
   * @param event Event name
   * @param data Event data
   */
  emit<K extends keyof EventMap>(event: K, data: EventMap[K]): void {
    const eventListeners = this.listeners[event];
    if (eventListeners) {
      eventListeners.forEach(callback => callback(data));
    }
  }
}

/**
 * Component factory with type safety
 * @template T The base component type
 */
class ComponentFactory<T extends Component> {
  private constructors: Record<string, new (...args: any[]) => T> = {};
  
  /**
   * Register a component constructor
   * @param type Component type name
   * @param constructor Constructor function
   */
  register<U extends T>(type: string, constructor: new (...args: any[]) => U): void {
    this.constructors[type] = constructor;
  }
  
  /**
   * Create a component instance
   * @param type Component type name
   * @param args Constructor arguments
   * @returns New component instance
   */
  create<U extends T>(type: string, ...args: any[]): U {
    const Constructor = this.constructors[type] as new (...args: any[]) => U;
    if (!Constructor) {
      throw new Error(`Unknown component type: ${type}`);
    }
    return new Constructor(...args);
  }
  
  /**
   * Check if a component type is registered
   * @param type Component type name
   */
  hasType(type: string): boolean {
    return type in this.constructors;
  }
  
  /**
   * Get all registered component types
   */
  getTypes(): string[] {
    return Object.keys(this.constructors);
  }
}
```
</example>

