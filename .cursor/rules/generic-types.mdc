## Generic Type Patterns

1. **Generic Collections**:
   ```typescript
   /**
    * Type-safe object pool
    * @template T Type of objects in the pool
    */
   class ObjectPool<T> {
     private available: T[] = [];
     private inUse: Set<T> = new Set();
     
     constructor(
       private factory: () => T,
       private reset: (obj: T) => void,
       initialSize = 0
     ) {
       // Pre-allocate initial objects
       for (let i = 0; i < initialSize; i++) {
         this.available.push(this.factory());
       }
     }
     
     /**
      * Get an object from the pool or create a new one
      */
     acquire(): T {
       const obj = this.available.pop() || this.factory();
       this.inUse.add(obj);
       return obj;
     }
     
     /**
      * Return an object to the pool
      */
     release(obj: T): void {
       if (this.inUse.has(obj)) {
         this.inUse.delete(obj);
         this.reset(obj);
         this.available.push(obj);
       }
     }
     
     /**
      * Get count of available objects
      */
     get availableCount(): number {
       return this.available.length;
     }
     
     /**
      * Get count of in-use objects
      */
     get inUseCount(): number {
       return this.inUse.size;
     }
   }
   ```

2. **Typed State Management**:
   ```typescript
   /**
    * Type-safe state container with actions
    * @template S State type
    * @template A Actions type map
    */
   class Store<S, A extends Record<string, (...args: any[]) => Partial<S>>> {
     private listeners: Set<(state: S) => void> = new Set();
     
     constructor(
       private state: S,
       private actions: A
     ) {}
     
     /**
      * Get current state
      */
     getState(): Readonly<S> {
       return { ...this.state };
     }
     
     /**
      * Dispatch an action to update state
      */
     dispatch<K extends keyof A>(
       actionType: K,
       ...args: Parameters<A[K]>
     ): void {
       const action = this.actions[actionType];
       const updates = action(...args);
       this.state = { ...this.state, ...updates };
       this.notifyListeners();
     }
     
     /**
      * Subscribe to state changes
      */
     subscribe(listener: (state: S) => void): () => void {
       this.listeners.add(listener);
       return () => this.listeners.delete(listener);
     }
     
     private notifyListeners(): void {
       const state = this.getState();
       this.listeners.forEach(listener => listener(state));
     }
   }
   ```

3. **Component Registry with Constraints**:
   ```typescript
   /**
    * Base component interface
    */
   interface BaseComponent {
     readonly id: string;
     initialize(): void;
     update(delta: number): void;
   }
   
   /**
    * Component registry with type constraints
    * @template T Component type extending BaseComponent
    */
   class ComponentRegistry<T extends BaseComponent> {
     private components = new Map<string, T>();
     
     /**
      * Add component with type checking
      */
     register<U extends T>(id: string, component: U): U {
       this.components.set(id, component);
       return component;
     }
     
     /**
      * Get component with type checking
      */
     get<U extends T>(id: string): U | undefined {
       return this.components.get(id) as U | undefined;
     }
     
     /**
      * Remove component
      */
     unregister(id: string): boolean {
       return this.components.delete(id);
     }
     
     /**
      * Update all components
      */
     updateAll(delta: number): void {
       this.components.forEach(component => component.update(delta));
     }
     
     /**
      * Get all components matching a type predicate
      */
     getByType<U extends T>(predicate: (component: T) => component is U): U[] {
       return Array.from(this.components.values()).filter(predicate);
     }
   }
   ```

