# Texture Atlases

## Context
- When working with many small textures or sprite frames
- When optimizing memory usage and reducing texture switches
- When targeting mobile or memory-constrained platforms
- When experiencing performance issues due to texture fragmentation
- When implementing sprite-heavy games with many animations

## Requirements
- Combine multiple textures into a single atlas texture
- Use texture packing tools to optimize atlas layout
- Implement proper atlas loading and management
- Apply consistent naming conventions for atlas frames
- Consider memory vs. performance tradeoffs when creating atlases
- Implement dynamic atlas generation for procedural content

## Examples

<example>
```typescript
/**
 * Texture atlas manager for efficient sprite rendering
 */
class TextureAtlasManager {
  private scene: Phaser.Scene;
  private atlases: Map<string, AtlasInfo> = new Map();
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
  }
  
  /**
   * Load a texture atlas
   * @param key Atlas identifier
   * @param textureURL Path to atlas image
   * @param atlasURL Path to atlas JSON data
   * @returns Promise that resolves when atlas is loaded
   */
  loadAtlas(key: string, textureURL: string, atlasURL: string): Promise<void> {
    return new Promise<void>((resolve, reject) => {
      // Skip if already loaded
      if (this.scene.textures.exists(key)) {
        resolve();
        return;
      }
      
      // Load the atlas
      this.scene.load.atlas(key, textureURL, atlasURL);
      
      // Handle completion
      this.scene.load.once('complete', () => {
        // Get atlas data
        const frames = this.scene.textures.get(key).getFrameNames();
        
        // Store atlas info
        this.atlases.set(key, {
          key,
          frames,
          textureURL,
          atlasURL
        });
        
        console.log(`Loaded atlas: ${key} with ${frames.length} frames`);
        resolve();
      });
      
      // Handle error
      this.scene.load.once('loaderror', (file: any) => {
        if (file.key === key) {
          console.error(`Failed to load atlas: ${key}`);
          reject(new Error(`Failed to load atlas: ${key}`));
        }
      });
      
      // Start loading
      this.scene.load.start();
    });
  }
  
  /**
   * Create a sprite from an atlas frame
   * @param atlasKey Atlas identifier
   * @param frameName Frame name within the atlas
   * @param x X position
   * @param y Y position
   * @returns The created sprite
   */
  createSprite(
    atlasKey: string,
    frameName: string,
    x: number = 0,
    y: number = 0
  ): Phaser.GameObjects.Sprite {
    if (!this.atlases.has(atlasKey)) {
      throw new Error(`Atlas not loaded: ${atlasKey}`);
    }
    
    const atlas = this.atlases.get(atlasKey);
    if (!atlas.frames.includes(frameName)) {
      throw new Error(`Frame not found in atlas: ${frameName}`);
    }
    
    return this.scene.add.sprite(x, y, atlasKey, frameName);
  }
  
  /**
   * Create an animation from atlas frames
   * @param animKey Animation identifier
   * @param atlasKey Atlas identifier
   * @param frameNames Array of frame names or pattern
   * @param frameRate Frames per second
   * @param repeat Number of times to repeat (-1 for infinite)
   * @returns The animation key
   */
  createAnimation(
    animKey: string,
    atlasKey: string,
    frameNames: string[] | string,
    frameRate: number = 24,
    repeat: number = 0
  ): string {
    if (!this.atlases.has(atlasKey)) {
      throw new Error(`Atlas not loaded: ${atlasKey}`);
    }
    
    // Create animation config
    const config: Phaser.Types.Animations.Animation = {
      key: animKey,
      frames: this.scene.anims.generateFrameNames(atlasKey, {
        // If frameNames is a string, treat it as a pattern
        ...(typeof frameNames === 'string'
          ? { prefix: frameNames, end: this.getPatternFrameCount(atlasKey, frameNames) }
          : { frames: frameNames }
        )
      }),
      frameRate,
      repeat
    };
    
    // Create the animation
    this.scene.anims.create(config);
    return animKey;
  }
  
  /**
   * Get the number of frames matching a pattern
   */
  private getPatternFrameCount(atlasKey: string, pattern: string): number {
    const atlas = this.atlases.get(atlasKey);
    let count = 0;
    
    for (const frame of atlas.frames) {
      if (frame.startsWith(pattern)) {
        count++;
      }
    }
    
    return count;
  }
  
  /**
   * Get all frame names for an atlas
   * @param atlasKey Atlas identifier
   * @returns Array of frame names
   */
  getFrameNames(atlasKey: string): string[] {
    if (!this.atlases.has(atlasKey)) {
      throw new Error(`Atlas not loaded: ${atlasKey}`);
    }
    
    return [...this.atlases.get(atlasKey).frames];
  }
  
  /**
   * Unload an atlas to free memory
   * @param atlasKey Atlas identifier
   */
  unloadAtlas(atlasKey: string): void {
    if (this.atlases.has(atlasKey)) {
      // Remove from texture manager
      this.scene.textures.remove(atlasKey);
      
      // Remove from our tracking
      this.atlases.delete(atlasKey);
      
      console.log(`Unloaded atlas: ${atlasKey}`);
    }
  }
  
  /**
   * Clean up resources
   */
  destroy(): void {
    // Unload all atlases
    for (const key of this.atlases.keys()) {
      this.unloadAtlas(key);
    }
    
    this.atlases.clear();
  }
}

/**
 * Information about a loaded texture atlas
 */
interface AtlasInfo {
  key: string;
  frames: string[];
  textureURL: string;
  atlasURL: string;
}
```
</example>

