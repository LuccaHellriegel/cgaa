function playSpatialSound(x, y) {
  // Calculate pan value based on position relative to screen
  const normalizedX = (x / this.scale.width) * 2 - 1; // -1 to 1
  sound.setPan(normalizedX);
  
  // Calculate volume based on distance from player
  const distance = Phaser.Math.Distance.Between(
    x, y, 
    this.player.x, this.player.y
  );
  const maxDistance = 300;
  const volume = Math.max(0, 1 - (distance / maxDistance));
  
  sound.setVolume(volume);
  sound.play();
}
