// Inefficient and problematic audio implementation
export class BadAudioImplementation {
  private scene: Phaser.Scene;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    this.loadAudio();
  }
  
  private loadAudio(): void {
    // Load sound files directly in constructor without preload phase
    this.scene.sound.add('shoot', 'assets/audio/shoot.mp3');
    this.scene.sound.add('explosion', 'assets/audio/explosion.mp3');
    this.scene.sound.add('music', 'assets/audio/music.mp3');
  }
  
  playSfx(key: string): void {
    // Create a new sound instance each time instead of reusing
    const sound = this.scene.sound.add(key);
    sound.play();
    
    // No cleanup - sound instances accumulate
  }
  
  playExplosion(x: number, y: number): void {
    // Creating a new sound instance for EVERY explosion
    const explosion = this.scene.sound.add('explosion');
    explosion.play();
    
    // No limit on concurrent sounds
  }
  
  startMusic(): void {
    // Start music without checking if it's already playing
    const music = this.scene.sound.add('music');
    music.setLoop(true);
    music.play();
    
    // Multiple music tracks can overlap
  }
  
  stopAllAudio(): void {
    // Abrupt stop without fading
    this.scene.sound.stopAll();
  }
  
  // No centralized volume controls
