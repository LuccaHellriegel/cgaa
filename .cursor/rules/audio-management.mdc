```typescript
// Comprehensive Phaser audio manager with performance optimizations
export class PhaserAudioManager {
  private scene: Phaser.Scene;
  private soundEffects: Map<string, Phaser.Sound.BaseSound> = new Map();
  private music: Map<string, Phaser.Sound.BaseSound> = new Map();
  private soundPools: Map<string, Phaser.Sound.BaseSound[]> = new Map();
  private audioSprites: Map<string, Phaser.Sound.BaseSound> = new Map();
  private currentMusic: string | null = null;
  private sfxVolume: number = 0.7;
  private musicVolume: number = 0.5;
  private muted: boolean = false;
  
  // Sound rate limiting to prevent audio clutter
  private soundTimestamps: Map<string, number> = new Map();
  private soundCooldowns: Map<string, number> = new Map();
  
  // Audio categories for selective muting
  private categories: Map<string, Set<Phaser.Sound.BaseSound>> = new Map([
    ['sfx', new Set()],
    ['music', new Set()],
    ['voice', new Set()],
    ['ui', new Set()],
    ['ambient', new Set()]
  ]);
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    
    // Configure optimal audio settings
    this.configureAudio();
    
    // Set up event listeners for game pause/resume
    this.setupEventListeners();
  }
  
  /**
   * Configure Phaser sound manager optimally
   */
  private configureAudio(): void {
    // Access the global sound manager
    const soundManager = this.scene.sound;
    
    // Set WebAudio disableWebAudio to false to enable WebAudio features
    if (soundManager.context && soundManager instanceof Phaser.Sound.WebAudioSound) {
      // Configure global audio settings
      soundManager.setRate(1.0);
      soundManager.setDetune(0);
      
      // Limit the number of simultaneous sounds on mobile
      if (this.scene.sys.game.device.os.iPhone || 
          this.scene.sys.game.device.os.android || 
          this.scene.sys.game.device.os.iPad) {
        // Mobile devices - limit to fewer sounds
        soundManager.setMaxListeners(8);
      } else {
        // Desktop - allow more simultaneous sounds
        soundManager.setMaxListeners(16);
      }
    }
    
    // Set default values
    soundManager.setVolume(1.0);
    soundManager.setMute(false);
  }
  
  /**
   * Set up event listeners for game state
   */
  private setupEventListeners(): void {
    // Handle scene lifecycle events
    this.scene.events.on('pause', this.onPause, this);
    this.scene.events.on('resume', this.onResume, this);
    this.scene.events.once('shutdown', this.shutdown, this);
    
    // Handle global game events
    this.scene.game.events.on('blur', this.onBlur, this);
    this.scene.game.events.on('focus', this.onFocus, this);
    
    // Update method for any sound processing
    this.scene.events.on('update', this.update, this);
  }
  
  /**
   * Preload audio assets with the correct formats
   */
  preloadAudio(): void {
    // Detect browser capabilities for audio format
    const audioTest = document.createElement('audio');
    const formats = {
      ogg: audioTest.canPlayType('audio/ogg; codecs="vorbis"').replace('no', ''),
      mp3: audioTest.canPlayType('audio/mpeg').replace('no', ''),
      m4a: audioTest.canPlayType('audio/mp4; codecs="mp4a.40.5"').replace('no', ''),
      webm: audioTest.canPlayType('audio/webm; codecs="vorbis"').replace('no', '')
    };
    
    // Determine preferred formats based on browser support
    const preferredFormats = [];
    if (formats.ogg) preferredFormats.push('ogg');
    if (formats.mp3) preferredFormats.push('mp3');
    if (formats.m4a) preferredFormats.push('m4a');
    if (formats.webm) preferredFormats.push('webm');
    
    // Sound effects with multiple formats for cross-browser support
    const soundEffects = [
      { key: 'explosion', category: 'sfx' },
      { key: 'shoot', category: 'sfx', pool: 5 },
      { key: 'jump', category: 'sfx' },
      { key: 'pickup', category: 'sfx' },
      { key: 'uiSelect', category: 'ui' }
    ];
    
    // Load individual sound effects with preferred formats
    soundEffects.forEach(sfx => {
      const paths = preferredFormats.map(format => `assets/audio/${sfx.key}.${format}`);
      this.scene.load.audio(sfx.key, paths);
      
      // Set sound cooldowns for rate limiting
      if (sfx.key === 'shoot') this.soundCooldowns.set(sfx.key, 50); // 50ms cooldown
      if (sfx.key === 'explosion') this.soundCooldowns.set(sfx.key, 100); // 100ms cooldown
    });
    
    // Load audio sprite for small, frequent sound effects
    this.scene.load.audioSprite('sfxSprite', 
      'assets/audio/sfxSprite.json',
      preferredFormats.map(format => `assets/audio/sfxSprite.${format}`)
    );
    
    // Music tracks
    const musicTracks = [
      { key: 'mainTheme', category: 'music' },
      { key: 'battleMusic', category: 'music' },
      { key: 'menuMusic', category: 'music' }
    ];
    
    // Load music with preferred formats
    musicTracks.forEach(track => {
      const paths = preferredFormats.map(format => `assets/audio/${track.key}.${format}`);
      this.scene.load.audio(track.key, paths);
    });
  }
  
  /**
   * Initialize audio after preloading is complete
   */
  createAudio(): void {
    // Create audio sprite instance
    this.createAudioSprite('sfxSprite');
    
    // Create sound pools for frequently used sounds
    this.createSoundPool('shoot', 5);
    this.createSoundPool('explosion', 3);
    
    // Create regular sound effects
    this.createSoundEffect('jump');
    this.createSoundEffect('pickup');
    this.createSoundEffect('uiSelect', { category: 'ui' });
    
    // Create music tracks
    this.createMusic('mainTheme', { loop: true });
    this.createMusic('battleMusic', { loop: true });
    this.createMusic('menuMusic', { loop: true });
    
    // Set initial volumes
    this.setSfxVolume(this.sfxVolume);
    this.setMusicVolume(this.musicVolume);
    
    console.log('Phaser audio manager initialized');
  }
  
  /**
   * Create and configure an audio sprite
   */
  private createAudioSprite(key: string): void {
    // Add audio sprite to the scene
    const audioSprite = this.scene.sound.addAudioSprite(key);
    
    // Store reference
    this.audioSprites.set(key, audioSprite);
    
    // Add to sfx category by default
    this.categories.get('sfx')?.add(audioSprite);
    
    console.log(`Audio sprite '${key}' created with markers:`, audioSprite.markers);
  }
  
  /**
   * Create a pool of sound instances for frequently used sounds
   */
  private createSoundPool(key: string, size: number): void {
    const pool: Phaser.Sound.BaseSound[] = [];
    
    // Create multiple instances of the same sound
    for (let i = 0; i < size; i++) {
      const sound = this.scene.sound.add(key, { 
        volume: this.sfxVolume,
        // Sound configuration
        rate: 1.0,
        detune: 0,
        loop: false
      });
      
      pool.push(sound);
      
      // Add to appropriate category
      this.categories.get('sfx')?.add(sound);
    }
    
    this.soundPools.set(key, pool);
    console.log(`Sound pool for '${key}' created with ${size} instances`);
  }
  
  /**
   * Create a standard sound effect
   */
  private createSoundEffect(key: string, config: { category?: string } = {}): void {
    // Add sound to the scene
    const sound = this.scene.sound.add(key, { 
      volume: this.sfxVolume,
      loop: false
    });
    
    // Store reference
    this.soundEffects.set(key, sound);
    
    // Add to appropriate category (default to 'sfx')
    const category = config.category || 'sfx';
    this.categories.get(category)?.add(sound);
    
    console.log(`Sound effect '${key}' created`);
  }
  
  /**
   * Create a music track
   */
  private createMusic(key: string, config: Phaser.Types.Sound.SoundConfig = {}): void {
    // Default configuration for music
    const defaultConfig: Phaser.Types.Sound.SoundConfig = {
      volume: this.musicVolume,
      loop: true,
      delay: 0
    };
    
    // Merge with provided config
    const mergedConfig = { ...defaultConfig, ...config };
    
    // Add music to the scene
    const music = this.scene.sound.add(key, mergedConfig);
    
    // Store reference
    this.music.set(key, music);
    
    // Add to music category
    this.categories.get('music')?.add(music);
    
    console.log(`Music track '${key}' created`);
  }
  
  /**
   * Play a sound effect with rate limiting
   */
  playSfx(key: string, config: Phaser.Types.Sound.SoundConfig = {}): Phaser.Sound.BaseSound | null {
    if (this.muted) return null;
    
    // Check rate limiting for this sound
    if (this.shouldRateLimit(key)) {
      return null;
    }
    
    // Update timestamp for rate limiting
    this.soundTimestamps.set(key, Date.now());
    
    // Check if this is a sprite marker
    for (const [spriteKey, sprite] of this.audioSprites) {
      if (sprite.markers && sprite.markers[key]) {
        sprite.play(key, config);
        return sprite;
      }
    }
    
    // Check if this sound has a pool
    if (this.soundPools.has(key)) {
      return this.playFromPool(key, config);
    }
    
    // Play regular sound effect
    const sound = this.soundEffects.get(key);
    if (sound) {
      sound.play(config);
      return sound;
    }
    
    console.warn(`Sound '${key}' not found`);
    return null;
  }
  
  /**
   * Play a sound with spatial positioning
   */
  playSpatialSfx(key: string, x: number, y: number, config: Phaser.Types.Sound.SoundConfig = {}): Phaser.Sound.BaseSound | null {
    // Skip if muted
    if (this.muted) return null;
    
    // Calculate pan based on x position relative to camera center
    const camera = this.scene.cameras.main;
    const cameraX = camera.scrollX + camera.width / 2;
    
    // Pan value between -1 (left) and 1 (right)
    const pan = Phaser.Math.Clamp((x - cameraX) / (camera.width / 2), -1, 1);
    
    // Calculate volume based on distance from camera center
    const cameraY = camera.scrollY + camera.height / 2;
    const distance = Phaser.Math.Distance.Between(x, y, cameraX, cameraY);
    const maxDistance = Math.max(camera.width, camera.height);
    
    // Volume decreases with distance
    const distanceVolume = Phaser.Math.Clamp(1 - (distance / maxDistance), 0.2, 1);
    
    // Merge spatial configuration
    const spatialConfig: Phaser.Types.Sound.SoundConfig = {
      ...config,
      pan: pan,
      volume: this.sfxVolume * distanceVolume
    };
    
    // Play the sound with spatial config
    return this.playSfx(key, spatialConfig);
  }
  
  /**
   * Play a sound from a pool of pre-created sound instances
   */
  private playFromPool(key: string, config: Phaser.Types.Sound.SoundConfig = {}): Phaser.Sound.BaseSound | null {
    const pool = this.soundPools.get(key);
    if (!pool || pool.length === 0) return null;
    
    // Find first sound that's not playing
    let sound = pool.find(s => !s.isPlaying);
    
    // If all sounds are playing, use the oldest one
    if (!sound) {
      sound = pool[0];
      sound.stop(); // Stop it before reusing
    }
    
    // Move to end of pool (for round-robin)
    const index = pool.indexOf(sound);
    if (index !== -1) {
      pool.splice(index, 1);
      pool.push(sound);
    }
    
    // Apply configuration
    if (config.volume !== undefined) sound.setVolume(config.volume);
    if (config.rate !== undefined) sound.setRate(config.rate);
    if (config.detune !== undefined) sound.setDetune(config.detune);
    if (config.pan !== undefined) sound.setPan(config.pan);
    
    // Play the sound
    sound.play(config);
    return sound;
  }
  
  /**
   * Determine if a sound should be rate-limited
   */
  private shouldRateLimit(key: string): boolean {
    // Check if this sound has a cooldown
    const cooldown = this.soundCooldowns.get(key);
    if (!cooldown) return false;
    
    // Check last play time
    const lastPlayed = this.soundTimestamps.get(key) || 0;
    const now = Date.now();
    
    // Return true if sound is still in cooldown period
    return (now - lastPlayed) < cooldown;
  }
  
  /**
   * Play a music track with fade in/out
   */
  playMusic(key: string, config: { fadeIn?: number, fadeOut?: number } = {}): void {
    if (this.muted) return;
    
    // Skip if already playing this music
    if (this.currentMusic === key) return;
    
    // Get new music track
    const newMusic = this.music.get(key);
    if (!newMusic) {
      console.warn(`Music track '${key}' not found`);
      return;
    }
    
    // Default fade times
    const fadeOut = config.fadeOut !== undefined ? config.fadeOut : 1000;
    const fadeIn = config.fadeIn !== undefined ? config.fadeIn : 1000;
    
    // Fade out current music if playing
    if (this.currentMusic) {
      const currentMusic = this.music.get(this.currentMusic);
      if (currentMusic && currentMusic.isPlaying) {
        // Create fade out tween
        this.scene.tweens.add({
          targets: currentMusic,
          volume: 0,
          duration: fadeOut,
          onComplete: () => {
            currentMusic.stop();
            // Start the new music once the old one is stopped
            this.startNewMusic(newMusic, fadeIn);
          }
        });
      } else {
        // No current music playing, start new immediately
        this.startNewMusic(newMusic, fadeIn);
      }
    } else {
      // No current music, start new immediately
      this.startNewMusic(newMusic, fadeIn);
    }
    
    // Update current music reference
    this.currentMusic = key;
  }
  
  /**
   * Helper to start new music with fade in
   */
  private startNewMusic(music: Phaser.Sound.BaseSound, fadeIn: number): void {
    music.setVolume(0);
    music.play();
    
    this.scene.tweens.add({
      targets: music,
      volume: this.musicVolume,
      duration: fadeIn
    });
  }
  
  /**
   * Stop current music with fade out
   */
  stopMusic(fadeTime: number = 1000): void {
    if (!this.currentMusic) return;
    
    const music = this.music.get(this.currentMusic);
    if (music && music.isPlaying) {
      // Create fade out tween
      this.scene.tweens.add({
        targets: music,
        volume: 0,
        duration: fadeTime,
        onComplete: () => {
          music.stop();
          this.currentMusic = null;
        }
      });
    }
  }
  
  /**
   * Pause all audio (called when game loses focus)
   */
  private onBlur(): void {
    // Auto-pause all audio when game is not focused
    if (!this.scene.sound.mute) {
      this.scene.sound.pauseAll();
    }
  }
  
  /**
   * Resume audio (called when game regains focus)
   */
  private onFocus(): void {
    // Resume audio when game regains focus (unless muted)
    if (!this.muted) {
      this.scene.sound.resumeAll();
    }
  }
  
  /**
   * Handle game pause state
   */
  private onPause(): void {
    // Pause all sounds when game pauses
    this.scene.sound.pauseAll();
  }
  
  /**
   * Handle game resume state
   */
  private onResume(): void {
    // Resume sounds when game resumes (unless muted)
    if (!this.muted) {
      this.scene.sound.resumeAll();
    }
  }
  
  /**
   * Set master volume for all sound effects
   */
  setSfxVolume(volume: number): void {
    this.sfxVolume = Phaser.Math.Clamp(volume, 0, 1);
    
    // Update sfx category volume
    this.categories.get('sfx')?.forEach(sound => {
      sound.setVolume(this.sfxVolume);
    });
    
    // Update UI sounds volume
    this.categories.get('ui')?.forEach(sound => {
      sound.setVolume(this.sfxVolume);
    });
  }
  
  /**
   * Set master volume for all music tracks
   */
  setMusicVolume(volume: number): void {
    this.musicVolume = Phaser.Math.Clamp(volume, 0, 1);
    
    // Update music category volume
    this.categories.get('music')?.forEach(music => {
      music.setVolume(this.musicVolume);
    });
  }
  
  /**
   * Set volume for a specific audio category
   */
  setCategoryVolume(category: string, volume: number): void {
    const categorySet = this.categories.get(category);
    if (!categorySet) {
      console.warn(`Category '${category}' not found`);
      return;
    }
    
    // Clamp volume and update all sounds in category
    const clampedVolume = Phaser.Math.Clamp(volume, 0, 1);
    categorySet.forEach(sound => {
      sound.setVolume(clampedVolume);
    });
  }
  
  /**
   * Mute or unmute all audio
   */
  toggleMute(): boolean {
    this.muted = !this.muted;
    this.scene.sound.mute = this.muted;
    return this.muted;
  }
  
  /**
   * Toggle mute state for a specific category
   */
  toggleCategoryMute(category: string): boolean {
    const categorySet = this.categories.get(category);
    if (!categorySet) {
      console.warn(`Category '${category}' not found`);
      return false;
    }
    
    // Check if any sound in the category is NOT muted
    let anyUnmuted = false;
    categorySet.forEach(sound => {
      if (!sound.mute) {
        anyUnmuted = true;
      }
    });
    
    // Toggle based on current state
    const newMuteState = anyUnmuted;
    categorySet.forEach(sound => {
      sound.setMute(newMuteState);
    });
    
    return newMuteState;
  }
  
  /**
   * Update method called each frame
   */
  update(time: number, delta: number): void {
    // Handle any per-frame audio processing here
    // For example, dynamic audio adjustments based on game state
  }
  
  /**
   * Clean up all audio resources
   */
  shutdown(): void {
    console.log('Cleaning up audio resources');
    
    // Stop and clean up all audio categories
    for (const [category, sounds] of this.categories) {
      sounds.forEach(sound => {
        sound.stop();
        sound.destroy();
      });
      sounds.clear();
    }
    
    // Clear all collections
    this.soundEffects.clear();
    this.music.clear();
    this.soundPools.clear();
    this.audioSprites.clear();
    this.soundTimestamps.clear();
    this.currentMusic = null;
    
    // Remove event listeners
    this.scene.events.off('pause', this.onPause, this);
    this.scene.events.off('resume', this.onResume, this);
    this.scene.events.off('update', this.update, this);
    
    this.scene.game.events.off('blur', this.onBlur, this);
    this.scene.game.events.off('focus', this.onFocus, this);
  }
}

// Usage example in a Phaser scene
class GameScene extends Phaser.Scene {
  private audioManager: PhaserAudioManager;
  
  constructor() {
    super({ key: 'GameScene' });
  }
  
  preload(): void {
    // Initialize audio manager early
    this.audioManager = new PhaserAudioManager(this);
    
    // Preload audio assets
    this.audioManager.preloadAudio();
    
    // Preload other game assets...
  }
  
  create(): void {
    // Create audio resources after loading completes
    this.audioManager.createAudio();
    
    // Start background music
    this.audioManager.playMusic('mainTheme', { fadeIn: 2000 });
    
    // Set up UI for audio controls
    this.createAudioControls();
  }
  
  private createAudioControls(): void {
    // Example audio control UI
    const musicBtn = this.add.image(760, 40, 'icons', 'music').setInteractive();
    musicBtn.on('pointerdown', () => {
      this.audioManager.toggleCategoryMute('music');
    });
    
    const sfxBtn = this.add.image(710, 40, 'icons', 'sfx').setInteractive();
    sfxBtn.on('pointerdown', () => {
      this.audioManager.toggleCategoryMute('sfx');
    });
  }
  
  // Game events that trigger sounds
  playerJump(): void {
    this.audioManager.playSfx('jump');
  }
  
  playerShoot(x: number, y: number): void {
    // Play with spatial audio
    this.audioManager.playSpatialSfx('shoot', x, y);
  }
  
  startBattle(): void {
    // Change music with cross-fade
    this.audioManager.playMusic('battleMusic', { fadeIn: 1000, fadeOut: 1000 });
  }
}
