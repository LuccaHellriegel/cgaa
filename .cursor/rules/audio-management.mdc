### 4. Implement Cross-Fading for Music Transitions

```typescript
// Smooth music transition
function crossFadeMusic(oldKey, newKey, duration = 1000) {
  const oldMusic = this.sound.get(oldKey);
  const newMusic = this.sound.add(newKey, { volume: 0, loop: true });
  
  // Start new music
  newMusic.play();
  
  // Fade out old music
  this.tweens.add({
    targets: oldMusic,
    volume: 0,
    duration: duration,
    onComplete: () => oldMusic.stop()
  });
  
  // Fade in new music
  this.tweens.add({
    targets: newMusic,
    volume: 1,
    duration: duration
  });
}
