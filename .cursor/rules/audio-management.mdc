# Effective Audio Management

## Context
- When implementing sound effects and music in Phaser games
- When experiencing performance issues related to audio playback
- When implementing adaptive/dynamic audio based on gameplay
- When supporting different platforms with varied audio capabilities
- When organizing audio resources for a complex game

## Requirements
- Use Phaser's built-in audio system with WebAudio API for low-latency playback
- Implement audio pooling for frequently used sound effects to avoid repeated object creation
- Create a centralized audio manager class to handle all sound interactions
- Pre-load and cache sound assets during the loading scene
- Use audio sprite sheets for small, frequent sound effects
- Batch multiple sound triggers together when possible
- Measure and monitor audio performance, optimizing if bottlenecks occur

## Examples

<example>
```typescript
// Centralized and optimized audio manager for Phaser
export class AudioManager {
  private scene: Phaser.Scene;
  private soundEffects: Map<string, Phaser.Sound.BaseSound> = new Map();
  private music: Map<string, Phaser.Sound.BaseSound> = new Map();
  private soundPools: Map<string, Phaser.Sound.BaseSound[]> = new Map();
  private currentMusic: string | null = null;
  private sfxVolume: number = 0.7;
  private musicVolume: number = 0.5;
  private muted: boolean = false;
  
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    this.initialize();
  }
  
  private initialize(): void {
    // Set up event listeners for game pause/resume
    this.scene.events.on('pause', () => this.onPause());
    this.scene.events.on('resume', () => this.onResume());
    
    // Listen for scene shutdown to clean up resources
    this.scene.events.once('shutdown', () => this.shutdown());
  }
  
  preload(): void {
    // Load audio assets with appropriate formats for cross-browser support
    this.scene.load.audio('explosion', [
      'assets/audio/explosion.ogg', 
      'assets/audio/explosion.mp3'
    ]);
    
    // Load audio sprite sheet for frequent, small sound effects
    this.scene.load.audioSprite('sfx', 
      'assets/audio/sfx.json',
      [
        'assets/audio/sfx.ogg',
        'assets/audio/sfx.mp3'
      ]
    );
  }
  
  create(): void {
    // Create pooled sound effects for frequently used sounds
    this.createSoundPool('shoot', 5);
    
    // Use audio sprite for small, frequent effects
    const sfx = this.scene.sound.addAudioSprite('sfx');
    this.soundEffects.set('coin', sfx);
    this.soundEffects.set('jump', sfx);
    
    // Create music tracks with proper settings
    this.createMusic('music_gameplay', { volume: this.musicVolume, loop: true });
  }
  
  private createSoundPool(key: string, size: number): void {
    const pool: Phaser.Sound.BaseSound[] = [];
    
    for (let i = 0; i < size; i++) {
      pool.push(this.scene.sound.add(key, { volume: this.sfxVolume }));
    }
    
    this.soundPools.set(key, pool);
  }
  
  playSfx(key: string, config: Phaser.Types.Sound.SoundConfig = {}): void {
    if (this.muted) return;
    
    // Check if this is an audio sprite marker
    const sfx = this.soundEffects.get('sfx');
    if (sfx && sfx.audioSprite && sfx.audioSprite.markers[key]) {
      sfx.play(key);
      return;
    }
    
    // Check if this sound has a pool
    if (this.soundPools.has(key)) {
      this.playFromPool(key, config);
      return;
    }
    
    // Play regular sound effect
    const sound = this.soundEffects.get(key);
    if (sound) {
      sound.play(config);
    }
  }
  
  private playFromPool(key: string, config: Phaser.Types.Sound.SoundConfig = {}): void {
    const pool = this.soundPools.get(key);
    if (!pool || pool.length === 0) return;
    
    // Find first sound that's not playing
    let sound = pool.find(s => !s.isPlaying);
    
    // If all sounds are playing, use the oldest one
    if (!sound) {
      sound = pool[0];
    }
    
    // Move to end of pool (for round-robin)
    const index = pool.indexOf(sound);
    if (index !== -1) {
      pool.splice(index, 1);
      pool.push(sound);
    }
    
    // Play the sound
    sound.play(config);
  }
  
  playMusic(key: string, fadeTime: number = 1000): void {
    if (this.muted) return;
    if (this.currentMusic === key) return;
    
    const newMusic = this.music.get(key);
    if (!newMusic) return;
    
    // Fade out current music if playing
    if (this.currentMusic) {
      const currentMusic = this.music.get(this.currentMusic);
      if (currentMusic && currentMusic.isPlaying) {
        this.scene.tweens.add({
          targets: currentMusic,
          volume: 0,
          duration: fadeTime,
          onComplete: () => {
            currentMusic.stop();
          }
        });
      }
    }
    
    // Start new music with fade in
    this.currentMusic = key;
    newMusic.volume = 0;
    newMusic.play();
    
    this.scene.tweens.add({
      targets: newMusic,
      volume: this.musicVolume,
      duration: fadeTime
    });
  }
  
  stopMusic(fadeTime: number = 1000): void {
    if (!this.currentMusic) return;
    
    const music = this.music.get(this.currentMusic);
    if (music && music.isPlaying) {
      this.scene.tweens.add({
        targets: music,
        volume: 0,
        duration: fadeTime,
        onComplete: () => {
          music.stop();
          this.currentMusic = null;
        }
      });
    }
  }
  
  setMusicVolume(volume: number): void {
    this.musicVolume = Phaser.Math.Clamp(volume, 0, 1);
    
    this.music.forEach(music => {
      music.volume = this.musicVolume;
    });
  }
  
  setSfxVolume(volume: number): void {
    this.sfxVolume = Phaser.Math.Clamp(volume, 0, 1);
    
    this.soundEffects.forEach(sound => {
      sound.volume = this.sfxVolume;
    });
    
    this.soundPools.forEach(pool => {
      pool.forEach(sound => {
        sound.volume = this.sfxVolume;
      });
    });
  }
  
  toggleMute(): boolean {
    this.muted = !this.muted;
    this.scene.sound.mute = this.muted;
    return this.muted;
  }
  
  private onPause(): void {
    // Automatically pause all audio when game pauses
    this.scene.sound.pauseAll();
  }
  
  private onResume(): void {
    // Resume audio when game resumes (unless muted)
    if (!this.muted) {
      this.scene.sound.resumeAll();
    }
  }
  
  private setupAudioControls(): void {
    // Implement UI controls for audio settings
    // This would connect to your UI elements
  }
  
  shutdown(): void {
    // Clean up all audio resources
    this.stopMusic(0);
    
    this.soundEffects.forEach(sound => {
      sound.stop();
      sound.destroy();
    });
    
    this.music.forEach(music => {
      music.stop();
      music.destroy();
    });
    
    this.soundPools.forEach(pool => {
      pool.forEach(sound => {
        sound.stop();
        sound.destroy();
      });
    });
    
    this.soundEffects.clear();
    this.music.clear();
    this.soundPools.clear();
    this.currentMusic = null;
    
    // Remove event listeners
    this.scene.events.off('pause', this.onPause, this);
    this.scene.events.off('resume', this.onResume, this);
  }
}
```
This example implements an efficient, reusable audio management system with proper resource handling, audio pooling, and audio sprites for performance optimization.
</example>

<example type="invalid">
```typescript
// Inefficient and problematic audio implementation
export class BadAudioImplementation {
  constructor(scene: Phaser.Scene) {
    this.scene = scene;
    
    // Load sound files directly in constructor without preload phase
    this.scene.sound.add('shoot', 'assets/audio/shoot.mp3');
  }
  
  playSfx(key: string): void {
    // Create a new sound instance each time instead of reusing
    const sound = this.scene.sound.add(key);
    sound.play();
    // No cleanup - sound instances accumulate
  }
  
  playExplosion(x: number, y: number): void {
    // Creating a new sound instance for EVERY explosion
    const explosion = this.scene.sound.add('explosion');
    explosion.play();
    // No limit on concurrent sounds
  }
}
```
This implementation creates performance issues by instantiating new sound objects each time instead of reusing them, causing memory bloat and potential audio glitches during intense gameplay.
</example>

## Phaser-Specific Notes

1. Use audio sprites for small, frequent sound effects:
   ```typescript
   // In preload
   this.load.audioSprite('sfx', 'assets/audio/sfx.json', [
     'assets/audio/sfx.ogg',
     'assets/audio/sfx.mp3'
   ]);
   
   // In create
   this.sfx = this.sound.addAudioSprite('sfx');
   
   // To play a specific marker
   this.sfx.play('jump');
   ```

2. Optimize by controlling sound playback frequency:
   ```typescript
   // Rate limit frequent sounds (e.g., rapid-fire weapons)
   let lastShotTime = 0;
   const SHOT_COOLDOWN = 50; // ms
   
   function fireWeapon() {
     const now = Date.now();
     if (now - lastShotTime >= SHOT_COOLDOWN) {
       audioManager.playSfx('shoot');
       lastShotTime = now;
     }
   }
   ```

3. Use WebAudio API features via Phaser for spatial audio:
   ```typescript
   // Position sound in stereo field based on game object position
   const sound = this.sound.add('effect');
   
   // Pan value between -1 (left) and 1 (right)
   const normalizedX = (gameObject.x / this.scale.width) * 2 - 1;
   sound.setPan(normalizedX);
   