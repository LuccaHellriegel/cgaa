{
  "name": "cgaa",
  "description": "Circle Gladiator Army Arena - A fast-paced action tower defense game.",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite/config.dev.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build --config vite/config.prod.mjs",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jsdom": "^21.1.7",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "jsdom": "^26.0.0",
    "terser": "^5.31.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  }
}
